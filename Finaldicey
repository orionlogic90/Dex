    // ============================================================
    function checkStopConditions() {
        var targetProfitPercentEl = $('dicey-target-profit');
        var stopLossPercentEl = $('dicey-stop-loss');
        var stopOnWinEl = $('dicey-stop-on-win');

        var targetProfitPercent = targetProfitPercentEl ? parseFloat(targetProfitPercentEl.value) : 100;
        var stopLossPercent = stopLossPercentEl ? parseFloat(stopLossPercentEl.value) : 90;
        wagerState.stopLossPercent = stopLossPercent;

        var targetProfit = wagerState.startBalance * (targetProfitPercent / 100);
        var stopLoss = wagerState.startBalance * (1 - stopLossPercent / 100);

        var wagerTarget = getConvertedTarget();
        if (wagerState.wagered >= wagerTarget) {
            addLog('[TARGET] ' + wagerTarget.toFixed(4) + ' ' + getCurrencyDisplay() + ' REACHED!', '#00e5c0', '[T]');
            stopWagerBot();
            return true;
        }

        if (wagerState.currentBalance - wagerState.startBalance >= targetProfit) {
            addLog('[PROFIT] +' + targetProfitPercent + '% reached!', '#00e5c0', '[P]');
            stopWagerBot();
            return true;
        }

        if (wagerState.currentBalance <= stopLoss) {
            addLog('[STOP] -' + stopLossPercent + '%', '#ff6b6b', '[S]');
            stopWagerBot();
            return true;
        }

        if (stopOnWinEl && stopOnWinEl.checked && wagerState.currentStreak >= 5) {
            addLog('[STOP] Win streak: ' + wagerState.currentStreak, '#ffd700', '[S]');
            stopWagerBot();
            return true;
        }

        return false;
    }

    // ============================================================
    // DO BET - WITH GAME SWITCHING
    // ============================================================
    let currentGameIndex = 0;
    let currentCycleCount = 0;
    const strategyGames = [];

    function loadStrategy() {
        // Load from strategy builder or use default
        strategyGames.length = 0;
        strategyGames.push({ game: 'DICE', chance: 98, bet: 0.01, cycle: 50 });
        strategyGames.push({ game: 'KENO', risk: 'Low', bet: 0.01, cycle: 30 });
        strategyGames.push({ game: 'PLINKO', risk: 'Low', rows: 8, bet: 0.01, cycle: 20 });
    }

    async function doBet() {
        if (!wagerState.isRunning || wagerState.isPaused) return null;

        var realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
        }

        loadStrategy();

        if (strategyGames.length === 0) {
            addLog('[ERR] No strategy configured!', '#ff6b6b', '[❌]');
            return null;
        }

        const game = strategyGames[currentGameIndex];
        if (!game) {
            currentGameIndex = 0;
            currentCycleCount = 0;
            return doBet();
        }

        let result;
        let gameDisplay = game.game;

        // Handle Keno risk array
        if (game.game === 'KENO' && kenoRiskArray.length > 0) {
            if (kenoRandomRisk) {
                game.risk = kenoRiskArray[Math.floor(Math.random() * kenoRiskArray.length)];
            } else {
                game.risk = kenoRiskArray[kenoRiskIndex % kenoRiskArray.length];
                kenoRiskIndex++;
            }
        }

        // Handle Keno random picks
        if (game.game === 'KENO' && kenoRandomPicks) {
            kenoPicks = Math.floor(Math.random() * 10) + 1;
            kenoSelectedNumbers = [];
            randomKenoSelection();
        }

        try {
            switch(game.game) {
                case 'DICE':
                    result = await placeBet(game.bet, game.chance);
                    break;
                case 'KENO':
                    result = await placeKenoBet(game.bet, game.risk);
                    break;
                case 'PLINKO':
                    result = await placePlinkoBet(game.bet, game.risk, game.rows || 8);
                    break;
                case 'LIMBO':
                    result = await placeLimboBet(game.bet, game.targetMultiplier || 2);
                    break;
                default:
                    addLog('[ERR] Unknown game: ' + game.game, '#ff6b6b', '[❌]');
                    return null;
            }

            if (!result.success) {
                addLog('[ERR] ' + game.game + ' bet failed: ' + result.error, '#ff6b6b', '[❌]');
                return null;
            }

            const data = result.data;
            const isWin = data.isWin;
            const profitNum = parseFloat(data.profit) || 0;
            const betAmount = parseFloat(data.betAmount) || game.bet;

            wagerState.wagered += betAmount;
            wagerState.currentBalance += profitNum;
            wagerState.totalBets++;
            
            if (isWin) {
                wagerState.totalWins++;
                wagerState.currentStreak = wagerState.currentStreak > 0 ? wagerState.currentStreak + 1 : 1;
            } else {
                wagerState.totalLosses++;
                wagerState.currentStreak = wagerState.currentStreak < 0 ? wagerState.currentStreak - 1 : -1;
            }

            // Simple bet log
            let chanceDisplay = game.chance || game.risk || '?';
            if (game.game === 'KENO') chanceDisplay = game.risk;
            if (game.game === 'PLINKO') chanceDisplay = game.risk;
            if (game.game === 'LIMBO') chanceDisplay = game.targetMultiplier + 'x';
            
            addBetLog(game.game, betAmount.toFixed(4), chanceDisplay, isWin ? 'WIN' : 'LOSE', profitNum);

            // Cycle management
            currentCycleCount++;
            if (currentCycleCount >= game.cycle) {
                currentCycleCount = 0;
                currentGameIndex = (currentGameIndex + 1) % strategyGames.length;
                addLog('[SWITCH] ' + game.game + ' cycle complete → ' + strategyGames[currentGameIndex].game, '#60a5fa', '[🔀]');
            }

            // Check loss streak -> switch
            if (!isWin && wagerState.currentStreak <= -3) {
                currentGameIndex = (currentGameIndex + 1) % strategyGames.length;
                currentCycleCount = 0;
                addLog('[SWITCH] Loss streak → ' + strategyGames[currentGameIndex].game, '#ff922b', '[🔀]');
            }

            updateWagerUI();
            updateSwitchUI();

            const realBalance2 = getRealBalance();
            if (realBalance2 !== null && realBalance2 > 0) {
                wagerState.currentBalance = realBalance2;
            }

            if (checkStopConditions()) {
                return null;
            }

            const autoContinue = document.getElementById('dicey-auto-continue');
            if (autoContinue && autoContinue.checked && wagerState.isRunning) {
                const cooldown = parseInt(document.getElementById('dicey-cooldown')?.value || 0);
                setTimeout(doBet, cooldown + randomDelay(100, 400));
            }

            return data;

        } catch(e) {
            addLog('[ERR] ' + game.game + ' error: ' + e.message, '#ff6b6b', '[❌]');
            return null;
        }
    }

    // ============================================================
    // WAGER LOOP
    // ============================================================
    function wagerLoop() {
        if (!wagerState.isRunning || wagerState.isPaused || wagerState.isLooping) return;
        wagerState.isLooping = true;

        doBet().then(function() {
            wagerState.isLooping = false;
        }).catch(function(e) {
            wagerState.isLooping = false;
            addLog('[ERR] ' + e.message, '#ff6b6b', '[E]');
            setTimeout(wagerLoop, randomDelay(1000, 3000));
        });
    }

