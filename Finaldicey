                })
            });

            return response.ok;

        } catch(e) {
            return false;
        }
    }

    async function sendChatToDicey(message) {
        try {
            const stream = await refreshStreamToken();
            if (!stream || !stream.token) {
                addLog('[CHAT] No stream token', '#ff6b6b', '[❌]');
                return false;
            }

            const userId = stream.userId;
            const apiKey = stream.apiKey || 'gszqy9y9nr3e3';

            if (!userId) {
                addLog('[CHAT] No user ID', '#ff6b6b', '[❌]');
                return false;
            }

            let connectionId = await getChatConnectionId();
            if (!connectionId) {
                connectionId = 'conn-' + generateUUID();
                localStorage.setItem('dicey_chat_conn_id', connectionId);
            }

            await sendTypingIndicator('start');
            await sleep(randomDelay(200, 500));

            const messageId = userId + '-' + generateUUID();

            const url = 'https://chat.stream-io-api.com/channels/messaging/lobby-en/message' +
                '?user_id=' + userId +
                '&connection_id=' + connectionId +
                '&api_key=' + apiKey;

            const payload = {
                message: {
                    id: messageId,
                    text: message,
                    type: 'regular'
                }
            };

            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': stream.token,
                    'stream-auth-type': 'jwt',
                    'Origin': 'https://dicey.com',
                    'User-Agent': navigator.userAgent,
                    'x-stream-client': 'stream-chat-react-14.0.1-stream-chat-js-v9.42.1-browser|client_bundle=browser-esm',
                    'Accept': 'application/json'
                },
                credentials: 'include',
                body: JSON.stringify(payload)
            });

            await sendTypingIndicator('stop');

            if (response.ok) {
                addLog('[CHAT] Sent: ' + message, '#4ade80', '[💬]');
                return true;
            } else {
                const text = await response.text();
                if (response.status === 401) {
                    localStorage.removeItem('dicey_stream_token');
                    localStorage.removeItem('dicey_chat_conn_id');
                    chatConnectionId = null;
                    return await sendChatToDicey(message);
                }
                addLog('[CHAT] Failed: ' + response.status + ' - ' + text, '#ff6b6b', '[❌]');
                return false;
            }

        } catch(e) {
            addLog('[CHAT] Error: ' + e.message, '#ff6b6b', '[❌]');
            return false;
        }
    }

