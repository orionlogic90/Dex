    // ============================================================
    // CREATE LICENSE VIA GITHUB - ADMIN FUNCTION
    // ============================================================
    async function createLicenseViaGithub(data) {
        try {
            const { token, repo, license, user, email, expiry, plan } = data;
            
            const fileResponse = await fetch(`https://api.github.com/repos/${repo}/contents/BoosterRain.txt`, {
                headers: {
                    'Authorization': `token ${token}`,
                    'Accept': 'application/vnd.github.v3+json'
                }
            });
            
            if (!fileResponse.ok) {
                if (fileResponse.status === 404) {
                    throw new Error('File BoosterRain.txt tidak ditemukan di repo');
                }
                throw new Error('HTTP ' + fileResponse.status);
            }
            
            const fileData = await fileResponse.json();
            const currentContent = atob(fileData.content);
            
            const licenseRegex = /const LICENSES = \{([\s\S]*?)\};/;
            const match = currentContent.match(licenseRegex);
            if (!match) {
                throw new Error('LICENSES object tidak ditemukan di script');
            }
            
            const newLicense = `
        "${license}": {
            "user": "${user}",
            "email": "${email}",
            "expiry": "${expiry}",
            "plan": "${plan}",
            "created": "${new Date().toISOString().split('T')[0]}"
        },`;
            
            const licensesContent = match[1];
            const updatedLicenses = licensesContent.replace(/\n\s*}$/, newLicense + '\n    }');
            const updatedContent = currentContent.replace(licenseRegex, `const LICENSES = {${updatedLicenses}};`);
            
            const updateResponse = await fetch(`https://api.github.com/repos/${repo}/contents/BoosterRain.txt`, {
                method: 'PUT',
                headers: {
                    'Authorization': `token ${token}`,
                    'Accept': 'application/vnd.github.v3+json',
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    message: `Add license: ${license} (${user})`,
                    content: btoa(updatedContent),
                    sha: fileData.sha
                })
            });
            
            if (!updateResponse.ok) {
                const errData = await updateResponse.json();
                throw new Error(errData.message || 'Gagal update file');
            }
            
            return { success: true, license: license };
            
        } catch(e) {
            return { success: false, error: e.message };
        }
    }

    // ============================================================
    // CHECK LICENSE + EMAIL
    // ============================================================
    function checkLicenseAndEmail(licenseKey, email) {
        const trimmedLicense = licenseKey.trim().toUpperCase();
        const trimmedEmail = email.trim().toLowerCase();

        if (!trimmedLicense || !trimmedEmail) {
            return { valid: false, reason: 'Masukkan License dan Email' };
        }

        const licenseData = LICENSES[trimmedLicense];

        if (!licenseData) {
            return { valid: false, reason: 'License tidak valid' };
        }

        if (licenseData.email.toLowerCase() !== trimmedEmail) {
            return { valid: false, reason: 'Email tidak cocok dengan License' };
        }

        const expiry = licenseData.expiry;
        if (expiry === 'permanent' || expiry === 'forever') {
            return {
                valid: true,
                user: licenseData.user,
                email: licenseData.email,
                expiry: 'Permanent',
                plan: licenseData.plan || 'premium'
            };
        }

        const expiryDate = new Date(expiry);
        if (isNaN(expiryDate.getTime())) {
            return { valid: false, reason: 'Format expiry invalid' };
        }

        if (new Date() > expiryDate) {
            return {
                valid: false,
                reason: 'License expired (' + expiry + ')'
            };
        }

        const remaining = Math.ceil((expiryDate - new Date()) / (1000 * 60 * 60 * 24));
        return {
            valid: true,
            user: licenseData.user,
            email: licenseData.email,
            expiry: expiry,
            remaining: remaining + ' days',
            plan: licenseData.plan || 'premium'
        };
    }

    // ============================================================
    // SEND OTP VIA DICEY API
    // ============================================================
    let otpAttempts = 0;
    let otpLockUntil = 0;

    async function sendOTPviaDicey(email) {
        try {
            if (otpAttempts >= 10 && Date.now() < otpLockUntil) {
                const remaining = Math.ceil((otpLockUntil - Date.now()) / 60000);
                return { 
                    success: false, 
                    error: `Terlalu banyak percobaan. Tunggu ${remaining} menit.` 
                };
            }

            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'SendAuthPasscode',
                    query: `
                        mutation SendAuthPasscode($input: SendPasscodeInput!) {
                            sendAuthPasscode(input: $input) {
                                success
                                methodId
                                error
                                __typename
                            }
                        }
                    `,
                    variables: {
                        input: {
                            email: email
                        }
                    }
                })
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }

            const result = data?.data?.sendAuthPasscode;
            
            if (result?.success) {
                otpAttempts++;
                localStorage.setItem('dicey_auth_method_id', result.methodId);
                localStorage.setItem('dicey_auth_email', email);
                addLog('[AUTH] 📧 OTP dikirim ke ' + email, '#4ade80', '[📧]');
                return { success: true, methodId: result.methodId };
            } else {
                return { success: false, error: result?.error || 'Gagal kirim OTP' };
            }

        } catch(e) {
            addLog('[AUTH] ❌ Error: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false, error: e.message };
        }
    }

    // ============================================================
    // VERIFY OTP VIA DICEY API
    // ============================================================
    async function verifyOTPviaDicey(code, methodId) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'VerifyPasscode',
                    query: `
                        mutation VerifyPasscode($input: VerifyPasscodeInput!) {
                            verifyPasscode(input: $input) {
                                success
                                isNewUser
                                mfaRequired
                                __typename
                            }
                        }
                    `,
                    variables: {
                        input: {
                            code: code,
                            methodId: methodId
                        }
                    }
                })
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }

            const result = data?.data?.verifyPasscode;
            
            if (result?.success) {
                localStorage.setItem('dicey_auth_verified', 'true');
                localStorage.setItem('dicey_auth_time', Date.now());
                otpAttempts = 0;
                
                addLog('[AUTH] ✅ OTP valid! Bot aktif.', '#4ade80', '[✅]');
                return { success: true };
            } else {
                addLog('[AUTH] ❌ OTP salah', '#ff6b6b', '[❌]');
                return { success: false, error: 'OTP salah' };
            }

        } catch(e) {
            addLog('[AUTH] ❌ Error: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false, error: e.message };
        }
    }

