                    cursor:pointer;
                    transition:all 0.15s;
                    border:1px solid ${isSelected ? '#4ade80' : '#3a3a3a'};
                    user-select:none;
                ">${i}</div>
            `;
        }
        container.innerHTML = html;
        
        container.querySelectorAll('.keno-tile').forEach(tile => {
            tile.addEventListener('click', function() {
                const num = parseInt(this.dataset.num);
                toggleKenoNumber(num);
            });
        });
        
        updateKenoDisplay();
    }

    function toggleKenoNumber(num) {
        const index = kenoSelectedNumbers.indexOf(num);
        if (index !== -1) {
            kenoSelectedNumbers.splice(index, 1);
        } else {
            if (kenoSelectedNumbers.length >= kenoPicks) {
                addLog('[KENO] Maksimal ' + kenoPicks + ' angka!', '#ff922b', '[!]');
                return;
            }
            kenoSelectedNumbers.push(num);
            kenoSelectedNumbers.sort((a, b) => a - b);
        }
        renderKenoTiles();
        updateKenoDisplay();
        localStorage.setItem('dicey_keno_selections', JSON.stringify(kenoSelectedNumbers));
    }

