                method: 'GET',
                credentials: 'include',
                headers: { 'Cache-Control': 'no-cache' }
            }).catch(() => {});

            if (!fishingDone) {
                const betValue = getConvertedFishingAmount();
                addLog('Fishing required: ~' + betValue.toFixed(4) + ' ' + getCurrency() + ' @ random % (0.03 USD)', '#ff922b', '[F]');
                doFishingMoment().then(() => {
                    if (rainState.isRunning) {
                        executeRainCycle();
                    }
                });
                return;
            }

            executeRainCycle();
        }).catch(() => {
            if (!fishingDone) {
                doFishingMoment().then(() => {
                    if (rainState.isRunning) {
                        executeRainCycle();
                    }
                });
                return;
            }
            executeRainCycle();
        });
    }

    function executeRainCycle() {
        if (!rainState.isRunning) return;

        startRainTimer();
        startChatRefreshLoop();
        startHumanBehavior();

        setTimeout(() => {
            fetchRainSchedule().then(rainData => {
                if (rainData) {
                    updateRainTimer(rainData);

                    const now = new Date();
                    const startsAt = new Date(rainData.startsAt);
                    const settlesAt = new Date(rainData.settlesAt);
                    const status = rainData.status;

                    if (status === 'Settled' || now > settlesAt) {
                        addLog('[RAIN] Rain settled! Checking payout...', '#888', '[R]');
                        checkRainPayoutAndRestart();
                        setTimeout(() => {
                            if (rainState.isRunning) {
                                runRainCycle();
                            }
                        }, randomDelay(4 * 60 * 1000, 6 * 60 * 1000));
                        return;
                    }

                    if (now >= startsAt && now <= settlesAt) {
                        const currentWager = wagerState.wagered || 0;
                        const entries = Math.floor(currentWager / 33.33);
                        addLog('[RAIN] 🎯 Rain is active! $' + rainData.totalUsdAmount + ' | Entries: ' + Math.min(3, entries) + '/3', '#ff922b', '[R]');
                        handleRainEvent(rainData);

                        const timeToSettle = settlesAt.getTime() - now.getTime();
                        setTimeout(() => {
                            addLog('[RAIN] ⏰ Settle time! Checking payout...', '#ffd700', '[R]');
                            checkRainPayoutAndRestart();
                            setTimeout(() => {
                                if (rainState.isRunning) {
                                    runRainCycle();
                                }
                            }, randomDelay(4 * 60 * 1000, 6 * 60 * 1000));
                        }, timeToSettle + randomDelay(3000, 8000));
                        return;
                    }

                    if (now < startsAt) {
                        const timeUntilStart = startsAt.getTime() - now.getTime();
                        const minutesUntilStart = Math.floor(timeUntilStart / 60000);
                        addLog('[RAIN] ⏰ Rain starts in ' + minutesUntilStart + ' minutes (at ' + startsAt.toLocaleTimeString() + ')', '#60a5fa', '[R]');
                        chatEmojiSent = false;

                        const currentWager = wagerState.wagered || 0;
                        const entries = Math.floor(currentWager / 33.33);
                        if (entries < 1) {
                            addLog('[RAIN] 🔄 Pre-wagering for entries...', '#60a5fa', '[R]');
                            autoWagerForRainEntries();
                        } else {
                            addLog('[RAIN] ✅ Already have ' + Math.min(3, entries) + '/3 entries', '#4ade80', '[R]');
                        }

                        setTimeout(() => {
                            if (rainState.isRunning) {
                                runRainCycle();
                            }
                        }, timeUntilStart + randomDelay(1000, 5000));
                        return;
                    }

                } else {
                    addLog('[RAIN] No rain scheduled, checking again...', '#888', '[R]');
                    setTimeout(() => {
                        if (rainState.isRunning) {
                            runRainCycle();
                        }
                    }, randomDelay(4 * 60 * 1000, 6 * 60 * 1000));
                }
            });
        }, randomDelay(500, 2000));
    }

    // ============================================================
    // RAIN START/STOP
    // ============================================================
    function startRainBot() {
        if (!isLicensed) {
            addLog('[!] License required for rain catcher', '#f87171', '[!]');
            return;
        }

        const currentWager = wagerState.wagered || 0;

        if (currentWager < 33.33) {
            addLog('[RAIN] Insufficient entries: $' + currentWager.toFixed(2) + ' / $33.33 needed', '#ff922b', '[R]');

            if (rainState.isRunning) {
                rainState.isRunning = false;
                if (rainState.scheduledTimeout) {
                    clearTimeout(rainState.scheduledTimeout);
                    rainState.scheduledTimeout = null;
                }
                stopRainTimer();
                stopChatRefreshLoop();
                stopHumanBehavior();
                rainState.joinedRains = new Set();
                rainState.successCount = 0;
                rainState.failCount = 0;
                fishingDone = false;
                fishingTotalBets = 0;
                updateFishingUI(false, 'Pending');
                updateRainUI();
            }

            addLog('[RAIN] Auto wager started for entries...', '#60a5fa', '[W]');

            sendTelegramNotification('AUTO_WAGER_RAIN');

            if (!wagerState.isRunning) {
                startWagerBot();
            }

            const checkInterval = setInterval(() => {
                const wagerNow = wagerState.wagered || 0;
                addLog('[RAIN] Waiting for wager: $' + wagerNow.toFixed(2) + ' / $33.33 needed', '#60a5fa', '[R]');

                if (wagerNow >= 33.33) {
                    clearInterval(checkInterval);
                    addLog('[RAIN] Entry target reached! Starting rain...', '#4ade80', '[R]');

                    if (wagerState.isRunning) {
                        stopWagerBot();
                    }

                    rainState.isRunning = true;
                    rainState.joinedRains = new Set();
                    rainState.successCount = 0;
                    rainState.failCount = 0;
                    fishingDone = false;
                    fishingTotalBets = 0;
                    updateFishingUI(false, 'Pending');
                    updateRainUI();
                    prevRainRunning = true;
                    chatEmojiSent = false;

                    addLog('Rain catcher started (API Loop + Human Behavior)', '#4ade80', '[R]');
                    const betValue = getConvertedFishingAmount();
                    addLog('Fishing: ~' + betValue.toFixed(4) + ' ' + getCurrency() + ' @ random % (0.03 USD base)', '#ff922b', '[F]');

                    sendTelegramNotification('RAIN_START');

                    runRainCycle();
                }
            }, 5000);

            return;
        }

        if (rainState.isRunning) {
            addLog('Rain catcher still running, forcing stop...', '#ff922b', '[R]');
            rainState.isRunning = false;
            if (rainState.scheduledTimeout) {
                clearTimeout(rainState.scheduledTimeout);
                rainState.scheduledTimeout = null;
            }
            stopRainTimer();
            stopChatRefreshLoop();
            stopHumanBehavior();
            rainState.joinedRains = new Set();
            rainState.successCount = 0;
            rainState.failCount = 0;
            fishingDone = false;
            fishingTotalBets = 0;
            updateFishingUI(false, 'Pending');
            updateRainUI();
            sleep(randomDelay(500, 1500));
        }

        fishingDone = false;
        fishingTotalBets = 0;
        updateFishingUI(false, 'Pending');

        rainState.isRunning = true;
        rainState.joinedRains = new Set();
        rainState.successCount = 0;
        rainState.failCount = 0;
        updateRainUI();
        chatEmojiSent = false;

        prevRainRunning = true;
        addLog('Rain catcher started (API Loop + Human Behavior)', '#4ade80', '[R]');
        const betValue = getConvertedFishingAmount();
        addLog('Fishing: ~' + betValue.toFixed(4) + ' ' + getCurrency() + ' @ random % (0.03 USD base)', '#ff922b', '[F]');

        sendTelegramNotification('RAIN_START');

        runRainCycle();
    }

    function stopRainBot() {
        rainState.isRunning = false;
        prevRainRunning = false;

        if (rainState.scheduledTimeout) {
            clearTimeout(rainState.scheduledTimeout);
            rainState.scheduledTimeout = null;
        }

        rainState.joinedRains = new Set();
        rainState.successCount = 0;
        rainState.failCount = 0;
        fishingDone = false;
        fishingTotalBets = 0;
        updateFishingUI(false, 'Pending');

        stopRainTimer();
        stopChatRefreshLoop();
        stopHumanBehavior();

        addLog('Rain catcher stopped', '#f87171', '[R]');
        updateRainUI();
    }

