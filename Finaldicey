    async function refreshStreamToken() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'StreamAuthToken',
                    query: `
                        query StreamAuthToken {
                            streamAuthToken {
                                token
                                apiKey
                                userId
                            }
                        }
                    `
                })
            });
            const data = await response.json();
            const result = {
                token: data?.data?.streamAuthToken?.token || null,
                apiKey: data?.data?.streamAuthToken?.apiKey || null,
                userId: data?.data?.streamAuthToken?.userId || null
            };
            
            if (result.token) {
                cachedStreamToken = result.token;
                localStorage.setItem('dicey_stream_token', result.token);
            }
            if (result.apiKey) {
                localStorage.setItem('dicey_stream_apikey', result.apiKey);
            }
            if (result.userId) {
                localStorage.setItem('dicey_stream_userid', result.userId);
            }
            
            return result;
        } catch(e) {
            return null;
        }
    }

    async function getChatConnectionId() {
        if (chatConnectionId) {
            return chatConnectionId;
        }
        
        let cached = localStorage.getItem('dicey_chat_conn_id');
        if (cached) {
            chatConnectionId = cached;
            return cached;
        }

        try {
            const stream = await refreshStreamToken();
            if (!stream || !stream.token) {
                return null;
            }

            const userId = stream.userId;
            const apiKey = stream.apiKey || 'gszqy9y9nr3e3';

            if (!userId) {
                return null;
            }

            const eventUrl = 'https://chat.stream-io-api.com/channels/messaging/lobby-en/event' +
                '?user_id=' + userId +
                '&api_key=' + apiKey;

            const response = await fetch(eventUrl, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': stream.token,
                    'stream-auth-type': 'jwt',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify({ event: { type: 'typing.start' } })
            });

            if (!response.ok) {
                return null;
            }

            const responseUrl = response.url;
            if (responseUrl) {
                try {
                    const urlObj = new URL(responseUrl);
                    const connId = urlObj.searchParams.get('connection_id');
                    if (connId) {
                        chatConnectionId = connId;
                        localStorage.setItem('dicey_chat_conn_id', connId);
                        return connId;
                    }
                } catch (e) {}
            }

            try {
                const responseText = await response.text();
                const jsonData = JSON.parse(responseText);
                if (jsonData.connection_id) {
                    chatConnectionId = jsonData.connection_id;
                    localStorage.setItem('dicey_chat_conn_id', jsonData.connection_id);
                    return jsonData.connection_id;
                }
                if (jsonData.event && jsonData.event.connection_id) {
                    chatConnectionId = jsonData.event.connection_id;
                    localStorage.setItem('dicey_chat_conn_id', jsonData.event.connection_id);
                    return jsonData.event.connection_id;
                }
            } catch (e) {}

            const fallbackId = 'conn-' + generateUUID();
            chatConnectionId = fallbackId;
            localStorage.setItem('dicey_chat_conn_id', fallbackId);
            return fallbackId;

        } catch (e) {
            return null;
        }
    }

    async function sendTypingIndicator(action) {
        try {
            const stream = await refreshStreamToken();
            if (!stream || !stream.token) return false;

            const userId = stream.userId;
            const apiKey = stream.apiKey || 'gszqy9y9nr3e3';

            let connId = await getChatConnectionId();
            if (!connId) return false;

            const url = 'https://chat.stream-io-api.com/channels/messaging/lobby-en/event' +
                '?user_id=' + userId +
                '&connection_id=' + connId +
                '&api_key=' + apiKey;

