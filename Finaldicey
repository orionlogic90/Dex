    function applyKenoPattern(patternName) {
        const numbers = KENO_PATTERNS[patternName];
        if (!numbers) return;
        
        const selected = numbers.slice(0, kenoPicks);
        kenoSelectedNumbers = selected;
        renderKenoTiles();
        updateKenoDisplay();
        localStorage.setItem('dicey_keno_selections', JSON.stringify(kenoSelectedNumbers));
        addLog('[KENO] Pattern: ' + patternName.toUpperCase() + ' applied (' + selected.length + ' picks)', '#60a5fa', '[🎯]');
    }

    function randomKenoSelection() {
        const numbers = [];
        const pool = [];
        for (let i = 1; i <= 40; i++) pool.push(i);
        
        for (let i = 0; i < kenoPicks; i++) {
            const idx = Math.floor(Math.random() * pool.length);
            numbers.push(pool[idx]);
            pool.splice(idx, 1);
        }
        
        kenoSelectedNumbers = numbers.sort((a, b) => a - b);
        renderKenoTiles();
        updateKenoDisplay();
        localStorage.setItem('dicey_keno_selections', JSON.stringify(kenoSelectedNumbers));
        addLog('[KENO] Random selection: ' + kenoSelectedNumbers.join(', '), '#4ade80', '[🎲]');
    }

    function getKenoSelections() {
        if (kenoSelectedNumbers.length === kenoPicks) {
            return kenoSelectedNumbers;
        }
        
        if (kenoSelectedNumbers.length > 0 && kenoSelectedNumbers.length < kenoPicks) {
            addLog('[KENO] Only ' + kenoSelectedNumbers.length + ' selected, auto-filling...', '#ff922b', '[!]');
            const pool = [];
            for (let i = 1; i <= 40; i++) {
                if (!kenoSelectedNumbers.includes(i)) pool.push(i);
            }
            while (kenoSelectedNumbers.length < kenoPicks) {
                const idx = Math.floor(Math.random() * pool.length);
                kenoSelectedNumbers.push(pool[idx]);
                pool.splice(idx, 1);
            }
            kenoSelectedNumbers.sort((a, b) => a - b);
            renderKenoTiles();
            updateKenoDisplay();
            localStorage.setItem('dicey_keno_selections', JSON.stringify(kenoSelectedNumbers));
        }
        
        if (kenoSelectedNumbers.length === 0) {
            addLog('[KENO] No selection, using random', '#ff922b', '[!]');
            randomKenoSelection();
        }
        
        return kenoSelectedNumbers;
    }

