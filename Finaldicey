    let kenoSelectedNumbers = [];

    function renderKenoTiles() {
        const container = document.getElementById('dicey-keno-tiles');
        if (!container) return;
        
        let html = '';
        for (let i = 1; i <= 40; i++) {
            const isSelected = kenoSelectedNumbers.includes(i);
            html += `
                <div class="keno-tile" data-num="${i}" style="
                    aspect-ratio:1;
                    display:flex;
                    align-items:center;
                    justify-content:center;
                    font-size:8px;
                    font-weight:700;
                    background:${isSelected ? '#4ade80' : '#2a2a2a'};
