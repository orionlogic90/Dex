    function restoreAndResume() {
        try {
            var saved = localStorage.getItem('dicey_full_state');
            if (!saved) return false;

            var state = JSON.parse(saved);
            var elapsed = Date.now() - state.timestamp;
            if (elapsed > 600000) {
                localStorage.removeItem('dicey_full_state');
                return false;
            }

            if (state.boosterMode !== undefined) {
                setBoosterMode(state.boosterMode);
            }
            if (state.autoClaimEnabled !== undefined) {
                autoClaimEnabled = state.autoClaimEnabled;
                const btn = document.getElementById('dicey-auto-claim-toggle');
                if (btn) {
                    btn.textContent = autoClaimEnabled ? '🔄 AUTO: ON' : '🔄 AUTO: OFF';
                    btn.style.background = autoClaimEnabled ? '#4ade80' : '#ff6b6b';
                    btn.style.color = autoClaimEnabled ? '#000' : '#fff';
                }
                if (autoClaimEnabled) {
                    if (autoClaimInterval) {
                        clearInterval(autoClaimInterval);
                    }
                    autoClaimInterval = setInterval(autoClaimAllRewards, 60 * 60 * 1000);
                }
            }

            if (state.license && state.email) {
                var licenseInput = $('dicey-license');
                var emailInput = $('dicey-auth-email');
                if (licenseInput) licenseInput.value = state.license;
                if (emailInput) emailInput.value = state.email;
                currentLicense = state.license;
                diceyEmail = state.email;
                isLicensed = state.isLicensed || false;
                setTimeout(updateLicenseStatus, 100);
            }

            // Restore strategy
            if (state.wager?.strategyGames) {
                strategyGames.length = 0;
                state.wager.strategyGames.forEach(g => strategyGames.push(g));
                currentGameIndex = state.wager.currentGameIndex || 0;
                currentCycleCount = state.wager.currentCycleCount || 0;
                renderStrategyGames();
            }

            // Restore Keno
            if (state.keno) {
                kenoPicks = state.keno.kenoPicks || 5;
                kenoRiskArray = state.keno.kenoRiskArray || ['Low', 'Low', 'Medium', 'Low', 'High'];
                kenoRandomRisk = state.keno.kenoRandomRisk || false;
                kenoRandomPicks = state.keno.kenoRandomPicks || false;
                if (state.keno.kenoSelectedNumbers) {
                    kenoSelectedNumbers = state.keno.kenoSelectedNumbers;
                    renderKenoTiles();
                    updateKenoDisplay();
                }
            }

            if (state.wager) {
                var w = state.wager;
                wagerState.totalBets = w.totalBets || 0;
                wagerState.totalWins = w.totalWins || 0;
                wagerState.totalLosses = w.totalLosses || 0;
                wagerState.currentStreak = w.currentStreak || 0;
                wagerState.currentLayer = w.currentLayer || 1;
                wagerState.startBalance = w.startBalance || 3;
                wagerState.currentBalance = w.currentBalance || 3;
                wagerState.currentBet = w.currentBet || 0.01;
                wagerState.wagered = w.wagered || 0;
                wagerState.layer1Bets = w.layer1Bets || 0;
                wagerState.layer2Bets = w.layer2Bets || 0;
                wagerState.layer1Wins = w.layer1Wins || 0;
                wagerState.layer2Wins = w.layer2Wins || 0;
                wagerState.lossRecovery = w.lossRecovery || 0;
                wagerState.totalLossInL2 = w.totalLossInL2 || 0;
                wagerState.layer2CurrentChance = w.layer2CurrentChance || 65;
                wagerState.layer2BetCount = w.layer2BetCount || 0;
                wagerState.layer2ResetCount = w.layer2ResetCount || 0;

                if (w.startTime) {
                    wagerState.startTime = w.startTime;
                    if (wagerState.timerInterval) clearInterval(wagerState.timerInterval);
                    wagerState.timerInterval = setInterval(updateWagerTimer, 1000);
                }

                updateWagerUI();
                updateSwitchUI();

                if (w.isRunning && !w.isPaused) {
                    prevWagerRunning = true;
                    addLog('[AUTO] RESUME WAGER', '#4ade80', '[A]');
                    wagerState.isRunning = true;
                    wagerState.isPaused = false;
                    wagerState.isLooping = false;
                    updateWagerUI();
                    setTimeout(function() {
                        if (wagerState.isRunning && !wagerState.isPaused) {
                            wagerLoop();
                        }
                    }, randomDelay(200, 600));
                } else if (w.isRunning && w.isPaused) {
                    addLog('[AUTO] WAGER PAUSED', '#ff922b', '[A]');
                    wagerState.isRunning = true;
                    wagerState.isPaused = true;
                    updateWagerUI();
                }
            }

            if (state.rain) {
                var r = state.rain;
                rainState.successCount = r.successCount || 0;
                rainState.failCount = r.failCount || 0;
                if (r.joinedRains) {
                    rainState.joinedRains = new Set(r.joinedRains);
                }
                if (r.fishingDone !== undefined) {
                    fishingDone = r.fishingDone;
                    fishingTotalBets = r.fishingTotalBets || 0;
                    updateFishingUI(fishingDone, fishingDone ? 'Done (' + fishingTotalBets + ' bets)' : 'Pending');
                }
                updateRainUI();

                if (r.isRunning) {
                    prevRainRunning = true;
                    addLog('[AUTO] RESUME RAIN', '#4ade80', '[A]');
                    rainState.isRunning = true;
                    updateRainUI();
                    setTimeout(function() {
                        if (rainState.isRunning) {
                            runRainCycle();
                        }
                    }, randomDelay(500, 1500));
                }
            }

            addLog('[AUTO] STATE RESTORED', '#4ade80', '[A]');
            return true;

        } catch(e) {
            return false;
        }
    }

    setInterval(function() {
        if (wagerState.isRunning || rainState.isRunning) {
            saveFullState();
        }
    }, randomDelay(8000, 15000));

