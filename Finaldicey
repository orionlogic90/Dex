    var licenseInput = $('dicey-license');
    var emailInput = $('dicey-auth-email');
    var otpInput = $('dicey-auth-code');

    // SEND OTP
    $('dicey-auth-send')?.addEventListener('click', async function() {
        const license = licenseInput?.value?.trim()?.toUpperCase();
        const email = emailInput?.value?.trim()?.toLowerCase();
        
        if (!license || !email) {
            addLog('[AUTH] Masukkan License dan Email', '#ff922b', '[!]');
            return;
        }
        
        const check = checkLicenseAndEmail(license, email);
        if (!check.valid) {
            addLog('[AUTH] ❌ ' + check.reason, '#ff6b6b', '[❌]');
            return;
        }
        
        this.disabled = true;
        this.textContent = '⏳ SENDING...';
        addLog('[AUTH] 📧 Mengirim OTP ke ' + email + '...', '#60a5fa', '[📧]');
        
        const result = await sendOTPviaDicey(email);
        
        if (result.success) {
            addLog('[AUTH] ✅ OTP dikirim! Cek email Anda.', '#4ade80', '[✅]');
        } else {
            addLog('[AUTH] ❌ ' + result.error, '#ff6b6b', '[❌]');
        }
        
        this.disabled = false;
        this.textContent = 'SEND OTP';
    });

    // VERIFY OTP
    $('dicey-auth-verify')?.addEventListener('click', async function() {
        const license = licenseInput?.value?.trim()?.toUpperCase();
        const email = emailInput?.value?.trim()?.toLowerCase();
        const otp = otpInput?.value?.trim();
        
        if (!license || !email) {
            addLog('[AUTH] Masukkan License dan Email', '#ff922b', '[!]');
            return;
        }
        
        if (!otp) {
            addLog('[AUTH] Masukkan OTP', '#ff922b', '[!]');
            return;
        }
        
        this.disabled = true;
        this.textContent = '⏳ VERIFYING...';
        
        const result = await fullLoginFlow(license, email, otp);
        
        if (result.success) {
            addLog('[AUTH] 🎉 Bot unlocked!', '#4ade80', '[🎉]');
            updateLicenseStatus();
            updateWagerButtons();
            updateRainButtons();
            updateUserInfo();
        } else {
            addLog('[AUTH] ❌ ' + result.error, '#ff6b6b', '[❌]');
            if (result.needOTP) {
                otpInput.focus();
            }
        }
        
        this.disabled = false;
        this.textContent = 'VERIFY & UNLOCK';
    });

