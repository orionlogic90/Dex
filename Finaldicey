        if (countEl) countEl.textContent = kenoSelectedNumbers.length + '/' + kenoPicks;
        
        if (displayEl) {
            if (kenoSelectedNumbers.length === 0) {
                displayEl.textContent = '-';
                displayEl.style.color = '#888';
