        // Cek target
        if (r.recoveredAmount >= target && target > 0) {
            STATE.isRecoveryMode = false;
            var profit = STATE.balance - STATE.startBalance;
            resetRecoveryState();
            sendTelegramMessage('✅ ADAPTIVE RECOVERY 125% SUCCESS!\n' +
