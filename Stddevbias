    // ==================== 10. DYNAMIC PATTERN SYSTEM ====================
    function generateRandomDistribution(total) {
        let d9998 = randomFloat(0.30, 0.70);
        let d99 = randomFloat(0.10, 0.40);
        let baccarat = 1 - d9998 - d99;
        
        if (baccarat < 0.10) {
            baccarat = 0.10;
            d9998 -= 0.05;
            d99 -= 0.05;
        }
        if (baccarat > 0.35) {
            baccarat = 0.35;
            d9998 += 0.15;
        }
        
        const sum = d9998 + d99 + baccarat;
        d9998 /= sum;
        d99 /= sum;
        baccarat /= sum;
        
        return {
            dice_9998: Math.round(total * d9998),
            dice_99: Math.round(total * d99),
            baccarat: total - Math.round(total * d9998) - Math.round(total * d99)
        };
    }

    function generateNewCycle() {
        const totalBet = randomInt(10, 25);
        const dist = generateRandomDistribution(totalBet);
        
        let sequence = [];
        for (const [mode, count] of Object.entries(dist)) {
            for (let i = 0; i < count; i++) {
                sequence.push(mode);
            }
        }
        
        sequence = shuffleArray(sequence);
        
        STATE.dynamic.modeSequence = sequence;
        STATE.dynamic.cycleLength = totalBet;
        STATE.dynamic.currentIndex = 0;
        STATE.dynamic.cycleBets = 0;
        STATE.dynamic.totalCycles++;
    }

    function getNextMode() {
        if (STATE.dynamic.modeSequence.length === 0 || 
            STATE.dynamic.currentIndex >= STATE.dynamic.cycleLength) {
            generateNewCycle();
        }
        
        const mode = STATE.dynamic.modeSequence[STATE.dynamic.currentIndex];
        STATE.dynamic.currentIndex++;
        STATE.dynamic.cycleBets++;
        
        return mode;
    }

    function getRandomBet(baseBet) {
        let bet = baseBet;
        const variance = bet * 0.2;
        const min = Math.max(bet - variance, STATE.minBet);
        const max = bet + variance;
        
        bet = randomFloat(min, max);
        
        if (Math.random() < 0.05) {
            bet = bet * 0.5;
        }
        if (Math.random() < 0.03) {
            bet = bet * 1.5;
        }
        
        return parseFloat(Math.max(bet, STATE.minBet).toFixed(8));
    }

