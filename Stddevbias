    async function getTelegramCommands() {
        if (!CONFIG.tgBotToken) return;
        
        try {
            var url = 'https://api.telegram.org/bot' + CONFIG.tgBotToken + '/getUpdates';
            if (lastUpdateId > 0) url += '?offset=' + (lastUpdateId + 1);
            
