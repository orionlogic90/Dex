    class MiniML {
        constructor() {
            this.w1 = Array.from({length: 6}, () => Math.random() * 2 - 1);
            this.w2 = Array.from({length: 6}, () => Math.random() * 2 - 1);
            this.b1 = Math.random() * 2 - 1;
            this.b2 = Math.random() * 2 - 1;
            this.lr = 0.01;
            this.history = [];
            this.maxHistory = 5000;
            this.accuracy = 0;
            this.trainingCount = 0;
            this.batchSize = 100;
            this.totalTrained = 0;
            this.loadModel();
            console.log('[MiniML] Initialized');
        }
        
        sigmoid(x) { return 1 / (1 + Math.exp(-x)); }
        sigmoidDerivative(x) { return x * (1 - x); }
        
        predict(features) {
            var h1 = 0;
            for (var i = 0; i < features.length; i++) h1 += features[i] * this.w1[i];
            h1 += this.b1;
            h1 = this.sigmoid(h1);
            
            var h2 = 0;
            for (var i = 0; i < features.length; i++) h2 += features[i] * this.w2[i];
            h2 += this.b2;
            h2 = this.sigmoid(h2);
            
            return { profitProb: h1, optimalChance: 30 + h2 * 40 };
        }
        
        train(features, targetProfit, targetChance) {
            var h1 = 0;
            for (var i = 0; i < features.length; i++) h1 += features[i] * this.w1[i];
            h1 += this.b1;
            h1 = this.sigmoid(h1);
            
            var h2 = 0;
            for (var i = 0; i < features.length; i++) h2 += features[i] * this.w2[i];
            h2 += this.b2;
            h2 = this.sigmoid(h2);
            
            var target1 = targetProfit > 0 ? 1 : 0;
            var target2 = (targetChance - 30) / 40;
            
            var error1 = target1 - h1;
            var error2 = target2 - h2;
            
            var d1 = error1 * this.sigmoidDerivative(h1);
            var d2 = error2 * this.sigmoidDerivative(h2);
            
            for (var i = 0; i < features.length; i++) {
                this.w1[i] += this.lr * d1 * features[i];
                this.w2[i] += this.lr * d2 * features[i];
            }
            this.b1 += this.lr * d1;
            this.b2 += this.lr * d2;
            
            this.history.push({ features, targetProfit, targetChance, prediction: { profitProb: h1, optimalChance: 30 + h2 * 40 } });
            if (this.history.length > this.maxHistory) this.history.shift();
        }
        
        updateAccuracy() {
            if (this.history.length < 10) return;
            var correct = 0;
            var total = Math.min(this.history.length, 500);
            var start = this.history.length - total;
            for (var i = start; i < this.history.length; i++) {
                var pred = this.history[i].prediction.profitProb > 0.5 ? 1 : 0;
                var actual = this.history[i].targetProfit > 0 ? 1 : 0;
                if (pred === actual) correct++;
            }
            this.accuracy = correct / total;
        }
        
        trainFromHistory(history) {
            if (!history || history.length === 0) return;
            
            var totalBatches = Math.ceil(history.length / this.batchSize);
            for (var batch = 0; batch < totalBatches; batch++) {
                var start = batch * this.batchSize;
                var end = Math.min(start + this.batchSize, history.length);
                for (var i = start; i < end; i++) {
                    var h = history[i];
                    var features = this.extractFeatures(h);
                    this.train(features, h.profit || 0, h.chance || 49.5);
                    this.totalTrained++;
                }
            }
            
            this.updateAccuracy();
            this.saveModel();
            console.log('[MiniML] Trained ' + history.length + ' samples. Total: ' + this.totalTrained + ' | Acc: ' + (this.accuracy * 100).toFixed(1) + '%');
        }
        
        getRecommendation(data) {
            var features = this.extractFeatures(data);
            var pred = this.predict(features);
            
            var commands = [];
            var profit = data.profit || 0;
            var lossStreak = data.lossStreak || 0;
            var isRecovery = data.isRecovery || 0;
            var balance = data.balance || 0;
            var startBalance = data.startBalance || balance;
            
            if (pred.profitProb < 0.3 && lossStreak > 2 && isRecovery === 1) {
                commands.push('/stoprecovery');
            }
            
            if (isRecovery === 1) {
                var newChance = Math.round(pred.optimalChance);
                if (Math.abs(newChance - data.chance) > 2) {
                    commands.push('/chance ' + newChance);
                }
            }
            
            if (lossStreak >= 3 && isRecovery === 1) {
                commands.push('/resetrecovery');
                if (lossStreak >= 5) {
                    var newBasebet = Math.min(1.0, 0.5 + (lossStreak - 5) * 0.1);
                    commands.push('/basebet ' + newBasebet.toFixed(1));
                }
            }
            
            if (profit >= 0 && isRecovery === 1) {
                commands.push('/stoprecovery');
            }
            
            if (balance < startBalance * 0.99 && isRecovery === 0) {
                commands.push('/startrecovery');
            }
            
            if (profit < -startBalance * 0.05) {
                commands.push('/stop');
            }
            
            if (profit > startBalance * 0.02) {
                commands.push('/stop');
            }
            
            return {
                commands: commands,
                profitProb: pred.profitProb,
                optimalChance: pred.optimalChance,
                accuracy: this.accuracy,
                dataCount: this.totalTrained
            };
        }
        
        extractFeatures(data) {
            var balance = data.balance || 0;
            var startBalance = data.startBalance || balance;
            return [
                data.profit || 0,
                data.lossStreak || 0,
                data.isRecovery || 0,
                data.winRate || 0,
                balance / (startBalance || 1),
                data.bets || 0
            ];
        }
        
        saveModel() {
            try {
                var data = {
                    w1: this.w1,
                    w2: this.w2,
                    b1: this.b1,
                    b2: this.b2,
                    totalTrained: this.totalTrained,
                    accuracy: this.accuracy,
                    timestamp: Date.now()
                };
                localStorage.setItem('miniML_model', JSON.stringify(data));
            } catch(e) {}
        }
        
        loadModel() {
            try {
                var saved = localStorage.getItem('miniML_model');
                if (saved) {
                    var data = JSON.parse(saved);
                    this.w1 = data.w1;
                    this.w2 = data.w2;
                    this.b1 = data.b1;
                    this.b2 = data.b2;
                    this.totalTrained = data.totalTrained || 0;
                    this.accuracy = data.accuracy || 0;
                    console.log('[MiniML] Loaded model, trained on ' + this.totalTrained + ' samples');
                }
            } catch(e) {}
        }
    }

