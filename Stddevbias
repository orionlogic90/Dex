    // ==================== 12. GET LIMBO TARGET ====================
    function getLimboTarget() {
        var targets = [1.0001, 1.001, 1.002, 1.005, 1.01];
        var weights = [0.3, 0.3, 0.2, 0.15, 0.05];
        
        var rand = Math.random();
        var cumulative = 0;
        for (var i = 0; i < targets.length; i++) {
            cumulative += weights[i];
            if (rand < cumulative) {
                return targets[i];
            }
        }
        return 1.001;
    }

    // ==================== 13. DYNAMIC PATTERN ====================
    function generateRandomDistribution(total) {
        var limbo = randomFloat(0.40, 0.70);
        var baccarat = randomFloat(0.15, 0.35);
        var d9998 = randomFloat(0.05, 0.15);
        var d99 = 1 - limbo - baccarat - d9998;
        
        if (d99 < 0) {
            d99 = 0;
            limbo -= 0.05;
        }
        if (limbo < 0.20) {
            limbo = 0.20;
            d9998 -= 0.05;
        }
        if (baccarat < 0.10) {
            baccarat = 0.10;
            limbo -= 0.05;
        }
        if (d9998 < 0.02) {
            d9998 = 0.02;
            limbo -= 0.02;
        }
        
        var sum = limbo + baccarat + d9998 + d99;
        limbo /= sum;
        baccarat /= sum;
        d9998 /= sum;
        d99 /= sum;
        
        return {
            limbo: Math.round(total * limbo),
            baccarat: Math.round(total * baccarat),
            dice_9998: Math.round(total * d9998),
            dice_99: total - Math.round(total * limbo) - Math.round(total * baccarat) - Math.round(total * d9998)
        };
    }

    function generateNewCycle() {
        var totalBet = randomInt(10, 25);
        var dist = generateRandomDistribution(totalBet);
        
        var sequence = [];
        for (var mode in dist) {
            var count = dist[mode];
            for (var i = 0; i < count; i++) {
                sequence.push(mode);
            }
        }
        
        sequence = shuffleArray(sequence);
        
        STATE.dynamic.modeSequence = sequence;
        STATE.dynamic.cycleLength = totalBet;
        STATE.dynamic.currentIndex = 0;
        STATE.dynamic.cycleBets = 0;
        STATE.dynamic.totalCycles++;
    }

    function getNextMode() {
        if (STATE.dynamic.modeSequence.length === 0 || 
            STATE.dynamic.currentIndex >= STATE.dynamic.cycleLength) {
            generateNewCycle();
        }
        
        var mode = STATE.dynamic.modeSequence[STATE.dynamic.currentIndex];
        STATE.dynamic.currentIndex++;
        STATE.dynamic.cycleBets++;
        
        return mode;
    }

    function getRandomBet(baseBet) {
        var bet = baseBet;
        var variance = bet * 0.2;
        var min = Math.max(bet - variance, STATE.minBet);
        var max = bet + variance;
        
        bet = randomFloat(min, max);
        
        if (Math.random() < 0.05) {
            bet = bet * 0.5;
        }
        if (Math.random() < 0.03) {
            bet = bet * 1.5;
        }
        
        return parseFloat(Math.max(bet, STATE.minBet).toFixed(8));
    }

