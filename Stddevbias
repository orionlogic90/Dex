                for (var i = 0; i < data.result.length; i++) {
                    var update = data.result[i];
                    var msg = update.message;
                    if (update.update_id > lastUpdateId) lastUpdateId = update.update_id;
                    if (msg && msg.text) {
                        var chatId = msg.chat.id.toString();
                        if (chatId === CONFIG.tgChatId) {
                            processMLCommand(msg.text, msg.chat.id);
                        }
                    }
                }
            }
        } catch(e) {
            console.log('[TG] Error:', e);
        }
    }

    function processMLCommand(text, chatId) {
        var parts = text.split(' ');
        var cmd = parts[0].toLowerCase();
        var value = parts[1];
        
        console.log('[CMD] Received:', text);
        
        switch(cmd) {
            case '/chance':
                var newChance = parseFloat(value);
                if (newChance > 0 && newChance < 100) {
                    STATE.recoveryChance = newChance;
                    sendTelegramMessage('✅ Chance set to ' + newChance + '%');
                }
                break;
                
            case '/basebet':
                var newBasebet = parseFloat(value);
                if (newBasebet > 0 && newBasebet < 10) {
                    STATE.recoveryBaseBetPct = newBasebet;
                    if (STATE.isRecoveryMode) {
                        STATE.recovery.baseBet = STATE.balance * (newBasebet / 100);
                        STATE.recovery.baseBet = Math.max(STATE.recovery.baseBet, STATE.minBet);
                    }
                    sendTelegramMessage('✅ Basebet set to ' + newBasebet + '%');
                }
                break;
                
            case '/maxbet':
                var newMaxbet = parseFloat(value);
                if (newMaxbet > 0 && newMaxbet < 20) {
                    STATE.recoveryMaxBetPct = newMaxbet;
                    sendTelegramMessage('✅ Max bet set to ' + newMaxbet + '%');
                }
                break;
                
            case '/maxls':
                var newMaxls = parseInt(value);
                if (newMaxls > 0 && newMaxls < 20) {
                    STATE.recoveryMaxLossStreak = newMaxls;
                    sendTelegramMessage('✅ Max loss streak set to ' + newMaxls + 'x');
                }
                break;
                
            case '/trigger':
                var newTrigger = parseFloat(value);
                if (newTrigger > 0 && newTrigger < 5) {
                    STATE.triggerDrawdownPct = newTrigger;
                    sendTelegramMessage('✅ Trigger set to ' + newTrigger + '%');
                }
                break;
                
            case '/resetrecovery':
                if (STATE.isRecoveryMode) {
                    STATE.recovery.lossStreak = 0;
                    STATE.recovery.currentBet = STATE.recovery.baseBet;
                    sendTelegramMessage('🔄 Recovery reset!');
                }
                break;
                
            case '/stoprecovery':
                if (STATE.isRecoveryMode) {
                    STATE.isRecoveryMode = false;
                    resetRecoveryState();
                    sendTelegramMessage('🛑 Recovery stopped');
                    setTimeout(sendFireAndForgetBet, 0);
