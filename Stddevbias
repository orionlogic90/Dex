    // ==================== 12. PLACE DICE BET ====================
    async function placeDiceBet(amount, chance, condition) {
        var target = condition === 'above' ? (100 - chance) : chance;
        var apiAmount = parseFloat(amount.toFixed(8));
        
        try {
            var payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                target: target,
                condition: condition || "above",
                identifier: generateId()
            };
            
            var res = await fetch(CONFIG.apiUrl + '/casino/dice/roll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.diceRoll) return null;
            
            var d = data.diceRoll;
            var expectedPayoutMultiplier = 99 / chance;
            var actualPayoutMultiplier = parseFloat(d.payoutMultiplier) || expectedPayoutMultiplier;
            var payout = parseFloat(d.payout) || 0;
            var winAmount = parseFloat(d.amount) || apiAmount;
            
            var win = false;
            if (d.win !== undefined) {
                win = d.win;
            } else {
                var state = d.state;
                if (state && state.result !== undefined && state.target !== undefined) {
                    win = state.condition === "above" ? state.result > state.target : state.result < state.target;
                }
            }
            
            var profitAmount = 0;
            if (win) {
                var profitMultiplier = (99 / chance) - 1;
                profitAmount = profitMultiplier * winAmount;
            } else {
                profitAmount = -winAmount;
            }
            
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance += profitAmount;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.stats.profit = STATE.profit;
            STATE.stats.currentBal = STATE.balance;
            
            updateDrawdown();
            
            console.log('[DICE] ' + (win ? 'WIN' : 'LOSS') + ' | Chance: ' + chance + '% | Multiplier: ' + (99/chance).toFixed(4) + 'x | Profit: ' + profitAmount.toFixed(8));
            
            updateAllUI();
            
            return {
                win: win,
                payout: payout,
                payoutMultiplier: actualPayoutMultiplier,
                amount: winAmount,
                state: d.state,
                result: win ? 'win' : 'loss',
                game: 'dice',
                chance: chance,
                profit: profitAmount,
                expectedMultiplier: 99 / chance
            };
            
        } catch (error) {
            console.error('[DICE] Exception:', error);
            return null;
        }
    }

    // ==================== 13. RECOVERY ====================
    function calculateMartingaleBet() {
        var r = STATE.recovery;
        var balance = STATE.balance;
        
        var baseBetPct = STATE.recoveryBaseBetPct || 0.5;
        var baseBet = balance * (baseBetPct / 100);
        baseBet = Math.max(baseBet, STATE.minBet);
        r.baseBet = baseBet;
        
        var multiplier = Math.pow(STATE.recoveryMultiplier || 1.5, r.lossStreak);
        var bet = baseBet * multiplier;
        
        var maxBetPct = STATE.recoveryMaxBetPct || 5;
        var maxBet = balance * (maxBetPct / 100);
        if (bet > maxBet) bet = maxBet;
        
        bet = Math.max(bet, STATE.minBet);
        bet = parseFloat(bet.toFixed(8));
        r.currentBet = bet;
        
        var chance = STATE.recoveryChance || 49.5;
        
        console.log('[MARTINGALE] Base: ' + baseBet + ' | LS: ' + r.lossStreak + ' | Multiplier: ' + multiplier.toFixed(2) + 'x | Bet: ' + bet);
        
        return { bet: bet, chance: chance, condition: 'above' };
    }

    async function runRecovery() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        var r = STATE.recovery;
        var profit = STATE.balance - STATE.startBalance;
        
        updateDrawdown();
        
        console.log('[RECOVERY] Profit: ' + profit + ' | Loss Streak: ' + r.lossStreak + ' | Drawdown: ' + STATE.drawdownPct.toFixed(2) + '%');
        
        if (profit >= 0) {
            STATE.isRecoveryMode = false;
            var finalProfit = STATE.balance - STATE.startBalance;
            resetRecoveryState();
            sendTelegramMessage('✅ BACK TO NORMAL! (BEP)\nProfit: ' + finalProfit.toFixed(8));
            updateAllUI();
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        if (r.lossStreak >= STATE.recoveryMaxLossStreak) {
            r.lossStreak = 0;
            r.currentBet = r.baseBet;
            console.log('[MARTINGALE] Loss Streak max reached! Reset to baseBet');
            sendTelegramMessage('🔄 MAX LS (' + STATE.recoveryMaxLossStreak + 'x) RESET TO BASE');
            updateAllUI();
            setTimeout(runRecovery, 0);
            return;
        }
        
        if (STATE.balance <= STATE.minBet * 2) {
            STATE.isRecoveryMode = false;
            resetRecoveryState();
            sendTelegramMessage('⚠️ BALANCE TOO LOW! Stopping recovery.');
            updateAllUI();
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        var action = calculateMartingaleBet();
        var betAmount = action.bet;
        var chance = action.chance;
        var condition = action.condition;
        
        console.log('[RECOVERY] Bet: ' + betAmount + ' | Chance: ' + chance + '%');
        
        var result = await placeDiceBet(betAmount, chance, condition);
        
        if (result) {
            var profitResult = result.profit || 0;
            var isWin = result.win;
            
            r.totalBets++;
            r.lastResult = isWin;
            
            if (isWin) {
                r.win++;
                r.lossStreak = 0;
                console.log('[MARTINGALE] WIN! Loss streak reset');
            } else {
                r.loss++;
                r.lossStreak++;
                console.log('[MARTINGALE] LOSS! Loss streak: ' + r.lossStreak);
            }
            
            if (betAmount > r.maxBet) r.maxBet = betAmount;
            
            STATE.bets++;
            STATE.wagered += betAmount;
            STATE.betTimestamps.push(Date.now());
            if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
            
            if (isWin) {
                STATE.wins++;
                STATE.lossStreak = 0;
            } else {
                STATE.losses++;
                STATE.lossStreak++;
            }
            
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.drawdown = STATE.startBalance - STATE.balance;
            if (STATE.drawdown > STATE.maxDrawdown) STATE.maxDrawdown = STATE.drawdown;
            if (betAmount > STATE.maxBet) STATE.maxBet = betAmount;
            
            STATE.wagerSesiCounter += betAmount;
            STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
            if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
            
            var wageredUSD = betAmount * STATE.fiatRates.usd;
            STATE.raffle.wageredFromBot += wageredUSD;
            var wageredFromStake = STATE.raffle.progress * STATE.raffle.ticketValue;
            var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
            STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
            if (STATE.raffle.nextTicketRemaining <= 0) STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
            
            var chanceDisplay = chance + '% ' + (isWin ? 'WIN' : 'LOSS') + ' [LS:' + r.lossStreak + ']';
            logBet(STATE.bets, betAmount, chanceDisplay, profitResult);
            
            // ===== MINI ML TRAINING =====
            if (STATE.mlEnabled && STATE.miniML) {
                collectTrainingData();
            }
            
            // ===== AUTO STRATEGY =====
            autoAdjustStrategy();
            
            updateDrawdown();
            
            var newProfit = STATE.balance - STATE.startBalance;
            if (newProfit >= 0) {
                STATE.isRecoveryMode = false;
                var finalProfit2 = STATE.balance - STATE.startBalance;
                resetRecoveryState();
                sendTelegramMessage('✅ BACK TO NORMAL! (BEP)\nProfit: ' + finalProfit2.toFixed(8));
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 0);
                return;
            }
            
            if (r.lossStreak >= STATE.recoveryMaxLossStreak) {
                r.lossStreak = 0;
                r.currentBet = r.baseBet;
                sendTelegramMessage('🔄 MAX LS (' + STATE.recoveryMaxLossStreak + 'x) RESET TO BASE');
                updateAllUI();
                setTimeout(runRecovery, 0);
                return;
            }
            
            updateAllUI();
            setTimeout(runRecovery, 0);
            
        } else {
            console.log('[RECOVERY] Bet returned null, retrying...');
            setTimeout(runRecovery, 100);
        }
    }

    function resetRecoveryState() {
        STATE.recovery.isActive = false;
        STATE.recovery.totalLoss = 0;
        STATE.recovery.currentBet = 0;
        STATE.recovery.baseBet = 0;
        STATE.recovery.lossStreak = 0;
        STATE.recovery.win = 0;
        STATE.recovery.loss = 0;
        STATE.recovery.totalBets = 0;
        STATE.recovery.maxBet = 0;
        STATE.recovery.lastResult = null;
        STATE.isRecoveryMode = false;
        
        STATE.drawdown = 0;
        STATE.drawdownPct = 0;
        STATE.maxDrawdown = 0;
        STATE.lossStreak = 0;
    }

    // ==================== 14. START RECOVERY ====================
    function startRecovery() {
        console.log('[RECOVERY] Starting...');
        
        if (STATE.balance <= STATE.minBet * 2) {
            STATE.isRecoveryMode = false;
            sendTelegramMessage('⚠️ BALANCE TOO LOW! Cannot start recovery.');
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        var totalLoss = STATE.startBalance - STATE.balance;
        if (totalLoss <= 0) {
            STATE.isRecoveryMode = false;
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        STATE.recovery.isActive = true;
        STATE.recovery.totalLoss = totalLoss;
        STATE.recovery.lossStreak = 0;
        STATE.recovery.win = 0;
        STATE.recovery.loss = 0;
        STATE.recovery.totalBets = 0;
        STATE.recovery.maxBet = 0;
        STATE.recovery.lastResult = null;
        STATE.isRecoveryMode = true;
        
        var baseBetPct = STATE.recoveryBaseBetPct || 0.5;
        var baseBet = STATE.balance * (baseBetPct / 100);
        baseBet = Math.max(baseBet, STATE.minBet);
        STATE.recovery.baseBet = baseBet;
        STATE.recovery.currentBet = baseBet;
        
        sendTelegramMessage('🔄 RECOVERY STARTED\n' +
            'Loss: ' + totalLoss.toFixed(8) + '\n' +
            'Chance: ' + STATE.recoveryChance + '%\n' +
            'Base Bet: ' + baseBetPct + '% (' + baseBet.toFixed(8) + ')\n' +
            'Max Bet: ' + STATE.recoveryMaxBetPct + '%\n' +
            'Max LS: ' + STATE.recoveryMaxLossStreak + 'x');
        
        updateAllUI();
        setTimeout(runRecovery, 100);
    }

    // ==================== 15. FIRE & FORGET ====================
    function sendFireAndForgetBet() {
        if (STATE.isRecoveryMode) {
            console.log('[F&F] Recovery active, skipping...');
            return;
        }
        
        if (!STATE.isRunning || STATE.isPaused) return;
        
        autoAdjustStrategy();
        updateDrawdown();
        
        var drawdownPct = STATE.drawdownPct;
        console.log('[F&F] Drawdown: ' + drawdownPct.toFixed(2) + '% | Trigger: ' + STATE.triggerDrawdownPct + '%');
        
        if (drawdownPct >= STATE.triggerDrawdownPct && STATE.mlPhase > 1) {
            console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
            startRecovery();
            return;
        }
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        var betAmount = STATE.balance * (STATE.baseBetPercent / 100);
        betAmount = Math.max(betAmount, STATE.minBet);
        betAmount = Math.min(betAmount, STATE.balance * 0.5);
        if (STATE.maxBetCap > 0) betAmount = Math.min(betAmount, STATE.maxBetCap);
        betAmount = parseFloat(betAmount.toFixed(8));
        
        console.log('[F&F] Dice 99.98% | Bet:', betAmount);
        
        placeDiceBet(betAmount, STATE.normalChance, 'above').then(function(result) {
            if (result) {
                processBetResult(result, betAmount, 'normal', true);
                if (STATE.mlEnabled && STATE.miniML) {
                    collectTrainingData();
                }
                autoAdjustStrategy();
                updateDrawdown();
            }
        }).catch(function(e) { console.error('[F&F] Dice error:', e); });
        
        setTimeout(sendFireAndForgetBet, STATE.delayNormal);
    }

    // ==================== 16. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        var isWin = result.win;
        var chance = result.chance || STATE.normalChance;
        var profit = result.profit || 0;
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.drawdown = STATE.startBalance - STATE.balance;
        updateDrawdown();
        
        if (STATE.drawdown > STATE.maxDrawdown) STATE.maxDrawdown = STATE.drawdown;
        if (betAmount > STATE.maxBet) STATE.maxBet = betAmount;
        
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        var wageredUSD = betAmount * STATE.fiatRates.usd;
        STATE.raffle.wageredFromBot += wageredUSD;
        var wageredFromStake = STATE.raffle.progress * STATE.raffle.ticketValue;
        var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
        STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
        if (STATE.raffle.nextTicketRemaining <= 0) STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
        
        logBet(STATE.bets, betAmount, chance.toFixed(1) + '%', profit);
        
        var drawdownPct = STATE.drawdownPct;
        if (drawdownPct >= STATE.triggerDrawdownPct && !STATE.isRecoveryMode && STATE.mlPhase > 1) {
            console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
            startRecovery();
            return;
        }
        
        if (STATE.wagerSesiCounter >= STATE.wagerSesiTarget) {
            resetWagerSesi();
        }
        
        updateAllUI();
    }

