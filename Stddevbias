    // ==================== 17. RUN DUAL RECOVERY ====================
    async function runDualRecovery() {
        if (!STATE.isRunning || STATE.isPaused) return;
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        var p = STATE.paroli;
        if (p.isProcessing) {
            setTimeout(runDualRecovery, 0);
            return;
        }
        
        if (STATE.balance <= STATE.minBet * 2) {
            STATE.isRecoveryMode = false;
            resetProfitOnNormalReturn();
            sendTelegramMessage('⚠️ BALANCE TOO LOW! Stopping recovery.');
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        var mode = selectRecoveryMode();
        console.log('[DUAL] Selected mode:', mode);
        
        if (mode === 'ml') {
            await runMLRecovery();
        } else {
            await runBJRecovery();
        }
    }

    async function runMLRecovery() {
        var p = STATE.paroli;
        STATE.dualRecovery.mlCount++;
        STATE.dualRecovery.bjCount = 0;
        
        if (!STATE.mlSystem) {
            STATE.mlSystem = new MLRecoverySystem();
        }
        
        var totalLoss = STATE.startBalance - STATE.balance;
        
        if (!STATE.mlSystem.isActive) {
            var basebet = STATE.balance * (STATE.baseBetPercent / 100);
            if (basebet < STATE.minBet) basebet = STATE.minBet;
            
            var mlAction = STATE.mlSystem.startRecovery(
                totalLoss,
                STATE.balance,
                STATE.minBet,
                STATE.maxBetCap || STATE.balance * 0.2
            );
            
            if (mlAction) {
                p.level = 1;
                p.unit = Math.max(mlAction.betAmount, STATE.minBet);
                p.currentBet = p.unit;
                p.currentChance = Math.min(mlAction.chance, 99.98);
                p.currentCondition = mlAction.condition || 'above';
                p.mlActive = true;
                p.targetRecovery = totalLoss * 0.75;
                p.recoveredAmount = 0;
            } else {
                p.level = 1;
                p.unit = basebet;
                p.currentBet = Math.max(p.unit, STATE.minBet);
                p.currentChance = Math.min(p.baseChanceMax, 99.98);
                p.currentCondition = 'above';
                p.mlActive = false;
            }
            p.isProcessing = false;
            p.recoveryCount++;
            STATE.isRecoveryMode = true;
