        var entry = document.createElement("div");
        entry.style.cssText = "padding:2px 6px;font-size:10px;font-family:monospace;border-bottom:1px solid " + 
            (STATE.darkMode ? "#1a1a2e" : "#f0f0f0") + 
            ";display:flex;justify-content:space-between;gap:8px;align-items:center;";
        
        var profitColor = profit > 0 ? '#00e5c0' : profit < 0 ? '#ff6b81' : '#ffd93d';
        var profitSign = profit > 0 ? '+' : '';
        var chanceDisplay = (typeof chance === 'string' ? chance : chance.toFixed(1) + '%');
        var profitPct = amount > 0 ? (profit / amount * 100) : 0;
        var profitPctDisplay = profitPct > 0 ? '+' + profitPct.toFixed(1) + '%' : profitPct.toFixed(1) + '%';
        
        entry.innerHTML = `
            <span style="color:#606060;min-width:35px;font-size:9px;">#${betNumber}</span>
            <span style="color:#9ec07c;min-width:55px;font-size:9px;">${chanceDisplay}</span>
            <span style="color:#a0a0a0;min-width:85px;font-size:9px;">${amount.toFixed(8)}</span>
            <span style="color:${profitColor};font-weight:bold;min-width:85px;font-size:9px;text-align:right;">${profitSign}${profit.toFixed(8)} (${profitPctDisplay})</span>
        `;
        logBox.insertBefore(entry, logBox.firstChild);
        while (logBox.children.length > STATE.maxLogs) {
            logBox.removeChild(logBox.lastChild);
        }
    }

    // ==================== 18. RESET FUNCTIONS ====================
    function resetWagerSesi() {
        STATE.wagerTotalAccumulated += STATE.wagerSesiCounter;
        STATE.wagerSesiCounter = 0;
        STATE.wagerSesiStartBal = STATE.balance;
        STATE.wagerSesiProfit = 0;
        STATE.wagerWaitingForTrigger = false;
        updateAllUI();
    }

    function fullReset() {
        STATE.isRunning = false;
        STATE.isPaused = false;
        STATE.isRecoveryMode = false;
        STATE.isResting = false;
        STATE.recovery.isActive = false;
        STATE.recovery.win = 0;
        STATE.recovery.loss = 0;
        STATE.recovery.totalBets = 0;
        STATE.recovery.lossStreak = 0;
        STATE.recovery.currentBet = 0;
        STATE.recovery.baseBet = 0;
        STATE.recovery.maxBet = 0;
        STATE.recovery.lastResult = null;
        STATE.wagerTotalAccumulated = 0;
        STATE.wagerSesiCounter = 0;
        STATE.wagerStop = false;
        STATE.wagerWaitingForTrigger = false;
        STATE.bets = 0;
        STATE.wins = 0;
        STATE.losses = 0;
        STATE.profit = 0;
        STATE.wagered = 0;
        STATE.highestProfit = 0;
        STATE.lossStreak = 0;
        STATE.drawdown = 0;
        STATE.drawdownPct = 0;
        STATE.maxDrawdown = 0;
        STATE.maxBet = 0;
        STATE.raffle.wageredFromBot = 0;
        STATE.betTimestamps = [];
        STATE.startTime = null;
        STATE.sessionStartTime = null;
        STATE.trainingHistory = [];
        STATE.mlPhase = 1;
        if (STATE.miniML) {
            STATE.miniML.history = [];
            STATE.miniML.accuracy = 0;
        }
        toggleStartStop(false);
        updateAllUI();
    }

    // ==================== 19. UI UPDATES ====================
    function updateStatsDisplay() {
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.stats.profit = STATE.profit;
        STATE.stats.currentBal = STATE.balance;
        
        updateDrawdown();
        
        var currentBalance = STATE.balance || 0;
        var profit = STATE.profit;
        var profitPct = STATE.startBalance > 0 ? (profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var betSpeed = getBetSpeed();
        var drawdown = STATE.startBalance - currentBalance;
        var drawdownPct = STATE.startBalance > 0 ? (drawdown / STATE.startBalance * 100) : 0;
        
        var status;
        if (STATE.isRecoveryMode) {
            var totalLoss = STATE.startBalance - STATE.balance;
            var progress = totalLoss > 0 ? (profit / -totalLoss * 100) : 0;
            if (progress < 0) progress = 0;
            if (progress > 100) progress = 100;
            status = '🔄 MARTINGALE ' + progress.toFixed(0) + '%';
        } else {
            var phaseLabel = STATE.mlPhase === 1 ? '📊 Collect' : 
                           STATE.mlPhase === 2 ? '🧠 ML Active' : '🚀 Full ML';
            status = '⚡ ' + phaseLabel + ' 🎲';
        }
        
        var mlStatus = STATE.mlEnabled ? '✅ ML' : '❌ ML';
        if (STATE.miniML && STATE.mlEnabled) {
            mlStatus += ' ' + (STATE.miniML.accuracy * 100).toFixed(0) + '%';
        }
        
        var map = {
            "st-user": STATE.stakeUser,
            "st-running-time": runTime,
            "st-balance": currentBalance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase(),
            "st-profit": (profit >= 0 ? '+' : '') + profit.toFixed(8) + ' (' + (profitPct >= 0 ? '+' : '') + profitPct.toFixed(2) + '%)',
            "st-wagered": STATE.wagered.toFixed(8) + ' (Total: ' + STATE.wagerTotalAccumulated.toFixed(8) + ')',
            "st-bets": STATE.bets + ' | WR ' + winRate.toFixed(0) + '%',
            "st-speed": betSpeed.toFixed(1) + 'b/s',
            "st-chance": status + ' | DD: ' + drawdownPct.toFixed(2) + '%',
            "st-gaphits": drawdown.toFixed(8),
            "st-timer": STATE.isResetting ? '⏰ ' + STATE.resetCountdownRemaining + 's' : '--',
            "st-minbet": STATE.minBet.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + ' (2 IDR)',
            "st-maxdd": STATE.maxDrawdown.toFixed(8),
            "st-maxbet": STATE.maxBet.toFixed(8),
            "st-ddnow": drawdown.toFixed(8),
            "st-ml": mlStatus
        };
        
        for (var id in map) {
            var el = document.getElementById(id);
            if (el) el.textContent = map[id];
        }
        
        var profitEl = document.getElementById("st-profit");
        if (profitEl) {
            profitEl.textContent = map["st-profit"];
            profitEl.style.color = profit >= 0 ? '#00A86B' : '#FF4757';
        }
    }

    function updateAllUI() {
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.stats.profit = STATE.profit;
        STATE.stats.currentBal = STATE.balance;
        
        updateDrawdown();
        updateStatsDisplay();
        updateRaffleDisplay();
        
        var now = Date.now();
        if (now - STATE.lastTGReport >= CONFIG.tgReportInterval && STATE.bets > 0) {
            STATE.lastTGReport = now;
            sendSessionReport();
        }
    }

    // ==================== 20. SESSION REPORT ====================
    async function sendSessionReport() {
        STATE.profit = STATE.balance - STATE.startBalance;
        
        var profitPct = STATE.startBalance > 0 ? (STATE.profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var status = STATE.isRecoveryMode ? '🔄 MARTINGALE RECOVERY' : '⚡ NORMAL';
        var drawdownPct = STATE.startBalance > 0 ? ((STATE.startBalance - STATE.balance) / STATE.startBalance * 100) : 0;
        var raffleProgress = (STATE.raffle.progress * 100).toFixed(1);
        var raffleTickets = STATE.raffle.userTickets;
        var wageredUSD = STATE.raffle.wageredFromBot;
        var mlAcc = STATE.miniML ? (STATE.miniML.accuracy * 100).toFixed(1) : '0';
        var dataCount = STATE.trainingHistory ? STATE.trainingHistory.length : 0;
        var phaseLabel = STATE.mlPhase === 1 ? '📊 Data Collection' : 
                       STATE.mlPhase === 2 ? '🧠 ML Active' : '🚀 Full ML';
        
        var message = '💰 CHEAPCHEATX v3.0 (MiniML ' + phaseLabel + ')\n' +
                      'User: ' + STATE.stakeUser + '\n' +
                      'Time: ' + runTime + '\n' +
                      'Balance: ' + STATE.balance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + '\n' +
                      'Profit: ' + (STATE.profit >= 0 ? '+' : '') + STATE.profit.toFixed(8) + ' (' + profitPct.toFixed(2) + '%)\n' +
                      'Wagered: ' + STATE.wagered.toFixed(8) + '\n' +
                      'Bets: ' + STATE.bets + ' | WR: ' + winRate.toFixed(0) + '%\n' +
                      'Drawdown: ' + drawdownPct.toFixed(2) + '%\n' +
                      'ML Data: ' + dataCount + ' | Acc: ' + mlAcc + '%\n' +
                      '🎟️ Raffle: ' + raffleProgress + '% | ' + raffleTickets + ' tickets | Bot: $' + wageredUSD.toFixed(2) + '\n' +
                      'Status: ' + status;
        await sendTelegramMessage(message);
    }

    // ==================== 21. RUN LOOP ====================
    function runLoop() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        if (STATE.isRecoveryMode) {
            runRecovery();
        } else {
            sendFireAndForgetBet();
        }
    }

    // ==================== 22. UI CONTROLS ====================
    function toggleStartStop(starting) {
        var startBtn = document.getElementById("p-start");
        var stopBtn = document.getElementById("p-stop");
        var pauseBtn = document.getElementById("p-pause");
        var statusEl = document.getElementById("botStatus");
        var dotEl = document.getElementById("statusDot");
        if (starting) {
            if (startBtn) startBtn.disabled = true;
            if (stopBtn) stopBtn.disabled = false;
            if (pauseBtn) pauseBtn.disabled = false;
            if (statusEl) statusEl.textContent = "RUN";
            if (dotEl) dotEl.style.background = "#00A86B";
        } else {
            if (startBtn) startBtn.disabled = false;
            if (stopBtn) stopBtn.disabled = true;
            if (pauseBtn) pauseBtn.disabled = true;
            if (statusEl) statusEl.textContent = "STOP";
            if (dotEl) dotEl.style.background = "#FF4757";
        }
    }

