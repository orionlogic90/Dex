            this.isActive = false;
            this.totalLoss = 0;
            this.targetRecovery = 0;
            this.recoveredAmount = 0;
            this.currentBetMultiplier = 1.0;
            this.currentChance = 78;
            this.history = [];
            this.maxHistory = 100;
            this.learningRate = 0.1;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.optimalChance = 78;
            this.optimalBetMultiplier = 0.5;
            this.lastAction = null;
            this.actionHistory = [];
            this.performanceScore = 0;
            this.recoverySessionActive = false;
            this.sessionStartLoss = 0;
            this.bestChance = 78;
            this.bestBetMultiplier = 0.5;
            this.bestPerformance = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.baseBet = 0;
            this.maxBet = 0;
            this.minBet = 0;
            this.initialBalance = 0;
            this.currentBalance = 0;
            this.noProgressCounter = 0;
            this.maxNoProgress = 10;
            this.lastRecoveredAmount = 0;
            this.timeoutId = null;
            this.recoveryAttempts = 0;
            this.recoveryProfit = 0;
            this.dribbleWins = 0;
            this.dribbleLosses = 0;
            this.dribbleTotalBets = 0;
            this.dribbleBestStreak = 0;
            this.dribbleWorstStreak = 0;
            this.dribbleCurrentStreak = 0;
        }

        startRecovery(totalLoss, initialBalance, minBet, maxBet) {
            this.isActive = true;
            this.totalLoss = totalLoss;
            this.targetRecovery = totalLoss * 0.75;
            this.recoveredAmount = 0;
            this.recoveryProfit = 0;
            this.recoverySessionActive = true;
            this.sessionStartLoss = totalLoss;
            this.currentBetMultiplier = 0.5;
            this.currentChance = 78;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.history = [];
            this.actionHistory = [];
            this.performanceScore = 0;
            this.optimalChance = 78;
            this.optimalBetMultiplier = 0.5;
            this.bestChance = 78;
            this.bestBetMultiplier = 0.5;
            this.bestPerformance = 0;
            this.noProgressCounter = 0;
            this.lastRecoveredAmount = 0;
            this.recoveryAttempts++;
            this.dribbleWins = 0;
            this.dribbleLosses = 0;
            this.dribbleTotalBets = 0;
            this.dribbleBestStreak = 0;
            this.dribbleWorstStreak = 0;
            this.dribbleCurrentStreak = 0;
            
            const defaultChance = 78;
            const payoutMultiplier = 100 / (100 - defaultChance);
            const profitPerUnit = payoutMultiplier - 1;
            this.baseBet = this.targetRecovery / profitPerUnit;
            
            this.maxBet = this.targetRecovery * 0.8;
            this.minBet = minBet;
            this.initialBalance = initialBalance;
            this.currentBalance = initialBalance;
            
            this.loadLearningData();
            
            console.log('[ML] Recovery session started (75%)');
            console.log('[ML] Total Loss:', totalLoss);
            console.log('[ML] Target Recovery (75%):', this.targetRecovery);
            console.log('[ML] Base Bet (78% chance):', this.baseBet);
            console.log('[ML] Max Bet:', this.maxBet);
            
            return this.calculateOptimalAction();
        }

        loadLearningData() {
            try {
                const saved = localStorage.getItem('ml_recovery_data_v3');
                if (saved) {
                    const data = JSON.parse(saved);
                    if (data.bestPerformance > 0) {
                        this.optimalChance = data.optimalChance || 78;
                        this.optimalBetMultiplier = data.optimalBetMultiplier || 0.5;
                        this.bestChance = data.bestChance || 78;
                        this.bestBetMultiplier = data.bestBetMultiplier || 0.5;
                        this.bestPerformance = data.bestPerformance || 0;
                        console.log('[ML] Loaded learning data:', data);
                    } else {
                        console.log('[ML] Best performance <= 0, using fresh data');
                        localStorage.removeItem('ml_recovery_data_v3');
                    }
                }
            } catch(e) {
                console.log('[ML] No saved learning data');
            }
        }

        saveLearningData() {
            try {
                if (this.bestPerformance > 0) {
                    const data = {
                        optimalChance: this.optimalChance,
                        optimalBetMultiplier: this.optimalBetMultiplier,
                        bestChance: this.bestChance,
                        bestBetMultiplier: this.bestBetMultiplier,
                        bestPerformance: this.bestPerformance,
                        timestamp: Date.now()
                    };
                    localStorage.setItem('ml_recovery_data_v3', JSON.stringify(data));
                }
            } catch(e) {}
        }

        calculateOptimalAction() {
            if (!this.isActive || !this.recoverySessionActive) {
                return null;
            }

            const recoveryProgress = this.targetRecovery > 0 ? this.recoveredAmount / this.targetRecovery : 0;
            
            let chance;
            if (recoveryProgress < 0.3) {
                chance = 78;
            } else if (recoveryProgress < 0.6) {
                chance = 76;
            } else {
                chance = 75;
            }
            
            if (this.consecutiveWins >= 3) {
                chance = Math.min(chance + 1, 80);
            }
            if (this.consecutiveLosses >= 2) {
                chance = Math.max(chance - 1, 70);
            }
            
            chance = Math.max(70, Math.min(80, chance));
            
            const payoutMultiplier = 100 / (100 - chance);
            const profitPerUnit = payoutMultiplier - 1;
            const baseBetFromChance = this.targetRecovery / profitPerUnit;
            
            let betMultiplier;
            if (recoveryProgress < 0.3) {
                betMultiplier = 0.4;
            } else if (recoveryProgress < 0.6) {
                betMultiplier = 0.6;
            } else {
                betMultiplier = 0.8;
            }
            
            if (this.consecutiveWins >= 3) {
                betMultiplier = Math.min(betMultiplier * 1.1, 0.9);
            }
            if (this.consecutiveLosses >= 2) {
                betMultiplier = Math.max(betMultiplier * 0.9, 0.3);
            }
            
            betMultiplier = Math.max(0.3, Math.min(0.9, betMultiplier));
            
            let finalBet = baseBetFromChance * betMultiplier;
            finalBet = Math.max(finalBet, this.minBet);
            finalBet = Math.min(finalBet, this.maxBet);
            
            if (finalBet < this.minBet) {
                let tempChance = chance;
                while (tempChance < 98 && finalBet < this.minBet) {
                    tempChance += 1;
                    const tempPayout = 100 / (100 - tempChance);
                    const tempProfit = tempPayout - 1;
                    const tempBet = this.targetRecovery / tempProfit * betMultiplier;
                    if (tempBet > finalBet) {
                        finalBet = Math.max(tempBet, this.minBet);
                        chance = tempChance;
                    }
                }
            }
            
            if (finalBet > this.maxBet) {
                finalBet = this.maxBet;
            }
            finalBet = Math.min(finalBet, this.currentBalance * 0.5);
            
            this.lastAction = {
                betAmount: finalBet,
                chance: chance,
                betMultiplier: betMultiplier,
                timestamp: Date.now()
            };

            console.log(`[ML] Action calculated (75% recovery):`);
            console.log(`  - Chance: ${chance.toFixed(1)}% (multiplier: ${payoutMultiplier.toFixed(2)}x)`);
            console.log(`  - Final Bet: ${finalBet.toFixed(8)}`);
            console.log(`  - Progress: ${(recoveryProgress*100).toFixed(1)}%`);

            return {
                betAmount: finalBet,
                chance: chance,
                condition: 'above'
            };
        }

        updateWithResult(win, profit, betAmount, chance) {
            if (!this.isActive || !this.recoverySessionActive) return;

            this.history.push({ win, profit, betAmount, chance, timestamp: Date.now() });
            if (this.history.length > this.maxHistory) this.history.shift();

            if (win) {
                this.consecutiveWins++;
                this.consecutiveLosses = 0;
                this.winStreak++;
                this.dribbleWins++;
                this.dribbleCurrentStreak = this.dribbleCurrentStreak > 0 ? this.dribbleCurrentStreak + 1 : 1;
                if (this.dribbleCurrentStreak > this.dribbleBestStreak) {
                    this.dribbleBestStreak = this.dribbleCurrentStreak;
                }
                this.recoveredAmount += profit;
                this.recoveryProfit += profit;
                
                if (this.lastAction) {
                    const performance = profit / (betAmount || 1);
                    this.performanceScore += performance * this.learningRate;
                    
                    if (performance > 0) {
                        this.optimalChance = this.optimalChance * (1 - this.learningRate * 0.1) + 
                                           this.lastAction.chance * this.learningRate * 0.1;
                        this.optimalBetMultiplier = this.optimalBetMultiplier * (1 - this.learningRate * 0.1) + 
                                                  this.lastAction.betMultiplier * this.learningRate * 0.1;
                    }
                }
            } else {
                this.consecutiveLosses++;
                this.consecutiveWins = 0;
                this.lossStreak++;
                this.dribbleLosses++;
                this.dribbleCurrentStreak = this.dribbleCurrentStreak < 0 ? this.dribbleCurrentStreak - 1 : -1;
                if (this.dribbleCurrentStreak < this.dribbleWorstStreak) {
                    this.dribbleWorstStreak = this.dribbleCurrentStreak;
                }
                this.recoveredAmount -= Math.abs(profit);
                this.recoveryProfit -= Math.abs(profit);
                
                if (this.lastAction) {
                    this.optimalBetMultiplier *= (1 - this.learningRate * 0.2);
                }
            }

            this.dribbleTotalBets = this.dribbleWins + this.dribbleLosses;

            this.optimalChance = Math.max(70, Math.min(80, this.optimalChance));
            this.optimalBetMultiplier = Math.max(0.3, Math.min(0.9, this.optimalBetMultiplier));

            if (this.recoveredAmount >= this.targetRecovery) {
                this.isActive = false;
                this.recoverySessionActive = false;
                this.saveLearningData();
                console.log('[ML] ✅ Recovery target achieved! (75%)');
                console.log(`[ML] Recovered: ${this.recoveredAmount.toFixed(8)} / ${this.targetRecovery.toFixed(8)}`);
                return;
            }

            if (this.recoveredAmount < -this.totalLoss * 0.5) {
                this.isActive = false;
                this.recoverySessionActive = false;
                console.log('[ML] ❌ Recovery failed - too much loss');
                return;
            }

            if (this.lastAction) {
                this.actionHistory.push({
                    action: { ...this.lastAction },
                    result: win ? 'win' : 'loss',
                    profit: profit,
                    recoveredAmount: this.recoveredAmount
                });
            }

            if (this.recoveredAmount > 0 && this.recoveredAmount > this.bestPerformance) {
                this.bestPerformance = this.recoveredAmount;
                this.bestChance = this.optimalChance;
                this.bestBetMultiplier = this.optimalBetMultiplier;
                this.saveLearningData();
            }

            console.log(`[ML DRIBBLE] ${win ? '✅ WIN' : '❌ LOSS'} | Progress: ${(this.recoveredAmount/this.targetRecovery*100).toFixed(1)}%`);
        }

        getStatus() {
            return {
                isActive: this.isActive,
                totalLoss: this.totalLoss,
                targetRecovery: this.targetRecovery,
                recoveredAmount: this.recoveredAmount,
                recoveryProfit: this.recoveryProfit,
                progress: this.targetRecovery > 0 ? this.recoveredAmount / this.targetRecovery : 0,
                remaining: this.targetRecovery - this.recoveredAmount,
                currentChance: Math.min(this.optimalChance, 80),
                currentMultiplier: this.optimalBetMultiplier,
                winStreak: this.winStreak,
                lossStreak: this.lossStreak,
                bestChance: this.bestChance,
                bestMultiplier: this.bestBetMultiplier,
                bestPerformance: this.bestPerformance,
                dribbleWins: this.dribbleWins,
                dribbleLosses: this.dribbleLosses,
                dribbleTotalBets: this.dribbleTotalBets,
                dribbleWinRate: this.dribbleTotalBets > 0 ? (this.dribbleWins / this.dribbleTotalBets * 100) : 0,
                dribbleBestStreak: this.dribbleBestStreak,
                dribbleWorstStreak: this.dribbleWorstStreak
            };
        }

        reset() {
            this.isActive = false;
            this.recoverySessionActive = false;
            this.totalLoss = 0;
            this.targetRecovery = 0;
            this.recoveredAmount = 0;
            this.recoveryProfit = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.actionHistory = [];
            this.history = [];
            this.performanceScore = 0;
            this.noProgressCounter = 0;
            if (this.timeoutId) {
                clearTimeout(this.timeoutId);
                this.timeoutId = null;
            }
        }
    }

