    // ==================== 8. PLACE DICE BET ====================
    async function placeDiceBet(amount, chance, condition) {
        var target = condition === 'above' ? (100 - chance) : chance;
        var apiAmount = parseFloat(amount.toFixed(8));
        
        try {
            var payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                target: target,
                condition: condition || "above",
                identifier: generateId()
            };
            
            var res = await fetch(CONFIG.apiUrl + '/casino/dice/roll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.diceRoll) {
                return null;
            }
            
            var d = data.diceRoll;
            
            var expectedPayoutMultiplier = 99 / chance;
            var actualPayoutMultiplier = parseFloat(d.payoutMultiplier) || expectedPayoutMultiplier;
            var payout = parseFloat(d.payout) || 0;
            var winAmount = parseFloat(d.amount) || apiAmount;
            
            var win = false;
            if (d.win !== undefined) {
                win = d.win;
            } else {
                var state = d.state;
                if (state && state.result !== undefined && state.target !== undefined) {
                    win = state.condition === "above" ? state.result > state.target : state.result < state.target;
                }
            }
            
            var profitAmount = 0;
            if (win) {
                var profitMultiplier = (99 / chance) - 1;
                profitAmount = profitMultiplier * winAmount;
            } else {
                profitAmount = -winAmount;
            }
            
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance += profitAmount;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.stats.profit = STATE.profit;
            STATE.stats.currentBal = STATE.balance;
            
            console.log('[DICE] ' + (win ? 'WIN' : 'LOSS') + ' | Chance: ' + chance + '% | Multiplier: ' + (99/chance).toFixed(4) + 'x | Profit: ' + profitAmount.toFixed(8));
            
            updateAllUI();
            
            return {
                win: win,
                payout: payout,
                payoutMultiplier: actualPayoutMultiplier,
                amount: winAmount,
                state: d.state,
                result: win ? 'win' : 'loss',
                game: 'dice',
                chance: chance,
                profit: profitAmount,
                expectedMultiplier: 99 / chance
            };
            
        } catch (error) {
            console.error('[DICE] Exception:', error);
            return null;
        }
    }

    // ==================== 9. PLACE BACCARAT BET (Normal 2 Sisi) ====================
    async function placeBaccaratBet(amount) {
        var mode = STATE.baccaratMode || 'both';
        var multiplier = STATE.baccaratBetMultiplier || 1;
        var betAmount = amount * multiplier;
        var halfBet = betAmount / 2;
        
        try {
            var payload = {
                currency: STATE.selectedCurrency,
                identifier: generateId(),
                tie: 0,
                player: 0,
                banker: 0
            };
            
            switch(mode) {
                case 'both':
                    payload.player = parseFloat(halfBet.toFixed(8));
                    payload.banker = parseFloat(halfBet.toFixed(8));
                    break;
                case 'player':
                    payload.player = parseFloat(betAmount.toFixed(8));
                    break;
                case 'banker':
                    payload.banker = parseFloat(betAmount.toFixed(8));
                    break;
                default:
                    payload.player = parseFloat(halfBet.toFixed(8));
                    payload.banker = parseFloat(halfBet.toFixed(8));
            }
            
            var res = await fetch(CONFIG.apiUrl + '/casino/baccarat/bet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.baccaratBet) {
                return null;
            }
            
            var d = data.baccaratBet;
            var result = d.state?.result || 'tie';
            var totalBet = parseFloat(d.amount) || betAmount;
            var payout = parseFloat(d.payout) || 0;
            var payoutMultiplier = parseFloat(d.payoutMultiplier) || 0;
            
            var profit = 0;
            var isWin = false;
            
            if (mode === 'both') {
                if (result === 'player') {
                    isWin = true;
                    profit = 0;
                } else if (result === 'banker') {
                    isWin = false;
                    profit = -totalBet * 0.05;
                } else {
                    isWin = false;
                    profit = -totalBet;
                }
            } else if (mode === 'player') {
                if (result === 'player') {
                    isWin = true;
                    profit = betAmount * 1.0;
                } else {
                    isWin = false;
                    profit = -betAmount;
                }
            } else if (mode === 'banker') {
                if (result === 'banker') {
                    isWin = true;
                    profit = betAmount * 0.95;
                } else {
                    isWin = false;
                    profit = -betAmount;
                }
            }
            
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance += profit;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.stats.profit = STATE.profit;
            STATE.stats.currentBal = STATE.balance;
            
            var resultLabel = result === 'player' ? 'Player' : result === 'banker' ? 'Banker' : 'Tie';
            var winStatus = isWin ? 'WIN' : 'LOSS';
            console.log('[BACCARAT] ' + winStatus + ' | Result: ' + resultLabel + ' | Bet: ' + totalBet + ' | Payout: ' + payout + ' | Profit: ' + profit.toFixed(8));
            
            updateAllUI();
            
            return {
                win: isWin,
                result: result,
                profit: profit,
                amount: totalBet,
                payout: payout,
                payoutMultiplier: payoutMultiplier,
                game: 'baccarat',
                mode: mode
            };
            
        } catch (error) {
            console.error('[BACCARAT] Exception:', error);
            return null;
        }
    }

