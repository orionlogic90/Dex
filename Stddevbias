    // ==================== 16. UI UPDATES ====================
    function updateStatsDisplay() {
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.stats.profit = STATE.profit;
        STATE.stats.currentBal = STATE.balance;
        
        var currentBalance = STATE.balance || 0;
        var profit = STATE.profit;
        var profitPct = STATE.startBalance > 0 ? (profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var betSpeed = getBetSpeed();
        var drawdown = STATE.startBalance - currentBalance;
        var drawdownPct = STATE.startBalance > 0 ? (drawdown / STATE.startBalance * 100) : 0;
        
        var status;
        if (STATE.isRecoveryMode) {
            var totalLoss = STATE.startBalance - STATE.balance;
            var progress = totalLoss > 0 ? (profit / -totalLoss * 100) : 0;
            if (progress < 0) progress = 0;
            if (progress > 100) progress = 100;
            status = '🔄 MARTINGALE ' + progress.toFixed(0) + '%';
        } else {
            status = '⚡ NORMAL 🎲';
        }
        
        var map = {
            "st-user": STATE.stakeUser,
            "st-running-time": runTime,
            "st-balance": currentBalance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase(),
            "st-profit": (profit >= 0 ? '+' : '') + profit.toFixed(8) + ' (' + (profitPct >= 0 ? '+' : '') + profitPct.toFixed(2) + '%)',
            "st-wagered": STATE.wagered.toFixed(8) + ' (Total: ' + STATE.wagerTotalAccumulated.toFixed(8) + ')',
            "st-bets": STATE.bets + ' | WR ' + winRate.toFixed(0) + '%',
            "st-speed": betSpeed.toFixed(1) + 'b/s',
            "st-chance": status + ' | DD: ' + drawdownPct.toFixed(2) + '%',
            "st-gaphits": drawdown.toFixed(8),
            "st-timer": STATE.isResetting ? '⏰ ' + STATE.resetCountdownRemaining + 's' : '--',
            "st-minbet": STATE.minBet.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + ' (2 IDR)',
            "st-maxdd": STATE.maxDrawdown.toFixed(8),
            "st-maxbet": STATE.maxBet.toFixed(8),
            "st-ddnow": drawdown.toFixed(8)
        };
        
        for (var id in map) {
            var el = document.getElementById(id);
            if (el) el.textContent = map[id];
        }
        
        var profitEl = document.getElementById("st-profit");
        if (profitEl) {
            profitEl.textContent = map["st-profit"];
            profitEl.style.color = profit >= 0 ? '#00A86B' : '#FF4757';
        }
    }

    function updateAllUI() {
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.stats.profit = STATE.profit;
        STATE.stats.currentBal = STATE.balance;
        
        updateStatsDisplay();
        updateRaffleDisplay();
        
        var now = Date.now();
        if (now - STATE.lastTGReport >= CONFIG.tgReportInterval && STATE.bets > 0) {
            STATE.lastTGReport = now;
            sendSessionReport();
        }
    }

    // ==================== 17. SESSION REPORT ====================
    async function sendSessionReport() {
        STATE.profit = STATE.balance - STATE.startBalance;
        
        var profitPct = STATE.startBalance > 0 ? (STATE.profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var status = STATE.isRecoveryMode ? '🔄 MARTINGALE RECOVERY' : '⚡ NORMAL';
        var drawdownPct = STATE.startBalance > 0 ? ((STATE.startBalance - STATE.balance) / STATE.startBalance * 100) : 0;
        var raffleProgress = (STATE.raffle.progress * 100).toFixed(1);
        var raffleTickets = STATE.raffle.userTickets;
        var wageredUSD = STATE.raffle.wageredFromBot;
        
        var r = STATE.recovery;
        var recoveryInfo = '';
        if (STATE.isRecoveryMode) {
            var totalLoss = STATE.startBalance - STATE.balance;
            var progress = totalLoss > 0 ? (STATE.profit / -totalLoss * 100) : 0;
            if (progress < 0) progress = 0;
            if (progress > 100) progress = 100;
            recoveryInfo = '\n🔄 MARTINGALE RECOVERY\n' +
                           '  Progress: ' + progress.toFixed(1) + '%\n' +
                           '  Loss Streak: ' + r.lossStreak + '/' + STATE.recoveryMaxLossStreak + '\n' +
                           '  Win: ' + r.win + ' | Loss: ' + r.loss + '\n' +
                           '  Max Bet: ' + r.maxBet.toFixed(8);
        }
        
        var message = '💰 CHEAPCHEATX v3.0 (DICE ONLY)\n' +
                      'User: ' + STATE.stakeUser + '\n' +
                      'Time: ' + runTime + '\n' +
                      'Balance: ' + STATE.balance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + '\n' +
                      'Profit: ' + (STATE.profit >= 0 ? '+' : '') + STATE.profit.toFixed(8) + ' (' + profitPct.toFixed(2) + '%)\n' +
                      'Wagered: ' + STATE.wagered.toFixed(8) + '\n' +
                      'Bets: ' + STATE.bets + ' | WR: ' + winRate.toFixed(0) + '%\n' +
