    function getDuration() {
        if (!STATE.startTime) return "0s";
        var s = Math.floor((Date.now() - STATE.startTime) / 1000);
        var h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60), sec = s % 60;
        if (h > 0) return h + "h " + m + "m " + sec + "s";
        if (m > 0) return m + "m " + sec + "s";
        return sec + "s";
    }
    
