    }

    // ==================== 15. DUAL RECOVERY SELECTOR ====================
    function selectRecoveryMode() {
        var lossPct = ((STATE.startBalance - STATE.balance) / STATE.startBalance) * 100;
        var dr = STATE.dualRecovery;
        
        if (dr.mlCount >= dr.maxConsecutiveML) {
            console.log('[DUAL] ML count:', dr.mlCount, '-> Switch to Blackjack');
            return 'bj';
        }
        
        if (dr.bjCount >= dr.maxConsecutiveBJ) {
            console.log('[DUAL] BJ count:', dr.bjCount, '-> Switch to ML');
            return 'ml';
        }
        
        if (lossPct < 5) {
            console.log('[DUAL] Loss kecil (' + lossPct.toFixed(1) + '%) -> ML');
            return 'ml';
        }
        
        if (lossPct > 10) {
            console.log('[DUAL] Loss besar (' + lossPct.toFixed(1) + '%) -> Blackjack');
            return 'bj';
        }
        
        var rand = Math.random();
        if (rand < 0.5) {
            console.log('[DUAL] Loss sedang (' + lossPct.toFixed(1) + '%) -> ML (random)');
            return 'ml';
        } else {
            console.log('[DUAL] Loss sedang (' + lossPct.toFixed(1) + '%) -> Blackjack (random)');
            return 'bj';
        }
    }

