    async function fetchUSDRate(currency) {
        try {
            var res = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=' + currency + 'USDT');
            var data = await res.json();
            if (data.price) return parseFloat(data.price);
        } catch(e) {}
        
        try {
            var cgId = getCoinGeckoId(currency);
            var res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=' + cgId + '&vs_currencies=usd');
            var data = await res.json();
            if (data[cgId] && data[cgId].usd) return data[cgId].usd;
        } catch(e) {}
        
        var fallback = {
            'usdt': 1, 'usdc': 1,
            'btc': 65000, 'eth': 3500, 'bnb': 580,
            'sol': 180, 'xrp': 0.48, 'ada': 0.35,
            'doge': 0.12, 'trx': 0.12, 'dot': 4.5,
            'ltc': 72, 'pol': 0.38,
            'idr': 0.000055
        };
        return fallback[currency.toLowerCase()] || 1;
    }

    async function fetchMinBetRate(currency) {
        if (currency.toLowerCase() === 'idr') {
            return 1;
        }
        
        try {
            var cgId = getCoinGeckoId(currency);
            var res = await fetch('https://api.coingecko.com/api/v3/simple/price?ids=' + cgId + '&vs_currencies=idr');
            var data = await res.json();
            if (data[cgId] && data[cgId].idr) {
                return data[cgId].idr;
            }
        } catch(e) {}
        
        try {
            var coinRes = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=' + currency + 'USDT');
            var coinData = await coinRes.json();
            var idrRes = await fetch('https://api.binance.com/api/v3/ticker/price?symbol=USDTIDR');
            var idrData = await idrRes.json();
            if (coinData.price && idrData.price) {
                return parseFloat(coinData.price) * parseFloat(idrData.price);
            }
        } catch(e) {}
        
        var fallbackRates = {
            'usdt': 16000,
            'usdc': 16000,
            'btc': 16000 * 65000,
            'eth': 16000 * 3500,
            'bnb': 16000 * 580,
            'sol': 16000 * 180,
            'xrp': 16000 * 0.48,
            'ada': 16000 * 0.35,
