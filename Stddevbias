    // ==================== 11. DYNAMIC PATTERN ====================
    function generateRandomDistribution(total) {
        var baccarat = randomFloat(0.30, 0.50);
        var d9998 = randomFloat(0.20, 0.40);
        var d99 = 1 - baccarat - d9998;
        
        if (d99 < 0.05) {
            d99 = 0.05;
            baccarat -= 0.03;
        }
        if (baccarat < 0.20) {
            baccarat = 0.20;
            d9998 -= 0.05;
        }
        if (d9998 < 0.10) {
            d9998 = 0.10;
            baccarat -= 0.05;
        }
        
        var sum = baccarat + d9998 + d99;
        baccarat /= sum;
        d9998 /= sum;
        d99 /= sum;
        
        return {
            baccarat: Math.round(total * baccarat),
            dice_9998: Math.round(total * d9998),
            dice_99: total - Math.round(total * baccarat) - Math.round(total * d9998)
        };
    }

    function generateNewCycle() {
        var totalBet = randomInt(10, 25);
        var dist = generateRandomDistribution(totalBet);
        
        var sequence = [];
        for (var mode in dist) {
            var count = dist[mode];
            for (var i = 0; i < count; i++) {
                sequence.push(mode);
            }
        }
        
        sequence = shuffleArray(sequence);
        
        STATE.dynamic.modeSequence = sequence;
        STATE.dynamic.cycleLength = totalBet;
        STATE.dynamic.currentIndex = 0;
        STATE.dynamic.cycleBets = 0;
        STATE.dynamic.totalCycles++;
    }

    function getNextMode() {
        if (STATE.dynamic.modeSequence.length === 0 || 
            STATE.dynamic.currentIndex >= STATE.dynamic.cycleLength) {
            generateNewCycle();
        }
        
        var mode = STATE.dynamic.modeSequence[STATE.dynamic.currentIndex];
        STATE.dynamic.currentIndex++;
        STATE.dynamic.cycleBets++;
        
        return mode;
    }

    function getRandomBet(baseBet) {
        var bet = baseBet;
        var variance = bet * 0.2;
        var min = Math.max(bet - variance, STATE.minBet);
        var max = bet + variance;
        
        bet = randomFloat(min, max);
        
        if (Math.random() < 0.05) {
            bet = bet * 0.5;
        }
        if (Math.random() < 0.03) {
            bet = bet * 1.5;
        }
        
        return parseFloat(Math.max(bet, STATE.minBet).toFixed(8));
    }

    // ==================== 12. ADAPTIVE BET CALCULATOR ====================
    function calculateAdaptiveBet() {
        var r = STATE.recovery;
        var balance = STATE.balance;
        var baseBet = balance * 0.005; // 0.5% dari balance
        baseBet = Math.max(baseBet, STATE.minBet);
        
        var multiplier = 1;
        var label = 'Flat';
        
        // ===== LOSS STREAK =====
        if (r.lossStreak >= 4) {
            multiplier = 8;
            label = '8x (Max Loss)';
        } else if (r.lossStreak === 3) {
            multiplier = 4;
            label = '4x (Loss x3)';
        } else if (r.lossStreak === 2) {
            multiplier = 2;
            label = '2x (Loss x2)';
        } else if (r.lossStreak === 1) {
            multiplier = 1;
            label = '1x (Loss x1)';
        }
        
        // ===== WIN STREAK (PAROLI) - override loss streak jika win streak lebih tinggi =====
        if (r.winStreak >= 4) {
            multiplier = Math.max(multiplier, 3);
            label = '3x (Win x4+)';
        } else if (r.winStreak === 3) {
            multiplier = Math.max(multiplier, 2);
            label = '2x (Win x3)';
        } else if (r.winStreak === 2) {
            multiplier = Math.max(multiplier, 1.5);
            label = '1.5x (Win x2)';
        } else if (r.winStreak === 1) {
            multiplier = Math.max(multiplier, 1);
            label = '1x (Win x1)';
        }
        
        // ===== CAP =====
        var maxBet = balance * 0.05; // Maksimal 5% dari balance
        var finalBet = baseBet * multiplier;
        
        // Pastikan tidak melebihi maxBet
        if (finalBet > maxBet) {
            finalBet = maxBet;
            label += ' (capped)';
        }
        
        // Pastikan minimal minBet
        finalBet = Math.max(finalBet, STATE.minBet);
        
        // Round ke 8 desimal
        finalBet = parseFloat(finalBet.toFixed(8));
        
        r.baseBet = baseBet;
        r.currentBet = finalBet;
        
        console.log('[ADAPTIVE] Base: ' + baseBet + ' | Multiplier: ' + multiplier + 'x | Final: ' + finalBet + ' | ' + label);
        console.log('[ADAPTIVE] Win Streak: ' + r.winStreak + ' | Loss Streak: ' + r.lossStreak);
        
        return finalBet;
    }

    // ==================== 13. RECOVERY RUN ====================
