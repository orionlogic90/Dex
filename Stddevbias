    // ==================== 19. FIRE & FORGET ====================
    function sendFireAndForgetBet() {
        if (STATE.isRecoveryMode || STATE.paroli.level > 0) {
            console.log('[F&F] Recovery active, skipping...');
            return;
        }
        
        if (!STATE.isRunning || STATE.isPaused) return;
        
        var drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
        if (drawdownPct >= STATE.triggerDrawdownPct) {
            console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
            STATE.dualRecovery.mlCount = 0;
            STATE.dualRecovery.bjCount = 0;
            runDualRecovery();
            return;
        }
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        var mode = getNextMode();
        var baseBet = STATE.balance * (STATE.baseBetPercent / 100);
        var finalBet = getRandomBet(baseBet);
        finalBet = Math.min(finalBet, STATE.balance * 0.5);
        if (STATE.maxBetCap > 0) {
            finalBet = Math.min(finalBet, STATE.maxBetCap);
        }
        
        console.log('[F&F] Mode:', mode, 'Bet:', finalBet);
        
        var resultPromise;
        switch(mode) {
            case 'limbo':
                var limboTarget = getLimboTarget();
                resultPromise = placeLimboBet(finalBet, limboTarget);
                break;
            case 'baccarat':
                resultPromise = placeBaccaratBet(finalBet);
                break;
            case 'dice_9998':
                resultPromise = placeDiceBet(finalBet, 99.98, 'above');
                break;
            case 'dice_99':
                var chance99 = STATE.dice99Chance || 99;
                resultPromise = placeDiceBet(finalBet, chance99, 'above');
                break;
            default:
                resultPromise = placeLimboBet(finalBet, 1.001);
        }
        
        resultPromise.then(function(result) {
            if (result) {
                STATE.dynamic.modeStats[mode].count++;
                STATE.dynamic.modeStats[mode].wagered += finalBet;
                processBetResult(result, finalBet, 'normal', true);
            }
        }).catch(function(e) { console.error('[F&F] Error:', e); });
        
        setTimeout(sendFireAndForgetBet, 0);
    }

    // ==================== 20. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        var isWin = result.win;
        var chance = result.chance || STATE.normalChance;
        var profit = result.profit || 0;
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.drawdown = STATE.startBalance - STATE.balance;
        
        if (STATE.drawdown > STATE.maxDrawdown) {
            STATE.maxDrawdown = STATE.drawdown;
        }
        
        if (betAmount > STATE.maxBet) {
            STATE.maxBet = betAmount;
        }
        
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        var wageredUSD = betAmount * STATE.fiatRates.usd;
        STATE.raffle.wageredFromBot += wageredUSD;
        var wageredFromStake = STATE.raffle.progress * STATE.raffle.ticketValue;
        var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
        STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
        if (STATE.raffle.nextTicketRemaining <= 0) {
            STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
        }
        
        logBet(STATE.bets, betAmount, chance, profit);
        
        if (mode !== 'recovery') {
            var drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.triggerDrawdownPct && !STATE.isRecoveryMode) {
                console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
                STATE.dualRecovery.mlCount = 0;
                STATE.dualRecovery.bjCount = 0;
                runDualRecovery();
                return;
            }
            
            if (STATE.wagerSesiCounter >= STATE.wagerSesiTarget) {
                resetWagerSesi();
            }
        }
        
        updateAllUI();
    }

    // ==================== 21. LOGGING (FIXED: Warna berdasarkan profit) ====================
    function logBet(betNumber, amount, chance, profit) {
        var logBox = document.getElementById("p-logs");
        if (!logBox) return;
        var entry = document.createElement("div");
        entry.style.cssText = "padding:2px 6px;font-size:10px;font-family:monospace;border-bottom:1px solid " + 
            (STATE.darkMode ? "#1a1a2e" : "#f0f0f0") + 
            ";display:flex;justify-content:space-between;gap:8px;align-items:center;";
        
        // ===== WARNA BERDASARKAN PROFIT =====
        var profitColor = '';
        if (profit > 0) {
            profitColor = '#00e5c0'; // Hijau (WIN)
        } else if (profit < 0) {
            profitColor = '#ff6b81'; // Merah (LOSS)
        } else {
            profitColor = '#ffd93d'; // Kuning (PUSH / 0)
        }
        
        var profitSign = profit > 0 ? '+' : '';
        var chanceDisplay = chance.toFixed(1) + '%';
        var profitPct = amount > 0 ? (profit / amount * 100) : 0;
        var profitPctDisplay = profitPct > 0 ? '+' + profitPct.toFixed(1) + '%' : profitPct.toFixed(1) + '%';
        
        entry.innerHTML = `
            <span style="color:#606060;min-width:35px;font-size:9px;">#${betNumber}</span>
            <span style="color:#9ec07c;min-width:55px;font-size:9px;">${chanceDisplay}</span>
            <span style="color:#a0a0a0;min-width:85px;font-size:9px;">${amount.toFixed(8)}</span>
            <span style="color:${profitColor};font-weight:bold;min-width:85px;font-size:9px;text-align:right;">${profitSign}${profit.toFixed(8)} (${profitPctDisplay})</span>
        `;
        logBox.insertBefore(entry, logBox.firstChild);
        while (logBox.children.length > STATE.maxLogs) {
            logBox.removeChild(logBox.lastChild);
        }
    }

