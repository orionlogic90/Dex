    // ==================== 20. SESSION REPORT ====================
    async function sendSessionReport() {
        STATE.profit = STATE.balance - STATE.startBalance;
        
        var profitPct = STATE.startBalance > 0 ? (STATE.profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var status = STATE.isRecoveryMode ? '🔄 ADAPTIVE RECOVERY' : '⚡ NORMAL';
        var drawdownPct = STATE.startBalance > 0 ? ((STATE.startBalance - STATE.balance) / STATE.startBalance * 100) : 0;
        var raffleProgress = (STATE.raffle.progress * 100).toFixed(1);
        var raffleTickets = STATE.raffle.userTickets;
        var wageredUSD = STATE.raffle.wageredFromBot;
        
        var r = STATE.recovery;
        var recoveryInfo = '';
        if (STATE.isRecoveryMode) {
            recoveryInfo = '\n🔄 ADAPTIVE RECOVERY 125%\n' +
                           '  Target: ' + r.targetRecovery.toFixed(8) + '\n' +
                           '  Recovered: ' + r.recoveredAmount.toFixed(8) + '\n' +
                           '  Progress: ' + (r.targetRecovery > 0 ? (r.recoveredAmount / r.targetRecovery * 100).toFixed(1) : 0) + '%\n' +
                           '  Win: ' + r.win + ' | Loss: ' + r.loss + '\n' +
                           '  Win Streak: ' + r.winStreak + ' | Loss Streak: ' + r.lossStreak + '\n' +
                           '  Max Bet: ' + r.maxBet.toFixed(8);
        }
        
        var modeStats = STATE.dynamic.modeStats;
        var totalMode = modeStats.baccarat.count + modeStats.dice_9998.count + modeStats.dice_99.count;
        var modeDisplay = '';
        if (totalMode > 0) {
            modeDisplay = '\n📊 MODE STATS\n' +
                         '  Baccarat: ' + modeStats.baccarat.count + ' (' + (modeStats.baccarat.count/totalMode*100).toFixed(1) + '%)\n' +
                         '  Dice 99.98%: ' + modeStats.dice_9998.count + ' (' + (modeStats.dice_9998.count/totalMode*100).toFixed(1) + '%)\n' +
                         '  Dice 99%: ' + modeStats.dice_99.count + ' (' + (modeStats.dice_99.count/totalMode*100).toFixed(1) + '%)';
        }
        
        var message = '💰 CHEAPCHEATX v3.0 (ADAPTIVE RECOVERY 125%)\n' +
                      'User: ' + STATE.stakeUser + '\n' +
                      'Time: ' + runTime + '\n' +
