                    STATE.paroli.totalLoss += betAmount;
                    STATE.paroli.currentChance = Math.max(STATE.paroli.currentChance - STATE.paroli.incrementPerWin, STATE.paroli.minChance);
                    STATE.paroli.currentBet = STATE.paroli.unit * Math.pow(2, STATE.paroli.level - 1);
                    if (STATE.paroli.currentBet < STATE.minBet) STATE.paroli.currentBet = STATE.minBet;
                    STATE.paroli.currentCondition = STATE.paroli.level % 2 === 0 ? 'below' : 'above';
                } else {
                    STATE.paroli.totalLoss -= betAmount;
                    STATE.paroli.level = 1;
                    STATE.paroli.currentBet = STATE.paroli.unit;
                    if (STATE.paroli.currentBet < STATE.minBet) STATE.paroli.currentBet = STATE.minBet;
                    STATE.paroli.currentChance = STATE.paroli.baseChanceMax;
                    STATE.paroli.currentCondition = 'above';
                }
                
                if (STATE.paroli.level > STATE.paroli.maxLevel) {
                    STATE.isRecoveryMode = false;
                    STATE.paroli.level = 0;
                    STATE.paroli.mlActive = false;
                    resetProfitOnNormalReturn();
                    sendTelegramMessage('✅ PAROLI RECOVERY 75% SUCCESS!\nBack to Normal');
                    updateAllUI();
                    setTimeout(sendFireAndForgetBet, 0);
                    return;
                }
                
                updateAllUI();
                setTimeout(runRecoverySequentialWithML, 0);
                
            } else {
                console.log('[ML] Bet returned null, retrying...');
                p.isProcessing = false;
                setTimeout(runRecoverySequentialWithML, 0);
            }
            
        } catch(e) {
            console.error('[ML] Error:', e);
            p.isProcessing = false;
            setTimeout(runRecoverySequentialWithML, 0);
        }
    }

    // ==================== 14. START RECOVERY WITH ML 75% ====================
    function startRecoveryWithML() {
        console.log('[ML] startRecoveryWithML called (75%)');
        
        if (STATE.balance <= STATE.minBet * 2) {
            STATE.isRecoveryMode = false;
            sendTelegramMessage('⚠️ BALANCE TOO LOW! Cannot start recovery.');
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        var basebet = STATE.balance * (STATE.baseBetPercent / 100);
        if (basebet < STATE.minBet) basebet = STATE.minBet;
        
        var p = STATE.paroli;
        var totalLoss = STATE.startBalance - STATE.balance;
        
        if (totalLoss <= 0) {
            STATE.isRecoveryMode = false;
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        if (!STATE.mlSystem) {
            STATE.mlSystem = new MLRecoverySystem();
        }
        
        const mlAction = STATE.mlSystem.startRecovery(
            totalLoss,
            STATE.balance,
            STATE.minBet,
            STATE.maxBetCap || STATE.balance * 0.2
        );
        
        if (!mlAction) {
            p.level = 1;
            p.unit = basebet;
            p.currentBet = Math.max(p.unit, STATE.minBet);
            p.currentChance = Math.min(p.baseChanceMax, 99.98);
            p.currentCondition = 'above';
            p.isProcessing = false;
            p.recoveryCount++;
            STATE.isRecoveryMode = true;
            updateAllUI();
            setTimeout(runRecoverySequentialWithML, 0);
            return;
        }
        
        p.level = 1;
        p.unit = Math.max(mlAction.betAmount, STATE.minBet);
        p.currentBet = p.unit;
        p.currentChance = Math.min(mlAction.chance, 99.98);
        p.currentCondition = mlAction.condition || 'above';
        p.isProcessing = false;
        p.recoveryCount++;
        p.mlActive = true;
        p.targetRecovery = totalLoss * 0.75;
        p.recoveredAmount = 0;
        
        STATE.isRecoveryMode = true;
        
        const status = STATE.mlSystem.getStatus();
        sendTelegramMessage('🤖 ML RECOVERY 75% STARTED (DRIBBLE)\n' +
            'Total Loss: ' + totalLoss.toFixed(8) + '\n' +
            'Target (75%): ' + status.targetRecovery.toFixed(8) + '\n' +
            'Bet: ' + p.currentBet.toFixed(8) + '\n' +
            'Chance: ' + p.currentChance.toFixed(1) + '%\n' +
            '📊 Dribble mode: akumulasi profit sampai target');
        
        updateAllUI();
        setTimeout(runRecoverySequentialWithML, 0);
    }

    // ==================== 15. FIRE & FORGET WITH DYNAMIC PATTERN ====================
    function sendFireAndForgetBet() {
        if (STATE.isRecoveryMode || STATE.paroli.level > 0) {
            console.log('[F&F] Recovery active, skipping...');
            return;
        }
        
        if (!STATE.isRunning || STATE.isPaused) return;
        
        var drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
        if (drawdownPct >= STATE.triggerDrawdownPct) {
            console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
            startRecoveryWithML();
            return;
        }
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        const mode = getNextMode();
        const baseBet = STATE.balance * (STATE.baseBetPercent / 100);
        let finalBet = getRandomBet(baseBet);
        finalBet = Math.min(finalBet, STATE.balance * 0.5);
        if (STATE.maxBetCap > 0) {
            finalBet = Math.min(finalBet, STATE.maxBetCap);
        }
        
        console.log('[F&F] Mode:', mode, 'Bet:', finalBet);
        
        let resultPromise;
        switch(mode) {
            case 'dice_9998':
                resultPromise = placeDiceBet(finalBet, 99.98, 'above');
                break;
            case 'dice_99':
                var chance99 = STATE.dice99Chance || 99;
                resultPromise = placeDiceBet(finalBet, chance99, 'above');
                break;
            case 'baccarat':
                resultPromise = placeBaccaratBet(finalBet);
                break;
            default:
                resultPromise = placeDiceBet(finalBet, 99.98, 'above');
        }
        
        resultPromise.then(function(result) {
            if (result) {
                STATE.dynamic.modeStats[mode].count++;
                STATE.dynamic.modeStats[mode].wagered += finalBet;
                processBetResult(result, finalBet, 'normal', true);
            }
        }).catch(function(e) { console.error('[F&F] Error:', e); });
        
        setTimeout(sendFireAndForgetBet, 0);
    }

    // ==================== 16. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        var isWin = result.win;
        var chance = result.chance || STATE.normalChance;
        var profit = result.profit || (isWin ? betAmount : -betAmount);
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.drawdown = STATE.startBalance - STATE.balance;
        
        if (STATE.drawdown > STATE.maxDrawdown) {
            STATE.maxDrawdown = STATE.drawdown;
        }
        
        if (betAmount > STATE.maxBet) {
            STATE.maxBet = betAmount;
        }
        
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        var wageredUSD = betAmount * STATE.fiatRates.usd;
        STATE.raffle.wageredFromBot += wageredUSD;
        var wageredFromStake = STATE.raffle.progress * STATE.raffle.ticketValue;
        var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
        STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
        if (STATE.raffle.nextTicketRemaining <= 0) {
            STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
        }
        
        logBet(STATE.bets, betAmount, chance, profit);
        
        if (mode !== 'recovery') {
            var drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.triggerDrawdownPct && !STATE.isRecoveryMode) {
                console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
                startRecoveryWithML();
                return;
            }
            
            if (STATE.wagerSesiCounter >= STATE.wagerSesiTarget) {
                resetWagerSesi();
            }
        }
        
        updateAllUI();
    }

