                STATE.dice99Chance = safeFloat('p-dice-99-chance', 99);
                updateAllUI();
            };
        }
        
        var startBtn = document.getElementById("p-start");
        if (startBtn) {
            startBtn.onclick = async function() {
                if (STATE.isPaused) {
                    STATE.isPaused = false;
                    STATE.isRunning = true;
                    toggleStartStop(true);
                    runLoop();
                    return;
                }
                if (STATE.isRunning) return;
                
                fullReset();
                
                STATE.dice99Chance = safeFloat('p-dice-99-chance', 99);
                STATE.baccaratMode = document.getElementById('p-baccarat-mode')?.value || 'both';
                STATE.baccaratBetMultiplier = parseFloat(document.getElementById('p-baccarat-bet-size')?.value || '1');
                STATE.baseBetPercent = safeFloat("p-basebet-normal", 0.125);
                STATE.maxDrawdownPct = safeFloat("p-max-drawdown", 5);
                STATE.triggerDrawdownPct = safeFloat("p-trigger-drawdown", 0.5);
                STATE.targetPct = safeFloat("p-target-pct", 5);
                STATE.stopLossPct = safeFloat("p-stop-pct", 100);
                STATE.maxBetCap = safeFloat("p-max-cap", 0);
                STATE.delayNormal = safeInt("p-delay-normal", 0);
                STATE.delayRecovery = safeInt("p-delay-recovery", 0);
                
                var recoveryTargetPct = safeFloat("p-recovery-target", 125);
                
                var targetUSD = safeFloat("p-wager-total-target-usd", 1000);
                var lossPct = safeFloat("p-wager-loss-tolerance-pct", 0.5);
                
                var tokenEl = document.getElementById("p-token");
                if (!tokenEl || tokenEl.value.trim().length < 30) {
                    sendTelegramMessage('⚠️ Token diperlukan!');
                    alert('⚠️ Masukkan API Token terlebih dahulu!');
                    return;
                }
                accessToken = tokenEl.value.trim();
                localStorage.setItem('apitoken', accessToken);
                
                await syncUserInfo();
                await updateMinBet();
                var balance = STATE.balance;
                
                if (!balance || balance === 0) {
                    sendTelegramMessage('❌ Balance 0! Check your wallet.');
                    return;
                }
                
                STATE.startBalance = balance;
                STATE.balance = balance;
                STATE.peakBalanceEver = balance;
                STATE.wagerTotalTarget = targetUSD;
                STATE.wagerLossTolerance = (lossPct / 100) * balance;
                STATE.wagerSesiStartBal = balance;
                STATE.wagerTotalAccumulated = 0;
                STATE.wagerSesiCounter = 0;
                STATE.wagerStop = false;
                STATE.wagerWaitingForTrigger = false;
                STATE.lossStreak = 0;
                STATE.drawdown = 0;
                STATE.maxDrawdown = 0;
                STATE.maxBet = 0;
                STATE.isRecoveryMode = false;
                STATE.raffle.wageredFromBot = 0;
                
                STATE.recovery.isActive = false;
                STATE.recovery.totalLoss = 0;
                STATE.recovery.targetRecovery = 0;
                STATE.recovery.recoveredAmount = 0;
                STATE.recovery.win = 0;
                STATE.recovery.loss = 0;
                STATE.recovery.totalBets = 0;
                STATE.recovery.winStreak = 0;
                STATE.recovery.lossStreak = 0;
                STATE.recovery.maxBet = 0;
                
                STATE.stats = {
                    profit: 0, wagered: 0, startBal: balance, currentBal: balance,
                    bets: 0, wins: 0, loss: 0, startTime: Date.now(),
                    maxDD: 0, maxBet: 0, maxDrawdownPct: 0, peakBalance: balance
                };
                
                STATE.startTime = Date.now();
                STATE.sessionStartTime = new Date();
                STATE.lastTGReport = Date.now();
                STATE.isRunning = true;
                STATE.isPaused = false;
                STATE.betTimestamps = [];
                
                STATE.dynamic.modeSequence = [];
                STATE.dynamic.currentIndex = 0;
                STATE.dynamic.cycleBets = 0;
                STATE.dynamic.totalCycles = 0;
                STATE.dynamic.modeStats = {
                    baccarat: { count: 0, wagered: 0 },
                    dice_9998: { count: 0, wagered: 0 },
                    dice_99: { count: 0, wagered: 0 }
                };
                
                await fetchRaffleProgress();
                
                toggleStartStop(true);
                updateAllUI();
                
                sendTelegramMessage('💰 CHEAPCHEATX v3.0 STARTED\n' +
                    'Mode: Dynamic Pattern (Baccarat 2 Sisi, Dice 99.98%, Dice 99%)\n' +
                    'Recovery: Adaptive Baccarat Player Only\n' +
                    'Target: ' + recoveryTargetPct + '% dari loss\n' +
                    'Balance: ' + balance.toFixed(8) + '\n' +
                    'MinBet: ' + STATE.minBet.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + '\n' +
                    'Trigger: Drawdown > ' + STATE.triggerDrawdownPct + '%\n' +
                    '🎟️ Raffle: Tracking progress');
                
                runLoop();
            };
        }
        
        var pauseBtn = document.getElementById("p-pause");
        if (pauseBtn) {
            pauseBtn.onclick = function() {
                if (STATE.isRunning && !STATE.isPaused) {
                    STATE.isPaused = true;
                    STATE.isRunning = false;
                    var pauseBtn2 = document.getElementById("p-pause");
                    var startBtn2 = document.getElementById("p-start");
                    if (pauseBtn2) { pauseBtn2.textContent = "PAUSED"; pauseBtn2.style.background = "#ff922b"; }
                    if (startBtn2) { startBtn2.disabled = false; startBtn2.textContent = "RESUME"; }
                }
            };
        }
        
        var stopBtn = document.getElementById("p-stop");
        if (stopBtn) {
            stopBtn.onclick = function() {
                fullReset();
                sendTelegramMessage('🛑 BOT STOPPED');
            };
        }
        
        var resetBtn = document.getElementById("p-reset");
        if (resetBtn) {
            resetBtn.onclick = function() {
                if (STATE.isRunning) return;
                fullReset();
            };
        }
        
        var triggerEl = document.getElementById("p-trigger-drawdown");
        if (triggerEl) {
            triggerEl.onchange = function() {
                STATE.triggerDrawdownPct = safeFloat("p-trigger-drawdown", 0.5);
                updateAllUI();
            };
        }
        
        var maxDrawdownEl = document.getElementById("p-max-drawdown");
        if (maxDrawdownEl) {
            maxDrawdownEl.onchange = function() {
                STATE.maxDrawdownPct = safeFloat("p-max-drawdown", 5);
                updateAllUI();
            };
        }
        
        var targetUsdEl = document.getElementById("p-wager-total-target-usd");
        if (targetUsdEl) targetUsdEl.oninput = updateAllUI;
        
        var recoveryTargetEl = document.getElementById("p-recovery-target");
        if (recoveryTargetEl) {
            recoveryTargetEl.onchange = function() {
                var val = safeFloat("p-recovery-target", 125);
            };
        }
        
        var lossToleranceEl = document.getElementById("p-wager-loss-tolerance-pct");
        if (lossToleranceEl) {
            lossToleranceEl.oninput = function() {
                var pct = safeFloat("p-wager-loss-tolerance-pct", 0.5);
                var currentBalance = STATE.balance || STATE.startBalance || 0;
                STATE.wagerLossTolerance = (pct / 100) * currentBalance;
                var el = document.getElementById("loss-tolerance-display");
                if (el) el.textContent = pct + '% (≈ ' + STATE.wagerLossTolerance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + ')';
            };
        }
        
        window.openTab = function(tabName) {
            document.querySelectorAll('.tab-content').forEach(function(t) { t.classList.remove('active'); });
            var target = document.getElementById('tab-' + tabName);
            if (target) target.classList.add('active');
            document.querySelectorAll('.tab-btn').forEach(function(b) { b.classList.remove('active'); });
            if (event && event.currentTarget) event.currentTarget.classList.add('active');
        };
        
        var pos1 = 0, pos2 = 0, pos3 = 0, pos4 = 0;
        function dragMouseDown(e) {
            if (e.target.closest && (e.target.closest('button') || e.target.closest('input') || e.target.closest('select'))) return;
            e = e || window.event;
            e.preventDefault();
            pos3 = e.clientX;
            pos4 = e.clientY;
            document.onmouseup = closeDragElement;
            document.onmousemove = elementDrag;
        }
        function elementDrag(e) {
            var el = document.getElementById("BotConsole");
            e = e || window.event;
            e.preventDefault();
            pos1 = pos3 - e.clientX;
            pos2 = pos4 - e.clientY;
            pos3 = e.clientX;
            pos4 = e.clientY;
            var newTop = el.offsetTop - pos2;
            var newLeft = el.offsetLeft - pos1;
            var maxLeft = window.innerWidth - el.offsetWidth;
            var maxTop = window.innerHeight - el.offsetHeight;
            if (newLeft < 0) newLeft = 0;
            if (newTop < 0) newTop = 0;
            if (newLeft > maxLeft) newLeft = maxLeft;
            if (newTop > maxTop) newTop = maxTop;
            el.style.top = newTop + "px";
            el.style.left = newLeft + "px";
            el.style.right = "auto";
        }
        function closeDragElement() { document.onmouseup = null; document.onmousemove = null; }
        
        var saved = localStorage.getItem('apitoken');
        if (saved) {
            accessToken = saved;
            var tokenInput = document.getElementById("p-token");
            if (tokenInput) tokenInput.value = saved;
            syncUserInfo().then(function() {
                fetchRaffleProgress();
                updateMinBet();
                updateAllUI();
            });
        }
        
        updateAllUI();
        
        setInterval(updateAllUI, 500);
        setInterval(function() {
            if (accessToken) {
                fetchRaffleProgress();
            }
        }, 60000);
    }

    // ==================== 24. START ====================
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createUI);
    } else {
        createUI();
    }
})();
