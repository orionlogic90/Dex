    // ==================== 8. PLACE DICE BET (FIXED: 99/chance) ====================
    async function placeDiceBet(amount, chance, condition) {
        var target = condition === 'above' ? (100 - chance) : chance;
        var apiAmount = parseFloat(amount.toFixed(8));
        
        try {
            var payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                target: target,
                condition: condition || "above",
                identifier: generateId()
            };
            
            var res = await fetch(CONFIG.apiUrl + '/casino/dice/roll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.diceRoll) {
                return null;
            }
            
            var d = data.diceRoll;
            
            // ===== PAYOUT MULTIPLIER = 99 / CHANCE =====
            var expectedPayoutMultiplier = 99 / chance;
            var actualPayoutMultiplier = parseFloat(d.payoutMultiplier) || expectedPayoutMultiplier;
            var payout = parseFloat(d.payout) || 0;
            var winAmount = parseFloat(d.amount) || apiAmount;
            
            // ===== CEK WIN =====
            var win = false;
            if (d.win !== undefined) {
                win = d.win;
            } else {
                var state = d.state;
                if (state && state.result !== undefined && state.target !== undefined) {
                    win = state.condition === "above" ? state.result > state.target : state.result < state.target;
                }
            }
            
            // ===== HITUNG PROFIT =====
            var profitAmount = 0;
            if (win) {
                // Profit = (99/chance - 1) * amount
                var profitMultiplier = (99 / chance) - 1;
                profitAmount = profitMultiplier * winAmount;
            } else {
                profitAmount = -winAmount;
            }
            
            // ===== UPDATE BALANCE =====
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance += profitAmount;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            // ===== UPDATE PROFIT =====
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.stats.profit = STATE.profit;
            STATE.stats.currentBal = STATE.balance;
            
            console.log(`[DICE] ${win ? 'WIN' : 'LOSS'} | Chance: ${chance}% | Multiplier: ${(99/chance).toFixed(4)}x | Profit: ${profitAmount.toFixed(8)}`);
            
            updateAllUI();
            
            return {
                win: win,
                payout: payout,
                payoutMultiplier: actualPayoutMultiplier,
                amount: winAmount,
                state: d.state,
                result: win ? 'win' : 'loss',
                game: 'dice',
                chance: chance,
                profit: profitAmount,
                expectedMultiplier: 99 / chance
            };
            
        } catch (error) {
            console.error('[DICE] Exception:', error);
            return null;
        }
    }

    // ==================== 9. PLACE BACCARAT BET (FIXED: 2 Sisi) ====================
    async function placeBaccaratBet(amount) {
        var mode = STATE.baccaratMode || 'both';
        var multiplier = STATE.baccaratBetMultiplier || 1;
        var betAmount = amount * multiplier;
        var halfBet = betAmount / 2;
        
        try {
            var payload = {
                currency: STATE.selectedCurrency,
                identifier: generateId(),
                tie: 0,
                player: 0,
                banker: 0
            };
            
            switch(mode) {
                case 'both':
                    payload.player = parseFloat(halfBet.toFixed(8));
                    payload.banker = parseFloat(halfBet.toFixed(8));
                    break;
                case 'player':
                    payload.player = parseFloat(betAmount.toFixed(8));
                    break;
                case 'banker':
                    payload.banker = parseFloat(betAmount.toFixed(8));
                    break;
                default:
                    payload.player = parseFloat(halfBet.toFixed(8));
                    payload.banker = parseFloat(halfBet.toFixed(8));
            }
            
            var res = await fetch(CONFIG.apiUrl + '/casino/baccarat/bet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.baccaratBet) {
                return null;
            }
            
            var d = data.baccaratBet;
            var result = d.state?.result || 'tie';
            var isWin = false;
            var profit = 0;
            var payoutMultiplier = 0;
            
            // ===== PERHITUNGAN PROFIT BACCARAT =====
            if (mode === 'both') {
                // Bet 2 sisi: Player 0.5, Banker 0.5
                if (result === 'player') {
                    // Player win: player bet 0.5 * 1 = 0.5 (balik modal)
                    // Banker bet 0.5 loss
                    // Total: 0.5 - 0.5 = 0
                    isWin = true;
                    profit = 0;
                    payoutMultiplier = 1;
                } else if (result === 'banker') {
                    // Banker win: banker bet 0.5 * 0.95 = 0.475
                    // Player bet 0.5 loss
                    // Total: 0.475 - 0.5 = -0.025 (minus 2.5%)
                    isWin = false;
                    profit = -betAmount * 0.025;
                    payoutMultiplier = 0.95;
                } else {
                    // Tie: semua loss
                    isWin = false;
                    profit = -betAmount;
                    payoutMultiplier = 0;
                }
            } else if (mode === 'player') {
                if (result === 'player') {
                    isWin = true;
                    profit = betAmount * 1.0;
                    payoutMultiplier = 1.0;
                } else {
                    isWin = false;
                    profit = -betAmount;
                    payoutMultiplier = 0;
                }
            } else if (mode === 'banker') {
                if (result === 'banker') {
                    isWin = true;
                    profit = betAmount * 0.95;
                    payoutMultiplier = 0.95;
                } else {
                    isWin = false;
                    profit = -betAmount;
                    payoutMultiplier = 0;
                }
            }
            
            // ===== UPDATE BALANCE =====
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance += profit;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            // ===== UPDATE PROFIT =====
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.stats.profit = STATE.profit;
            STATE.stats.currentBal = STATE.balance;
            
            var winStatus = isWin ? 'WIN' : 'LOSS';
            var resultLabel = result === 'player' ? 'Player' : result === 'banker' ? 'Banker' : 'Tie';
            console.log(`[BACCARAT] ${winStatus} | Result: ${resultLabel} | Bet: ${betAmount} | Profit: ${profit.toFixed(8)}`);
            
            updateAllUI();
            
            return {
                win: isWin,
                result: result,
                profit: profit,
                amount: betAmount,
                game: 'baccarat',
                payoutMultiplier: payoutMultiplier,
                mode: mode,
                profitPct: betAmount > 0 ? (profit / betAmount * 100) : 0
            };
            
        } catch (error) {
            console.error('[BACCARAT] Exception:', error);
            return null;
        }
    }

    // ==================== 10. DYNAMIC PATTERN SYSTEM ====================
    function generateRandomDistribution(total) {
        let d9998 = randomFloat(0.30, 0.70);
        let d99 = randomFloat(0.10, 0.40);
        let baccarat = 1 - d9998 - d99;
        
        if (baccarat < 0.10) {
            baccarat = 0.10;
            d9998 -= 0.05;
            d99 -= 0.05;
        }
        if (baccarat > 0.35) {
            baccarat = 0.35;
            d9998 += 0.15;
        }
        
        const sum = d9998 + d99 + baccarat;
        d9998 /= sum;
        d99 /= sum;
        baccarat /= sum;
        
        return {
            dice_9998: Math.round(total * d9998),
            dice_99: Math.round(total * d99),
            baccarat: total - Math.round(total * d9998) - Math.round(total * d99)
        };
    }

    function generateNewCycle() {
        const totalBet = randomInt(10, 25);
        const dist = generateRandomDistribution(totalBet);
        
        let sequence = [];
        for (const [mode, count] of Object.entries(dist)) {
            for (let i = 0; i < count; i++) {
                sequence.push(mode);
            }
        }
        
        sequence = shuffleArray(sequence);
        
        STATE.dynamic.modeSequence = sequence;
        STATE.dynamic.cycleLength = totalBet;
        STATE.dynamic.currentIndex = 0;
        STATE.dynamic.cycleBets = 0;
        STATE.dynamic.totalCycles++;
    }

    function getNextMode() {
        if (STATE.dynamic.modeSequence.length === 0 || 
            STATE.dynamic.currentIndex >= STATE.dynamic.cycleLength) {
            generateNewCycle();
        }
        
        const mode = STATE.dynamic.modeSequence[STATE.dynamic.currentIndex];
        STATE.dynamic.currentIndex++;
        STATE.dynamic.cycleBets++;
        
        return mode;
    }

    function getRandomBet(baseBet) {
        let bet = baseBet;
        const variance = bet * 0.2;
        const min = Math.max(bet - variance, STATE.minBet);
        const max = bet + variance;
        
        bet = randomFloat(min, max);
        
        if (Math.random() < 0.05) {
            bet = bet * 0.5;
        }
        if (Math.random() < 0.03) {
            bet = bet * 1.5;
        }
        
        return parseFloat(Math.max(bet, STATE.minBet).toFixed(8));
    }

