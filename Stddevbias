            <span style="color:${profitColor};font-weight:bold;min-width:85px;font-size:9px;text-align:right;">${profitSign}${profit.toFixed(8)} (${profitPctDisplay})</span>
        `;
        logBox.insertBefore(entry, logBox.firstChild);
        while (logBox.children.length > STATE.maxLogs) {
            logBox.removeChild(logBox.lastChild);
        }
    }

