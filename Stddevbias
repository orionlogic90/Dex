            updateAllUI();
            setTimeout(sendFireAndForgetBet, 0);
            return;
        }
        
        // Hitung adaptive bet
        var flatBet = calculateAdaptiveBet();
        
        // Place Baccarat Player bet
        var result = await placeBaccaratPlayerBet(flatBet);
        
        if (result) {
            // Update stats
            STATE.bets++;
            STATE.wagered += flatBet;
            STATE.betTimestamps.push(Date.now());
            if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
            
            if (result.win) {
                STATE.wins++;
                STATE.lossStreak = 0;
                r.win++;
                r.winStreak++;
                r.lossStreak = 0;
                r.recoveredAmount += result.profit;
                
                if (flatBet > r.maxBet) r.maxBet = flatBet;
            } else {
                STATE.losses++;
                STATE.lossStreak++;
                r.loss++;
                r.lossStreak++;
                r.winStreak = 0;
            }
            
            STATE.profit = STATE.balance - STATE.startBalance;
            STATE.drawdown = STATE.startBalance - STATE.balance;
