            var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
            STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
            if (STATE.raffle.nextTicketRemaining <= 0) STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
            
            var chanceDisplay = 'Player ' + (result.win ? 'WIN' : 'LOSS') + ' [S:' + r.winStreak + '/' + r.lossStreak + ']';
            logBet(STATE.bets, flatBet, chanceDisplay, result.profit);
            
            // Cek target lagi
            var newTotalLoss = STATE.startBalance - STATE.balance;
            var newTarget = newTotalLoss * 1.25;
            
            if (r.recoveredAmount >= newTarget && newTarget > 0) {
                STATE.isRecoveryMode = false;
                var profit2 = STATE.balance - STATE.startBalance;
                resetRecoveryState();
                sendTelegramMessage('✅ ADAPTIVE RECOVERY 125% SUCCESS!\n' +
                    'Loss: ' + newTotalLoss.toFixed(8) + '\n' +
                    'Target: ' + newTarget.toFixed(8) + '\n' +
