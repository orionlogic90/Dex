    async function joinRain(potId) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'JoinRain',
                    query: `
                        mutation JoinRain($potId: ID!) {
                            joinRain(potId: $potId) {
                                joined
                                alreadyJoined
                                ineligibleReason
                                __typename
                            }
                        }
                    `,
                    variables: { potId }
                })
            });

            if (!response.ok) throw new Error('HTTP ' + response.status);
            
            const data = await response.json();
            if (data.errors) throw new Error(data.errors[0].message);
            
            const result = data?.data?.joinRain;
            
            if (result?.ineligibleReason === 'InsufficientEntries') {
                return { 
                    success: false, 
                    reason: 'InsufficientEntries',
                    needWager: 33.33 - (rainState.wagered || 0)
                };
            }

            return { 
                success: result?.joined || false, 
                joined: result?.joined || false,
                alreadyJoined: result?.alreadyJoined || false,
                reason: result?.ineligibleReason || null
            };

        } catch(e) {
            return { success: false, error: e.message };
        }
    }

    async function autoWagerForRainEntries(neededAmount) {
        const betAmount = 0.01;
        const chance = 98;
        
        addLog('[RAIN] 🔄 Auto wagering $' + neededAmount.toFixed(2) + ' for entry...', '#60a5fa', '[R]');
        
        let wagered = 0;
        let attempts = 0;
        const maxAttempts = 500;
        
        while (wagered < neededAmount && attempts < maxAttempts) {
            attempts++;
            
            let currentBet = betAmount;
            const remaining = neededAmount - wagered;
            if (remaining < 1) {
                currentBet = Math.min(remaining, 0.01);
            }
            
            const result = await placeBetWithRetry(currentBet, chance);
            
            if (result.success) {
                wagered += currentBet;
                rainState.wagered += currentBet;
                
                if (attempts % 10 === 0) {
                    const pct = ((wagered / neededAmount) * 100).toFixed(1);
                    addLog('[RAIN] 📊 ' + wagered.toFixed(2) + '/' + neededAmount.toFixed(2) + ' (' + pct + '%)', '#ffd700', '[R]');
                }
            }
            
            await sleep(100 + Math.random() * 200);
        }
        
        const success = wagered >= neededAmount;
        if (success) {
            addLog('[RAIN] ✅ Entry achieved! Wagered: $' + wagered.toFixed(2), '#4ade80', '[R]');
        } else {
            addLog('[RAIN] ❌ Failed to get entry', '#ff6b6b', '[R]');
        }
        
        return success;
    }

    async function checkRainPayout() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'UserActivities',
                    query: `
                        query UserActivities($filters: UserActivityFilters, $first: Int) {
                            userActivities(filters: $filters, first: $first) {
                                edges {
                                    node {
                                        id
                                        type
                                        status
                                        time
                                        usdAmount
                                    }
                                }
                            }
                        }
                    `,
                    variables: {
                        filters: { category: "REWARDS" },
                        first: 5
                    }
                })
            });

            const data = await response.json();
            const activities = data?.data?.userActivities?.edges || [];

            const now = Date.now();
            const fiveMinutesAgo = now - (5 * 60 * 1000);

            for (let edge of activities) {
                const node = edge.node;
                if (node.type === 'RAIN_PAYOUT' && node.status === 'FINALIZED') {
                    const payoutTime = new Date(node.time).getTime();
                    if (payoutTime > fiveMinutesAgo) {
                        const amount = parseFloat(node.usdAmount);
                        addLog('🎉 YOU WON! +$' + amount.toFixed(2) + ' USD from rain!', '#ffd700', '[WIN]');
                        rainState.lastWin = { amount: amount, time: node.time };
                        updateRainUI(null);
                        return { win: true, amount: amount };
                    }
                }
            }
            
            return { win: false };

        } catch(e) {
            return { win: false, error: e.message };
        }
    }

    async function rainLoop() {
        if (!rainState.isRunning) return;
        
        try {
            const rain = await fetchRainSchedule();
            if (!rain) {
                setTimeout(rainLoop, RAIN_CONFIG.CHECK_INTERVAL);
                return;
            }
            
            const now = new Date();
            const startsAt = new Date(rain.startsAt);
            const settlesAt = new Date(rain.settlesAt);
            const potId = rain.id;
            
            updateRainUI(rain);
            
            const isActive = rain.status === 'Active' && now >= startsAt && now <= settlesAt;
            const isSettled = rain.status === 'Settled' || now > settlesAt;
            
            if (isSettled) {
                if (!rainState.joinedRains.has(potId)) {
                    await checkRainPayout();
                }
                setTimeout(rainLoop, 60000);
                return;
            }
            
            if (isActive) {
                if (rainState.joinedRains.has(potId)) {
                    setTimeout(rainLoop, 5000);
                    return;
                }
                
                const currentWagered = rainState.wagered || 0;
                const entries = Math.floor(currentWagered / RAIN_CONFIG.MIN_WAGER_FOR_ENTRY);
                const maxEntries = Math.min(entries, RAIN_CONFIG.MAX_ENTRIES);
                
                if (entries === 0) {
                    addLog('[RAIN] ⚠️ No entries! Auto wagering...', '#ff922b', '[R]');
                    const success = await autoWagerForRainEntries(RAIN_CONFIG.MIN_WAGER_FOR_ENTRY);
                    if (!success) {
                        setTimeout(rainLoop, 5000);
                        return;
                    }
                }
                
                addLog('[RAIN] 🔄 Joining rain...', '#60a5fa', '[R]');
                const joinResult = await joinRain(potId);
                
                if (joinResult.success || joinResult.alreadyJoined) {
                    rainState.joinedRains.add(potId);
                    addLog('[RAIN] ✅ Joined! (' + maxEntries + '/3 entries)', '#4ade80', '[R]');
                } else if (joinResult.reason === 'InsufficientEntries') {
                    addLog('[RAIN] 🔄 Insufficient entries, retrying...', '#ff922b', '[R]');
                    const needed = RAIN_CONFIG.MIN_WAGER_FOR_ENTRY - (rainState.wagered || 0);
                    await autoWagerForRainEntries(needed);
                    
                    setTimeout(async () => {
                        if (rainState.isRunning) {
                            const retry = await joinRain(potId);
                            if (retry.success) {
                                rainState.joinedRains.add(potId);
                                addLog('[RAIN] ✅ Joined after auto wager!', '#4ade80', '[R]');
                            }
                        }
                    }, 2000);
                } else {
                    addLog('[RAIN] ❌ Join failed: ' + (joinResult.reason || 'Unknown'), '#ff6b6b', '[R]');
                }
                
                const timeToSettle = settlesAt.getTime() - now.getTime();
                if (timeToSettle > 0) {
                    setTimeout(rainLoop, timeToSettle + 3000);
                } else {
                    setTimeout(rainLoop, 5000);
                }
                return;
            }
            
            if (now < startsAt) {
                const timeUntil = startsAt.getTime() - now.getTime();
                
                const currentWagered = rainState.wagered || 0;
                if (currentWagered < RAIN_CONFIG.MIN_WAGER_FOR_ENTRY) {
                    addLog('[RAIN] 🔄 Pre-wagering for entries...', '#60a5fa', '[R]');
                    await autoWagerForRainEntries(RAIN_CONFIG.MIN_WAGER_FOR_ENTRY - currentWagered);
                }
                
                setTimeout(rainLoop, Math.min(timeUntil + 1000, 60000));
                return;
            }
            
            setTimeout(rainLoop, RAIN_CONFIG.CHECK_INTERVAL);
            
        } catch(e) {
            addLog('[RAIN] ❌ Error: ' + e.message, '#ff6b6b', '[R]');
            setTimeout(rainLoop, 10000);
        }
    }

    function startRainBot() {
        if (rainState.isRunning) {
            addLog('[RAIN] Already running', '#ff922b', '[R]');
            return;
        }
        
        rainState.isRunning = true;
        rainState.joinedRains = new Set();
        rainState.wagered = 0;
        rainState.lastWin = null;
        
        addLog('🌧️ Rain catcher STARTED', '#4ade80', '[R]');
        addLog('[RAIN] Min wager: $33.33 for 1 entry', '#ffd700', '[R]');
        updateRainUI(null);
        
        rainLoop();
    }

    function stopRainBot() {
        rainState.isRunning = false;
        if (rainState.checkInterval) {
            clearInterval(rainState.checkInterval);
            rainState.checkInterval = null;
        }
        addLog('🌧️ Rain catcher STOPPED', '#ff6b6b', '[R]');
        updateRainUI(null);
    }

    function updateRainUI(rain) {
        const entriesEl = document.getElementById('rain-entries');
        const statusEl = document.getElementById('rain-status');
        const amountEl = document.getElementById('rain-amount');
        const timeEl = document.getElementById('rain-time');
        const lastWinEl = document.getElementById('rain-last-win');
        
        const entries = Math.floor((rainState.wagered || 0) / 33.33);
        const maxEntries = Math.min(entries, 3);
        
        if (entriesEl) {
            entriesEl.textContent = maxEntries + '/3';
            entriesEl.style.color = maxEntries > 0 ? '#4ade80' : '#ff6b6b';
        }
        
        if (statusEl) {
            if (rainState.isRunning) {
                statusEl.textContent = '🟢 RUNNING';
                statusEl.style.color = '#4ade80';
            } else {
                statusEl.textContent = '⏹️ STOPPED';
                statusEl.style.color = '#ff6b6b';
            }
        }
        
        if (rain && amountEl) {
            amountEl.textContent = '$' + parseFloat(rain.totalUsdAmount || 0).toFixed(2);
        } else if (!rain && amountEl) {
            amountEl.textContent = '$0.00';
        }
        
        if (rain && timeEl) {
            const now = new Date();
            const settlesAt = new Date(rain.settlesAt);
            if (now < settlesAt) {
                const diff = settlesAt - now;
                const mins = Math.floor(diff / 60000);
                const secs = Math.floor((diff % 60000) / 1000);
                timeEl.textContent = mins + 'm ' + secs + 's';
            } else {
                timeEl.textContent = 'Finished';
            }
        } else if (!rain && timeEl) {
            timeEl.textContent = '--:--';
        }
        
        if (lastWinEl) {
            if (rainState.lastWin) {
                lastWinEl.textContent = 'Last Win: +$' + rainState.lastWin.amount.toFixed(2);
                lastWinEl.style.color = '#4ade80';
            } else {
                lastWinEl.textContent = 'Last Win: --';
                lastWinEl.style.color = '#555';
            }
        }
    }

