// ============================================================
// DICEY ENGINE v8.0 - SIMPLE WAGER + RAIN CATCHER
// ============================================================
(function() {
    'use strict';

    // ============================================================
    // COIN PRICES
    // ============================================================
    const COIN_PRICES = {
        'USDC': 1.00,
        'USDT': 1.00,
        'SOL': 150.00,
        'BTC': 60000.00,
        'ETH': 3000.00,
        'ME': 0.50
    };

    function getCoinPrice(currency) {
        return COIN_PRICES[currency] || 1;
    }

    function getConvertedTarget() {
        const baseTarget = 33.33;
        const currency = getCurrency();
        const price = getCoinPrice(currency);
        return baseTarget / price;
    }

    // ============================================================
    // RANDOM HELPERS
    // ============================================================
    function randomDelay(min, max) {
        return Math.floor(Math.random() * (max - min + 1)) + min;
    }

    function randomFloat(min, max) {
        return Math.random() * (max - min) + min;
    }

    function sleep(ms) {
        return new Promise(function(resolve) {
            setTimeout(resolve, ms);
        });
    }

    function generateUUID() {
        return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
            const r = Math.random() * 16 | 0;
            const v = c === 'x' ? r : (r & 0x3 | 0x8);
            return v.toString(16);
        });
    }

    function $(id) { return document.getElementById(id); }

    function getCurrency() {
        const el = $('dicey-currency');
        return el ? el.value : 'USDC';
    }

    function getCurrencyDisplay() {
        return getCurrency().toUpperCase();
    }

    // ============================================================
    // FETCH FUNCTIONS
    // ============================================================
    async function fetchBalance() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'UserBalances',
                    query: `
                        query UserBalances {
                            userBalances {
                                balances {
                                    currency
                                    playableBalance {
                                        smallestUnits
                                        currencyCode
                                    }
                                }
                            }
                        }
                    `
                })
            });

            const data = await response.json();
            const balances = data?.data?.userBalances?.balances || [];
            const currency = getCurrency();
            const balance = balances.find(b => b.currency === currency);

            if (balance) {
                return balance.playableBalance.smallestUnits / 1000000;
            }
            return 0;

        } catch(e) {
            return 0;
        }
    }

    // ============================================================
    // PLACE BET
    // ============================================================
    async function placeBetWithRetry(betAmount, chance, maxRetries) {
        maxRetries = maxRetries || 3;
        
        for (var attempt = 1; attempt <= maxRetries; attempt++) {
            try {
                var result = await placeBet(betAmount, chance);
                if (result.success) {
                    return result;
                }
                
                if (attempt < maxRetries) {
                    var delay = randomDelay(1000, 3000);
                    await sleep(delay);
                }
            } catch(e) {
                if (attempt < maxRetries) {
                    await sleep(randomDelay(1000, 3000));
                } else {
                    return { success: false, error: e.message };
                }
            }
        }
        return { success: false, error: 'Max retries exceeded' };
    }

    async function placeBet(betAmount, chance) {
        var cryptoCurrency = getCurrency();
        var rollMode = 'Under';
        var targetNumber = Math.floor((chance / 100) * 10000);

        var query = 'mutation PlaceDiceBet($input: DiceBetInput!) { placeDiceBet(input: $input) { roundId activityId betAmount targetNumber targetNumberLower targetNumberUpper rollMode rolledNumber multiplier winAmount isWin profit timestamp __typename } }';

        var variables = {
            input: {
                betAmount: String(betAmount),
                cryptoCurrency: cryptoCurrency,
                nonce: generateUUID(),
                rollMode: rollMode,
                targetNumber: targetNumber
            }
        };

        var payload = {
            operationName: "PlaceDiceBet",
            query: query,
            variables: variables
        };

        try {
            var response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/graphql-response+json, application/graphql+json, application/json',
                    'Origin': 'https://dicey.com'
                },
                credentials: 'include',
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            var data = await response.json();
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }
            return { success: true, data: data.data.placeDiceBet };
        } catch (error) {
            return { success: false, error: error.message };
        }
    }

    // ============================================================
    // PLACE LIMBO BET
    // ============================================================
    async function placeLimboBet(betAmount, targetMultiplier) {
        const cryptoCurrency = getCurrency();

        const query = `mutation PlaceLimboBet($input: LimboBetInput!) {
            placeLimboBet(input: $input) {
                betAmount targetMultiplier rolledMultiplier multiplier profit isWin roundId activityId timestamp winAmount __typename
            }
        }`;

        const variables = {
            input: {
                betAmount: String(betAmount),
                cryptoCurrency: cryptoCurrency,
                nonce: generateUUID(),
                targetMultiplier: targetMultiplier
            }
        };

        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'PlaceLimboBet',
                    query: query,
                    variables: variables
                })
            });

            if (!response.ok) throw new Error('HTTP ' + response.status);
            const data = await response.json();
            if (data.errors) throw new Error(data.errors[0].message);
            return { success: true, data: data.data.placeLimboBet };
        } catch (error) {
            return { success: false, error: error.message };
        }
    }

    // ============================================================
    // LOG SYSTEM
    // ============================================================
    function addLog(msg, color, icon) {
        color = color || '#a0a0a0';
        icon = icon || '[i]';

        const log = document.getElementById('dicey-log');
        if (!log) return;

        const time = new Date().toLocaleTimeString();
        const entry = document.createElement('div');
        entry.style.cssText = 'padding:2px 0;border-bottom:1px solid rgba(255,255,255,0.03);font-size:7px;font-family:Consolas,monospace;color:' + color + ';display:flex;align-items:center;gap:4px;';
        entry.innerHTML = '<span style="color:#666;flex-shrink:0;">[' + time + ']</span><span style="flex-shrink:0;">' + icon + '</span><span style="word-break:break-word;">' + msg + '</span>';

        log.appendChild(entry);
        log.scrollTop = log.scrollHeight;

        while (log.children.length > 200) {
            log.removeChild(log.firstChild);
        }
    }

    // ============================================================
    // WAGER MODES
    // ============================================================
    const WAGER_MODES = {
        AMAN: { bet: 0.01, chance: 98, name: '🛡️ AMAN', desc: '0.01 @ 98%' },
        CEPAT: { bet: 0.02, chance: 95, name: '⚡ CEPAT', desc: '0.02 @ 95%' },
        EXTREME: { bet: 0.03, chance: 92, name: '🔥 EXTREME', desc: '0.03 @ 92%' }
    };

    // ============================================================
    // SIMPLE STATE
    // ============================================================
    let simpleState = {
        running: false,
        paused: false,
        target: 33.33,
        wagered: 0,
        mode: 'AMAN',
        startBalance: 0,
        currentBalance: 0,
        profit: 0,
        startTime: null,
        totalBets: 0,
        wins: 0,
        losses: 0,
        currentStreak: 0,
        currentLayer: 1,
        recoveryLoss: 0,
        timerInterval: null,
        isLooping: false
    };

    // ============================================================
    // RECOVERY STATE - D'ALEMBERT HYBRID
    // ============================================================
    let recoveryState = {
        active: false,
        payout: 2.02,
        bet: 0.01,
        baseBet: 0.01,
        unit: 0.01,
        lossCount: 0,
        consecutiveLoss: 0,
        isSafeMode: false,
        maxBet: 0.10,
        recovered: false
    };

    // ============================================================
    // RAIN STATE
    // ============================================================
    const RAIN_CONFIG = {
        MIN_WAGER_FOR_ENTRY: 33.33,
        MAX_ENTRIES: 3,
        CHECK_INTERVAL: 5000
    };

    let rainState = {
        isRunning: false,
        joinedRains: new Set(),
        wagered: 0,
        entries: 0,
        checkInterval: null,
        lastWin: null
    };

    // ============================================================
    // RECOVERY HANDLER
    // ============================================================
    async function handleRecoveryMode() {
        if (recoveryState.recovered) {
            recoveryState.recovered = false;
            return;
        }
        
        recoveryState.active = true;
        recoveryState.bet = 0.01;
        recoveryState.lossCount = 0;
        recoveryState.consecutiveLoss = 0;
        recoveryState.isSafeMode = false;
        recoveryState.payout = 2.02;
        
        addLog('🔄 Entering recovery mode', '#ff922b', '[🔄]');
        
        let maxAttempts = 20;
        let attempts = 0;
        
        while (recoveryState.active && attempts < maxAttempts) {
            attempts++;
            
            if (recoveryState.lossCount <= 0 && recoveryState.bet <= recoveryState.baseBet) {
                recoveryState.active = false;
                recoveryState.recovered = true;
                addLog('✅ Recovery complete!', '#4ade80', '[✅]');
                return;
            }
            
            if (!recoveryState.isSafeMode && recoveryState.consecutiveLoss >= 2) {
                recoveryState.isSafeMode = true;
                recoveryState.payout = 1.3;
                recoveryState.bet = recoveryState.baseBet + (recoveryState.lossCount * recoveryState.unit);
                addLog('🔄 2 losses → 1.3x safe mode', '#60a5fa', '[🔄]');
            }
            
            if (recoveryState.bet > recoveryState.maxBet) {
                addLog('🚨 Max bet reached, resetting', '#ff6b6b', '[🚨]');
                recoveryState.active = false;
                return;
            }
            
            const result = await placeLimboBet(recoveryState.bet, recoveryState.payout);
            
            if (result.success) {
                const data = result.data;
                const isWin = data.isWin;
                const profit = parseFloat(data.profit) || 0;
                
                simpleState.wagered += recoveryState.bet;
                simpleState.currentBalance += profit;
                simpleState.profit += profit;
                simpleState.totalBets++;
                
                if (isWin) {
                    recoveryState.bet = Math.max(recoveryState.baseBet, recoveryState.bet - recoveryState.unit);
                    recoveryState.lossCount = Math.max(0, recoveryState.lossCount - 1);
                    recoveryState.consecutiveLoss = 0;
                    
                    if (recoveryState.isSafeMode && recoveryState.bet <= recoveryState.baseBet) {
                        recoveryState.isSafeMode = false;
                        recoveryState.payout = 2.02;
                        recoveryState.bet = recoveryState.baseBet;
                        recoveryState.lossCount = 0;
                        addLog('✅ Back to 2.02x', '#4ade80', '[✅]');
                    }
                    
                    addLog('[REC] ✅ ' + recoveryState.payout + 'x | ' + recoveryState.bet.toFixed(3), '#4ade80', '[W]');
                    
                } else {
                    recoveryState.bet = Math.min(recoveryState.maxBet, recoveryState.bet + recoveryState.unit);
                    recoveryState.lossCount++;
                    recoveryState.consecutiveLoss++;
                    
                    addLog('[REC] ❌ ' + recoveryState.payout + 'x | ' + recoveryState.bet.toFixed(3), '#ff6b6b', '[L]');
                }
                
                updateSimpleUI();
            }
            
            await sleep(100 + Math.random() * 200);
        }
        
        if (attempts >= maxAttempts) {
            addLog('⚠️ Recovery timeout', '#ff922b', '[⚠️]');
            recoveryState.active = false;
        }
    }

    // ============================================================
    // SIMPLE WAGER LOOP
    // ============================================================
    async function simpleWagerLoop() {
        if (!simpleState.running || simpleState.paused || simpleState.isLooping) {
            setTimeout(simpleWagerLoop, 100);
            return;
        }
        
        simpleState.isLooping = true;
        
        try {
            if (simpleState.wagered >= simpleState.target) {
                addLog('🎯 TARGET ' + simpleState.target + ' USDC REACHED! ✅', '#4ade80', '[🎯]');
                stopSimpleWager();
                simpleState.isLooping = false;
                return;
            }
            
            const balance = await fetchBalance();
            if (balance < 0.01) {
                addLog('❌ Insufficient balance!', '#ff6b6b', '[❌]');
                stopSimpleWager();
                simpleState.isLooping = false;
                return;
            }
            simpleState.currentBalance = balance;
            
            const mode = WAGER_MODES[simpleState.mode];
            const betAmount = mode.bet;
            const chance = mode.chance;
            
            const result = await placeBetWithRetry(betAmount, chance);
            
            if (result.success) {
                const data = result.data;
                const profit = parseFloat(data.profit) || 0;
                const isWin = data.isWin;
                
                simpleState.wagered += betAmount;
                simpleState.currentBalance += profit;
                simpleState.profit += profit;
                simpleState.totalBets++;
                
                if (isWin) {
                    simpleState.wins++;
                    simpleState.currentStreak = simpleState.currentStreak > 0 ? simpleState.currentStreak + 1 : 1;
                } else {
                    simpleState.losses++;
                    simpleState.currentStreak = simpleState.currentStreak < 0 ? simpleState.currentStreak - 1 : -1;
                    await handleRecoveryMode();
                }
                
                updateSimpleUI();
                
                addLog(
                    (isWin ? '✅' : '❌') + ' ' + betAmount.toFixed(3) + ' | ' + 
                    (profit >= 0 ? '+' : '') + profit.toFixed(4) + ' | ' + 
                    simpleState.wagered.toFixed(2) + '/' + simpleState.target,
                    isWin ? '#4ade80' : '#ff6b6b',
                    isWin ? '[W]' : '[L]'
                );
            }
            
        } catch (e) {
            addLog('❌ Error: ' + e.message, '#ff6b6b', '[❌]');
        }
        
        simpleState.isLooping = false;
        
        setTimeout(simpleWagerLoop, 100 + Math.random() * 200);
    }

    // ============================================================
    // WAGER CONTROLS
    // ============================================================
    function startSimpleWager() {
        if (simpleState.running && !simpleState.paused) {
            addLog('⚠️ Already running', '#ff922b', '[⚠️]');
            return;
        }
        
        if (!simpleState.running) {
            const targetInput = document.getElementById('simple-target');
            const modeSelect = document.getElementById('simple-mode');
            
            simpleState.target = parseFloat(targetInput?.value) || 33.33;
            simpleState.mode = modeSelect?.value || 'AMAN';
            simpleState.wagered = 0;
            simpleState.profit = 0;
            simpleState.totalBets = 0;
            simpleState.wins = 0;
            simpleState.losses = 0;
            simpleState.currentStreak = 0;
            simpleState.currentLayer = 1;
            simpleState.recoveryLoss = 0;
            simpleState.startBalance = simpleState.currentBalance;
            simpleState.startTime = Date.now();
            recoveryState.recovered = false;
            recoveryState.active = false;
            
            addLog('▶️ START | Target: ' + simpleState.target + ' | Mode: ' + WAGER_MODES[simpleState.mode].name, '#4ade80', '[▶️]');
        }
        
        if (simpleState.paused) {
            simpleState.paused = false;
            addLog('▶️ RESUMED', '#4ade80', '[▶️]');
        }
        
        simpleState.running = true;
        
        if (simpleState.timerInterval) {
            clearInterval(simpleState.timerInterval);
        }
        simpleState.timerInterval = setInterval(updateSimpleUI, 1000);
        
        updateSimpleUI();
        simpleWagerLoop();
    }

    function pauseSimpleWager() {
        if (!simpleState.running) {
            addLog('⚠️ Bot not running', '#ff922b', '[⚠️]');
            return;
        }
        simpleState.paused = !simpleState.paused;
        addLog(simpleState.paused ? '⏸️ PAUSED' : '▶️ RESUMED', '#ff922b', simpleState.paused ? '[⏸️]' : '[▶️]');
        updateSimpleUI();
    }

    function stopSimpleWager() {
        simpleState.running = false;
        simpleState.paused = false;
        simpleState.isLooping = false;
        recoveryState.active = false;
        
        if (simpleState.timerInterval) {
            clearInterval(simpleState.timerInterval);
            simpleState.timerInterval = null;
        }
        
        addLog('⏹️ STOP | Wagered: ' + simpleState.wagered.toFixed(2) + ' | Profit: ' + simpleState.profit.toFixed(4), '#ff6b6b', '[⏹️]');
        updateSimpleUI();
    }

    // ============================================================
    // UPDATE UI
    // ============================================================
    function updateSimpleUI() {
        const progress = Math.min((simpleState.wagered / simpleState.target) * 100, 100);
        
        const bar = document.getElementById('simple-progress');
        const text = document.getElementById('simple-progress-text');
        if (bar) bar.style.width = progress + '%';
        if (text) text.textContent = simpleState.wagered.toFixed(2) + ' / ' + simpleState.target + ' USDC';
        
        const status = document.getElementById('simple-status');
        if (status) {
            if (simpleState.running && !simpleState.paused) {
                status.textContent = '🟢 RUN';
                status.style.color = '#4ade80';
            } else if (simpleState.running && simpleState.paused) {
                status.textContent = '🟡 PAUSE';
                status.style.color = '#ff922b';
            } else {
                status.textContent = '🔴 STOP';
                status.style.color = '#ff6b6b';
            }
        }
        
        const profit = document.getElementById('simple-profit');
        if (profit) {
            profit.textContent = (simpleState.profit >= 0 ? '+' : '') + simpleState.profit.toFixed(4);
            profit.style.color = simpleState.profit >= 0 ? '#4ade80' : '#ff6b6b';
        }
        
        const bets = document.getElementById('simple-bets');
        if (bets) bets.textContent = simpleState.totalBets;
        
        if (simpleState.startTime) {
            const elapsed = Math.floor((Date.now() - simpleState.startTime) / 1000);
            const hours = String(Math.floor(elapsed / 3600)).padStart(2, '0');
            const minutes = String(Math.floor((elapsed % 3600) / 60)).padStart(2, '0');
            const seconds = String(elapsed % 60).padStart(2, '0');
            const timer = document.getElementById('simple-timer');
            if (timer) timer.textContent = hours + ':' + minutes + ':' + seconds;
        }
        
        const layer = document.getElementById('stats-layer');
        if (layer) layer.textContent = simpleState.currentLayer || 1;
        
        const chance = document.getElementById('stats-chance');
        if (chance) {
            const mode = WAGER_MODES[simpleState.mode];
            chance.textContent = mode ? mode.chance + '%' : '98%';
        }
        
        const bet = document.getElementById('stats-bet');
        if (bet) {
            const mode = WAGER_MODES[simpleState.mode];
            bet.textContent = mode ? mode.bet.toFixed(4) : '0.0100';
        }
        
        const streak = document.getElementById('stats-streak');
        if (streak) {
            streak.textContent = simpleState.currentStreak || 0;
            streak.style.color = simpleState.currentStreak > 0 ? '#4ade80' : 
                                simpleState.currentStreak < 0 ? '#ff6b6b' : '#a0a0a0';
        }
        
        const wagered = document.getElementById('stats-wagered');
        if (wagered) wagered.textContent = simpleState.wagered.toFixed(4);
        
        const wl = document.getElementById('stats-wl');
        if (wl) wl.textContent = simpleState.wins + '/' + simpleState.losses;
        
        const winrate = document.getElementById('stats-winrate');
        if (winrate) {
            const total = simpleState.wins + simpleState.losses;
            const rate = total > 0 ? ((simpleState.wins / total) * 100).toFixed(1) : 0;
            winrate.textContent = rate + '%';
        }
        
        const recovery = document.getElementById('stats-recovery');
        if (recovery) {
            recovery.textContent = simpleState.recoveryLoss.toFixed(4);
            recovery.style.color = simpleState.recoveryLoss > 0 ? '#4ade80' : '#ff922b';
        }
    }

