    // ============================================================
    // SWITCH ENGINE - MAIN LOGIC
    // ============================================================

    const switchState = {
        currentPreset: 'SAFE',
        layer: 1,
        gameIndex: 0,
        cycleCount: 0,
        gameStats: {},
        lossStreak: 0,
        winStreak: 0,
        totalBetsInLayer: 0,
        layerProfit: 0,
        isInRecovery: false
    };

    function initGameStats(gameConfig) {
        const key = `${gameConfig.game}_${gameConfig.bet}_${gameConfig.chance || gameConfig.risk}`;
        if (!switchState.gameStats[key]) {
            switchState.gameStats[key] = {
                game: gameConfig.game,
                bets: 0,
                wins: 0,
                losses: 0,
                profit: 0,
                wagered: 0,
                currentStreak: 0,
                bestStreak: 0,
                worstStreak: 0
            };
        }
        return key;
    }

    function updateGameStats(key, isWin, profit, betAmount) {
        const stats = switchState.gameStats[key];
        if (!stats) return;
        
        stats.bets++;
        stats.wagered += betAmount;
        stats.profit += profit;
        
        if (isWin) {
            stats.wins++;
            stats.currentStreak = stats.currentStreak > 0 ? stats.currentStreak + 1 : 1;
            if (stats.currentStreak > stats.bestStreak) {
                stats.bestStreak = stats.currentStreak;
            }
        } else {
            stats.losses++;
            stats.currentStreak = stats.currentStreak < 0 ? stats.currentStreak - 1 : -1;
            if (stats.currentStreak < stats.worstStreak) {
                stats.worstStreak = stats.currentStreak;
            }
        }
    }

    function getGameDisplayName(gameConfig) {
        let name = gameConfig.game;
        if (gameConfig.game === 'DICE') {
            name += ` ${gameConfig.chance}%`;
        } else if (gameConfig.game === 'KENO') {
            name += ` ${gameConfig.risk}`;
        } else if (gameConfig.game === 'PLINKO') {
            name += ` ${gameConfig.risk} ${gameConfig.rows || 8}r`;
        } else if (gameConfig.game === 'LIMBO') {
            name += ` ${gameConfig.targetMultiplier}x`;
        }
        return name;
    }

    function getCurrentPreset() {
        return PRESETS[switchState.currentPreset];
    }

    function getCurrentLayerConfig() {
        const preset = getCurrentPreset();
        return switchState.layer === 1 ? preset.layer1 : preset.layer2;
    }

    function getCurrentGame() {
        const layerConfig = getCurrentLayerConfig();
        return layerConfig.games[switchState.gameIndex];
    }

    function getNextGame(layerConfig, currentGameIndex, isWin) {
        const games = layerConfig.games;
        const currentGame = games[currentGameIndex];
        
        switchState.cycleCount++;
        
        if (isWin) {
            switchState.winStreak++;
            switchState.lossStreak = 0;
        } else {
            switchState.lossStreak++;
            switchState.winStreak = 0;
        }
        
        if (switchState.layer === 1 && switchState.lossStreak >= 3) {
            switchState.lossStreak = 0;
            switchState.winStreak = 0;
            switchState.isInRecovery = true;
            return { 
                action: 'switchLayer', 
                layer: 2,
                gameIndex: 0,
                reason: `Loss streak → L2`
            };
        }
        
        if (switchState.cycleCount >= currentGame.cycle) {
            switchState.cycleCount = 0;
            const nextIndex = (currentGameIndex + 1) % games.length;
            
            if (switchState.layer === 1 && nextIndex === 0) {
                return {
                    action: 'cycleComplete',
                    gameIndex: 0,
                    reason: 'L1 cycle complete, restarting'
                };
            }
            
            return {
                action: 'switchGame',
                gameIndex: nextIndex,
                reason: `${currentGame.game} cycle complete → ${games[nextIndex].game}`
            };
        }
        
        if (switchState.layer === 2 && switchState.isInRecovery) {
            const backConfig = getCurrentPreset().backToL1;
            
            if (backConfig.condition === 'streak' && switchState.winStreak >= backConfig.streak) {
                switchState.isInRecovery = false;
                switchState.winStreak = 0;
                switchState.lossStreak = 0;
                switchState.layer = 1;
                switchState.gameIndex = 0;
                switchState.cycleCount = 0;
                return {
                    action: 'backToL1',
                    gameIndex: 0,
                    reason: `Win streak ${backConfig.streak} → back to L1`
                };
            }
            
            if (backConfig.condition === 'profit' && switchState.layerProfit >= backConfig.profit) {
                switchState.isInRecovery = false;
                switchState.winStreak = 0;
                switchState.lossStreak = 0;
                switchState.layer = 1;
                switchState.gameIndex = 0;
                switchState.cycleCount = 0;
                return {
                    action: 'backToL1',
                    gameIndex: 0,
                    reason: `Profit ${switchState.layerProfit.toFixed(4)} → back to L1`
                };
            }
        }
        
        return {
            action: 'continue',
            gameIndex: currentGameIndex,
            reason: 'continue'
        };
    }

    // ============================================================
    // EXECUTE WAGER WITH SWITCH ENGINE
    // ============================================================

    async function executeSwitchWager() {
        if (!wagerState.isRunning || wagerState.isPaused) return null;
        
        const preset = getCurrentPreset();
        const target = preset.target;
        const profit = wagerState.currentBalance - wagerState.startBalance;
        
        if (wagerState.wagered >= target.wagered) {
            addLog(`[TARGET] Wagered ${wagerState.wagered.toFixed(2)} ${getCurrency()} reached!`, '#4ade80', '[T]');
            stopWagerBot();
            return null;
        }
        
        if (profit >= target.profit) {
            addLog(`[TARGET] Profit ${profit.toFixed(4)} reached!`, '#4ade80', '[P]');
            stopWagerBot();
            return null;
        }
        
        if (profit <= -target.stopLoss) {
            addLog(`[STOP] Stop loss ${target.stopLoss} reached!`, '#ff6b6b', '[S]');
            stopWagerBot();
            return null;
        }
        
        if (switchState.lossStreak >= 10) {
            addLog(`[EMERGENCY] 10 consecutive losses!`, '#ff6b6b', '[🚨]');
            stopWagerBot();
            return null;
        }
        
        const layerConfig = getCurrentLayerConfig();
        const game = getCurrentGame();
        const gameKey = initGameStats(game);
        
        let result;
        let gameDisplay = getGameDisplayName(game);
        
        try {
            switch(game.game) {
                case 'DICE':
                    result = await placeDiceBetHandler(game.bet, game.chance);
                    break;
                case 'KENO':
                    result = await placeKenoBetHandler(game.bet, game.risk);
                    break;
                case 'PLINKO':
                    result = await placePlinkoBetHandler(game.bet, game.risk, game.rows || 8);
                    break;
                case 'LIMBO':
                    result = await placeLimboBetHandler(game.bet, game.targetMultiplier || 2);
                    break;
                default:
                    addLog(`[ERR] Unknown game: ${game.game}`, '#ff6b6b', '[❌]');
                    return null;
            }
            
            if (!result.success) {
                addLog(`[ERR] ${game.game} bet failed: ${result.error}`, '#ff6b6b', '[❌]');
                return null;
            }
            
            const data = result.data;
            const isWin = data.isWin;
            const profitNum = parseFloat(data.profit) || 0;
            const betAmount = parseFloat(data.betAmount) || game.bet;
            
            wagerState.wagered += betAmount;
            wagerState.currentBalance += profitNum;
            wagerState.totalBets++;
            switchState.totalBetsInLayer++;
            switchState.layerProfit += profitNum;
            
            if (isWin) {
                wagerState.totalWins++;
                switchState.winStreak++;
                switchState.lossStreak = 0;
            } else {
                wagerState.totalLosses++;
                switchState.lossStreak++;
                switchState.winStreak = 0;
            }
            
            updateGameStats(gameKey, isWin, profitNum, betAmount);
            
            const layerLabel = switchState.layer === 1 ? 'L1' : 'L2';
            const winLabel = isWin ? '✅ WIN' : '❌ LOSE';
            addLog(
                `[${layerLabel}] ${gameDisplay} | ${winLabel} | ${betAmount.toFixed(4)} | ${(profitNum >= 0 ? '+' : '') + profitNum.toFixed(4)} | S:${switchState.winStreak}`,
                isWin ? '#4ade80' : '#ff6b6b',
                isWin ? '[W]' : '[L]'
            );
            
            addBetLog(
                wagerState.totalBets,
                betAmount.toFixed(4),
                game.chance || game.risk || '?',
                profitNum
            );
            
            updateWagerUI();
            updateSwitchUI();
            
            const next = getNextGame(layerConfig, switchState.gameIndex, isWin);
            
            if (next.action === 'switchLayer') {
                switchState.layer = 2;
                switchState.gameIndex = 0;
                switchState.cycleCount = 0;
                switchState.totalBetsInLayer = 0;
                switchState.layerProfit = 0;
                switchState.isInRecovery = true;
                addLog(`[SWITCH] ${next.reason}`, '#ff922b', '[🔀]');
                updateSwitchUI();
            } else if (next.action === 'switchGame') {
                switchState.gameIndex = next.gameIndex;
                switchState.cycleCount = 0;
                switchState.totalBetsInLayer = 0;
                switchState.layerProfit = 0;
                addLog(`[SWITCH] ${next.reason}`, '#60a5fa', '[🔀]');
                updateSwitchUI();
            } else if (next.action === 'backToL1') {
                switchState.layer = 1;
                switchState.gameIndex = 0;
                switchState.cycleCount = 0;
                switchState.totalBetsInLayer = 0;
                switchState.layerProfit = 0;
                switchState.isInRecovery = false;
                switchState.winStreak = 0;
                switchState.lossStreak = 0;
                addLog(`[SWITCH] ${next.reason}`, '#4ade80', '[🔀]');
                updateSwitchUI();
            } else if (next.action === 'cycleComplete') {
                switchState.gameIndex = 0;
                switchState.cycleCount = 0;
                switchState.totalBetsInLayer = 0;
                switchState.layerProfit = 0;
                addLog(`[SWITCH] ${next.reason}`, '#60a5fa', '[🔀]');
                updateSwitchUI();
            }
            
            const realBalance = getRealBalance();
            if (realBalance !== null && realBalance > 0) {
                wagerState.currentBalance = realBalance;
            }
            
            const autoContinue = document.getElementById('dicey-auto-continue');
            if (autoContinue && autoContinue.checked && wagerState.isRunning) {
                const cooldown = parseInt(document.getElementById('dicey-cooldown')?.value || 0);
                setTimeout(executeSwitchWager, cooldown + randomDelay(100, 400));
            }
            
            return data;
            
        } catch(e) {
            addLog(`[ERR] ${game.game} error: ${e.message}`, '#ff6b6b', '[❌]');
            return null;
        }
    }

