                <div style="background:#1e1f1c;border-radius:8px;border:1px solid #3a3a3a;padding:6px 8px;">
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:3px;">
                        <span style="font-size:9px;font-weight:600;color:#a0a0a0;">📝 LOGS</span>
                        <button id="dicey-log-clear" style="padding:2px 8px;border:none;border-radius:3px;background:#3a3a3a;color:#a0a0a0;font-size:7px;cursor:pointer;">CLEAR</button>
                    </div>
                    <div id="dicey-log" style="background:#0f0f0a;border-radius:4px;padding:3px 5px;max-height:100px;overflow-y:auto;font-family:Consolas,monospace;font-size:7px;color:#a0a0a0;border:1px solid #3a3a3a;"></div>
                </div>
            </div>
            <div style="background:#2d2d2a;padding:2px 10px;font-size:7px;color:#888;display:flex;justify-content:space-between;align-items:center;border-top:1px solid #3a3a3a;flex-shrink:0;min-height:20px;">
                <span>⚡ READY</span>
                <span id="dicey-footer-status" style="color:#888;">Idle</span>
                <span id="dicey-footer-timer" style="color:#666;">⏱ 00:00:00</span>
            </div>
        `;

        document.body.appendChild(container);

        // ============================================================
        // EVENT LISTENERS
        // ============================================================
        document.getElementById('simple-start')?.addEventListener('click', startBot);
        document.getElementById('simple-pause')?.addEventListener('click', pauseBot);
        document.getElementById('simple-stop')?.addEventListener('click', stopBot);
        
        document.getElementById('rain-start')?.addEventListener('click', startRainBot);
        document.getElementById('rain-stop')?.addEventListener('click', stopRainBot);
        
        document.getElementById('simple-target')?.addEventListener('change', function() {
            simpleState.target = parseFloat(this.value) || 33.33;
            updateUI();
        });
        document.getElementById('dicey-log-clear')?.addEventListener('click', function() {
            const log = document.getElementById('dicey-log');
            if (log) log.innerHTML = '';
        });
        document.getElementById('dicey-currency')?.addEventListener('change', function() {
            updateUI();
        });

        document.getElementById('dicey-minimize')?.addEventListener('click', function() {
            const content = document.getElementById('dicey-content');
            if (content) {
                content.style.display = content.style.display === 'none' ? 'block' : 'none';
                this.textContent = content.style.display === 'none' ? '+' : '-';
            }
        });

        document.getElementById('dicey-close')?.addEventListener('click', function() {
            if (simpleState.running) stopBot();
            if (rainState.isRunning) stopRainBot();
            document.getElementById('dicey-bot-ui').style.display = 'none';
        });

        // DRAGGABLE
        let isDragging = false;
        let dragOffsetX, dragOffsetY;
        const header = document.getElementById('dicey-header');

        header.addEventListener('mousedown', function(e) {
            if (e.target.closest('button')) return;
            isDragging = true;
            const rect = container.getBoundingClientRect();
            dragOffsetX = e.clientX - rect.left;
            dragOffsetY = e.clientY - rect.top;
            container.style.cursor = 'grabbing';
            e.preventDefault();
        });

        document.addEventListener('mousemove', function(e) {
            if (!isDragging) return;
            let x = e.clientX - dragOffsetX;
            let y = e.clientY - dragOffsetY;
            x = Math.max(0, Math.min(window.innerWidth - container.offsetWidth, x));
            y = Math.max(0, Math.min(window.innerHeight - container.offsetHeight, y));
            container.style.left = x + 'px';
            container.style.right = 'auto';
            container.style.bottom = 'auto';
            container.style.top = y + 'px';
        });

        document.addEventListener('mouseup', function() {
            isDragging = false;
            container.style.cursor = '';
        });

        // KEYBOARD SHORTCUTS
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey && e.shiftKey && e.key === 'D') {
                e.preventDefault();
                const ui = document.getElementById('dicey-bot-ui');
                if (ui) ui.style.display = ui.style.display === 'none' ? 'block' : 'none';
            }
            if (e.key === 'Enter' && e.ctrlKey) {
                e.preventDefault();
                if (simpleState.running) stopBot();
                else startBot();
            }
            if (e.key === ' ' && e.ctrlKey) {
                e.preventDefault();
                pauseBot();
            }
        });

        // ============================================================
        // UPDATE BALANCE
        // ============================================================
        async function updateBalanceUI() {
            const balance = await fetchBalance();
            const el = document.getElementById('dicey-balance-display');
            if (el) {
                el.textContent = balance.toFixed(4);
                el.style.color = balance > 0.1 ? '#4ade80' : '#ff922b';
            }
            const currencyEl = document.getElementById('dicey-balance-currency');
            if (currencyEl) currencyEl.textContent = getCurrency();
            simpleState.currentBalance = balance;
        }

        // ============================================================
        // INIT
        // ============================================================
        setTimeout(updateBalanceUI, 500);
        setTimeout(updateUserInfoUI, 800);
        setTimeout(updateUI, 1000);
        setTimeout(updateRainUI, 1200);

        setInterval(updateBalanceUI, 30000);
        setInterval(updateUserInfoUI, 60000);
        setInterval(updateUI, 1000);
        setInterval(() => {
            if (rainState.isRunning) {
                fetchRainSchedule().then(updateRainUI);
            }
        }, 5000);

        addLog('🎲 DiceY Engine v8 READY', '#9ec07c', '[I]');
        addLog('🎯 DICE 98% + Recovery DICE 49.5%→75%', '#4ade80', '[I]');
        addLog('🌧️ Rain: Auto join + auto wager for entries', '#60a5fa', '[I]');
        addLog('⌨️ Ctrl+Enter: Start/Stop | Ctrl+Space: Pause', '#888', '[I]');

        console.log('🎲 DiceY Engine v8 READY');
        console.log('🎯 DICE 98% + Recovery DICE 49.5%→75%');
        console.log('🌧️ Rain: Auto join + auto wager for entries');
        console.log('⌨️ Ctrl+Enter: Start/Stop | Ctrl+Space: Pause');
    }

    // ============================================================
    // START
    // ============================================================
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', buildUI);
    } else {
        buildUI();
    }

})();
