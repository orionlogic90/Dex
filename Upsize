                    transition:all 0.15s;
                    border:1px solid ${isSelected ? '#4ade80' : '#3a3a3a'};
                    user-select:none;
                ">${i}</div>
            `;
        }
        container.innerHTML = html;
        
        container.querySelectorAll('.keno-tile').forEach(tile => {
