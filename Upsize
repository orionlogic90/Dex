    function stopRainTimer() {
        if (rainState.timerInterval) {
            clearInterval(rainState.timerInterval);
            rainState.timerInterval = null;
        }
        updateRainTimer(null);
    }

    // ============================================================
    // JOIN RAIN - FIX InsufficientEntries
    // ============================================================
    async function joinRainDirect(potId) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com',
                    'User-Agent': navigator.userAgent
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'JoinRain',
                    query: `
                        mutation JoinRain($potId: ID!) {
                            joinRain(potId: $potId) {
                                joined
                                alreadyJoined
                                ineligibleReason
                                __typename
                            }
                        }
                    `,
                    variables: { potId }
                })
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }

            const result = data?.data?.joinRain;
            
            // Handle InsufficientEntries
            if (result && result.ineligibleReason === 'InsufficientEntries') {
                const currentWager = wagerState.wagered || 0;
                addLog('[RAIN] ❌ Not enough entries! Current wager: $' + currentWager.toFixed(2) + ' (Need $33.33 for 1 entry)', '#ff6b6b', '[R]');
                return { 
                    success: false, 
                    joined: false,
                    reason: 'InsufficientEntries',
                    message: 'Need more wager volume to join rain',
                    currentWager: currentWager
                };
            }

            return { 
                success: result?.joined || false, 
                joined: result?.joined || false,
                alreadyJoined: result?.alreadyJoined || false,
                reason: result?.ineligibleReason || null
            };

        } catch(e) {
            addLog('[RAIN] Join error: ' + e.message, '#ff6b6b', '[R]');
            return { success: false, error: e.message };
        }
    }

    // ============================================================
    // AUTO WAGER FOR RAIN ENTRIES - Based on $33.33 per entry
    // ============================================================
    async function autoWagerForRainEntries() {
        const currency = getCurrency();
        const betAmount = parseFloat($('dicey-layer1-bet')?.value || 0.01);
        const chance = parseFloat($('dicey-layer1-chance')?.value || 98);
        
        const currentWager = wagerState.wagered || 0;
        const targetWager = 33.33; // $33.33 for 1 entry
        
        // Check if already have at least 1 entry
        const currentEntries = Math.floor(currentWager / 33.33);
        if (currentEntries >= 1) {
            addLog('[RAIN] ✅ Already have entries! Wager: $' + currentWager.toFixed(2) + ' (' + currentEntries + ' entries)', '#4ade80', '[R]');
            return true;
        }

        // Need at least 1 entry ($33.33)
        const neededForOneEntry = 33.33 - currentWager;
        addLog('[RAIN] 🔄 Need $' + neededForOneEntry.toFixed(2) + ' more for 1 entry', '#ff922b', '[R]');
        addLog('[RAIN] 💰 Auto wager started for rain entries...', '#60a5fa', '[R]');

        let wagered = currentWager;
        let attempts = 0;
        const maxAttempts = 50;

        while (wagered < 33.33 && attempts < maxAttempts) {
            attempts++;
            
            let currentBet = betAmount;
            const remainingForEntry = 33.33 - wagered;
            
            // Adjust bet based on remaining
            if (remainingForEntry > 20) {
                currentBet = betAmount * randomFloat(1.2, 2.0);
            } else if (remainingForEntry > 10) {
                currentBet = betAmount * randomFloat(1.0, 1.5);
            } else {
                currentBet = betAmount * randomFloat(0.8, 1.2);
            }
            currentBet = Math.max(currentBet, 0.0001);
            currentBet = Math.min(currentBet, 0.5);
            
            if (attempts % 5 === 0 || wagered + currentBet >= 33.33) {
                const progress = ((wagered / 33.33) * 100).toFixed(1);
                addLog('[RAIN] 📊 Progress: $' + wagered.toFixed(2) + '/$33.33 (' + progress + '%) - Target: 1 entry', '#ffd700', '[R]');
            }

            const result = await placeBetWithRetry(currentBet, chance);

            if (result.success) {
                wagered += currentBet;
                wagerState.wagered += currentBet;
            } else {
                addLog('[RAIN] ⚠️ Wager failed: ' + result.error, '#ff922b', '[R]');
            }

            await sleep(randomDelay(300, 800));
        }

        const finalEntries = Math.floor(wagered / 33.33);
        if (finalEntries >= 1) {
            addLog('[RAIN] ✅ 1 entry achieved! ($' + wagered.toFixed(2) + ' wagered)', '#4ade80', '[R]');
            updateWagerTarget();
            updateWagerUI();
            return true;
        }

        addLog('[RAIN] ⚠️ Failed to get entry: $' + wagered.toFixed(2) + '/$33.33 needed', '#ff6b6b', '[R]');
        updateWagerTarget();
        updateWagerUI();
        return false;
    }

    // ============================================================
    // HANDLE RAIN EVENT - WITH InsufficientEntries FIX
    // ============================================================
    function handleRainEvent(rainData) {
        const potId = rainData.id;
        const totalAmount = parseFloat(rainData.totalUsdAmount || 0);
        const participants = rainData.participantCount || 0;

        if (rainState.joinedRains.has(potId)) {
            return;
        }

        // Check current entries
        const currentWager = wagerState.wagered || 0;
        const entries = Math.floor(currentWager / 33.33);
        const maxEntries = Math.min(3, entries);
        
        addLog('[RAIN] 💰 Joining rain: $' + totalAmount.toFixed(2) + ' (' + participants + ' players)', '#ff922b', '[R]');
        addLog('[RAIN] 📊 Current entries: ' + maxEntries + '/3 (Wager: $' + currentWager.toFixed(2) + ')', '#ffd700', '[R]');

        // If no entries, try to get at least 1
        if (entries < 1) {
            addLog('[RAIN] ⚠️ No entries! Auto wagering for 1 entry...', '#ff922b', '[R]');
            autoWagerForRainEntries().then((success) => {
                if (success) {
                    setTimeout(() => {
                        if (rainState.isRunning) {
                            addLog('[RAIN] 🔄 Retrying join with 1 entry...', '#60a5fa', '[R]');
                            handleRainEvent(rainData);
                        }
                    }, randomDelay(1000, 3000));
                } else {
                    rainState.failCount++;
                    addLog('[RAIN] ❌ Failed to get entry', '#ff6b6b', '[R]');
                    updateRainUI();
                }
            });
            return;
        }

        // Try to join with current entries
        setTimeout(() => {
            joinRainDirect(potId).then(result => {
                // Handle InsufficientEntries
                if (result.reason === 'InsufficientEntries') {
                    addLog('[RAIN] 🔄 Still insufficient entries, trying to get more...', '#ff922b', '[R]');
                    
                    autoWagerForRainEntries().then((success) => {
                        if (success) {
                            const newEntries = Math.floor((wagerState.wagered || 0) / 33.33);
                            addLog('[RAIN] ✅ New entries: ' + Math.min(3, newEntries) + '/3', '#4ade80', '[R]');
                            
                            setTimeout(() => {
                                if (rainState.isRunning) {
                                    addLog('[RAIN] 🔄 Retrying join...', '#60a5fa', '[R]');
                                    joinRainDirect(potId).then(retryResult => {
                                        if (retryResult.joined === true) {
                                            rainState.successCount++;
                                            rainState.joinedRains.add(potId);
                                            addLog('[RAIN] ✅ Successfully joined after auto wager!', '#4ade80', '[R]');
                                            updateRainUI();
                                        } else {
                                            rainState.failCount++;
                                            addLog('[RAIN] ❌ Still failed: ' + (retryResult.reason || 'Unknown'), '#ff6b6b', '[R]');
                                            updateRainUI();
                                        }
                                    });
                                }
                            }, randomDelay(1000, 3000));
                        } else {
                            rainState.failCount++;
                            addLog('[RAIN] ❌ Failed to get entries', '#ff6b6b', '[R]');
                            updateRainUI();
                        }
                    });
                    return;
                }

                // Handle other results
                if (result.joined === true) {
                    rainState.successCount++;
                    rainState.joinedRains.add(potId);
                    const entriesCount = Math.floor((wagerState.wagered || 0) / 33.33);
                    addLog('[RAIN] ✅ Successfully joined! (Entries: ' + Math.min(3, entriesCount) + '/3)', '#4ade80', '[R]');
                    updateRainUI();
                    
                    sendTelegramNotification('RAIN_JOINED', 
                        '🌧️ Joined rain!\n' +
                        '💰 Amount: $' + totalAmount.toFixed(2) + '\n' +
                        '👥 Participants: ' + participants + '\n' +
                        '📊 Entries: ' + Math.min(3, entriesCount) + '/3'
                    );
                    return;
                }

                // Already joined
                if (result.alreadyJoined === true) {
                    rainState.joinedRains.add(potId);
                    addLog('[RAIN] ℹ️ Already joined this rain', '#ff922b', '[R]');
                    return;
                }

                // Other failures
                rainState.failCount++;
                addLog('[RAIN] ❌ Failed: ' + (result.reason || 'Unknown reason'), '#ff6b6b', '[R]');
                updateRainUI();
            });
        }, randomDelay(500, 2000));
    }

    // ============================================================
    // CHECK RAIN PAYOUT + FORCE RESTART - TANPA NAVIGASI
    // ============================================================
    async function checkRainPayoutAndRestart() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'UserActivities',
                    query: `
                        query UserActivities($filters: UserActivityFilters, $first: Int) {
                            userActivities(filters: $filters, first: $first) {
                                edges {
                                    node {
                                        id
                                        type
                                        status
                                        time
                                        usdAmount
                                        amount {
                                            smallestUnits
                                            currencyCode
                                        }
                                    }
                                }
                            }
                        }
                    `,
                    variables: {
                        filters: { category: "REWARDS" },
                        first: 5
                    }
                })
            });

            const data = await response.json();
            const activities = data?.data?.userActivities?.edges || [];

            const now = Date.now();
            const fiveMinutesAgo = now - (5 * 60 * 1000);

            let foundPayout = false;
            let payoutAmount = 0;
            let payoutTime = null;

            for (let edge of activities) {
                const node = edge.node;
                if (node.type === 'RAIN_PAYOUT' && node.status === 'FINALIZED') {
                    const payoutTimeNode = new Date(node.time).getTime();
                    if (payoutTimeNode > fiveMinutesAgo) {
                        foundPayout = true;
                        payoutAmount = parseFloat(node.usdAmount);
                        payoutTime = node.time;
                        break;
                    }
                }
            }

            if (foundPayout) {
                addLog('YOU WON! +' + payoutAmount.toFixed(2) + ' USD', '#ffd700', '[WIN]');
                updatePayoutUI({ win: true, usdAmount: payoutAmount, time: payoutTime });
                sendTelegramNotification('RAIN_WIN', '🎉 You won $' + payoutAmount.toFixed(2) + ' USD from rain!');
            } else {
                addLog('No payout found (lost or didn\'t join)', '#888', '[INFO]');
                updatePayoutUI({ win: false });
            }

            addLog('Stopping bot for fresh start...', '#60a5fa', '[R]');

            if (wagerState.isRunning) {
                stopWagerBot();
                wagerState.isRunning = false;
                wagerState.isPaused = false;
            }

            if (rainState.isRunning) {
                rainState.isRunning = false;
                if (rainState.scheduledTimeout) {
                    clearTimeout(rainState.scheduledTimeout);
                    rainState.scheduledTimeout = null;
                }
                stopRainTimer();
                stopChatRefreshLoop();
                rainState.joinedRains = new Set();
                rainState.successCount = 0;
                rainState.failCount = 0;
                fishingDone = false;
                fishingTotalBets = 0;
                updateFishingUI(false, 'Pending');
                updateRainUI();
            }

            await sleep(randomDelay(1500, 4000));

            if (prevWagerRunning) {
                addLog('Restarting wager...', '#4ade80', '[R]');
                startWagerBot();
            }
            if (prevRainRunning) {
                addLog('Restarting rain...', '#4ade80', '[R]');
                rainState.isRunning = false;
                rainState.joinedRains = new Set();
                rainState.successCount = 0;
                rainState.failCount = 0;
                fishingDone = false;
                fishingTotalBets = 0;
                updateFishingUI(false, 'Pending');
                startRainBot();
            }

            addLog('Bot force restarted!', '#4ade80', '[OK]');

            return { win: foundPayout, amount: payoutAmount };

        } catch(e) {
            addLog('Payout check error: ' + e.message, '#f87171', '[ERR]');

            addLog('Restarting bot (error recovery)...', '#60a5fa', '[R]');
            if (wagerState.isRunning) stopWagerBot();
            if (rainState.isRunning) {
                rainState.isRunning = false;
                stopRainTimer();
                stopChatRefreshLoop();
                rainState.joinedRains = new Set();
                rainState.successCount = 0;
                rainState.failCount = 0;
                updateRainUI();
            }
            await sleep(randomDelay(2000, 5000));
            if (prevWagerRunning) startWagerBot();
            if (prevRainRunning) startRainBot();

            return { win: false, error: e.message };
        }
    }

