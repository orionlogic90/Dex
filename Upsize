            if (e.ctrlKey && e.shiftKey && e.key === 'D') {
                e.preventDefault();
                const ui = document.getElementById('dicey-bot-ui');
                if (ui) ui.style.display = ui.style.display === 'none' ? 'block' : 'none';
            }
            if (e.key === 'Enter' && e.ctrlKey) {
                e.preventDefault();
                if (simpleState.running) stopSimpleWager();
                else startSimpleWager();
            }
            if (e.key === ' ' && e.ctrlKey) {
                e.preventDefault();
                pauseSimpleWager();
            }
        });

        // ============================================================
        // UPDATE FUNCTIONS
        // ============================================================
        async function updateBalanceUI() {
            const balance = await fetchBalance();
            const el = document.getElementById('dicey-balance-display');
            if (el) {
                el.textContent = balance.toFixed(4);
                el.style.color = balance > 0.1 ? '#4ade80' : '#ff922b';
            }
            const currencyEl = document.getElementById('dicey-balance-currency');
            if (currencyEl) currencyEl.textContent = getCurrency();
            simpleState.currentBalance = balance;
        }

        // ============================================================
        // INIT
        // ============================================================
        setTimeout(updateBalanceUI, 500);
        setTimeout(updateSimpleUI, 800);
        setTimeout(updateRainUI, 900);

        setInterval(updateBalanceUI, 30000);
        setInterval(updateSimpleUI, 1000);
        setInterval(() => {
            if (rainState.isRunning) {
                fetchRainSchedule().then(updateRainUI);
            }
        }, 5000);

        addLog('🎲 DiceY Engine v8 READY', '#9ec07c', '[I]');
        addLog('📊 Wager: 3 modes | D\'Alembert Hybrid recovery', '#4ade80', '[I]');
        addLog('🌧️ Rain: Auto join + auto wager for entries', '#60a5fa', '[I]');
        addLog('⌨️ Ctrl+Enter: Start/Stop | Ctrl+Space: Pause', '#888', '[I]');

        console.log('🎲 DiceY Engine v8 READY');
        console.log('📊 Wager: AMAN/CEPAT/EXTREME');
        console.log('🔄 Recovery: D\'Alembert Hybrid (2.02x → 1.3x)');
        console.log('🌧️ Rain: Auto join + auto wager');
        console.log('⌨️ Ctrl+Enter: Start/Stop | Ctrl+Space: Pause');
    }

    // ============================================================
    // START
    // ============================================================
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', buildUI);
    } else {
        buildUI();
    }

})();
