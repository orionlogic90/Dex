    // ============================================================
    // LOAD PRESET
    // ============================================================

    function loadPreset(presetKey) {
        if (!PRESETS[presetKey]) {
            addLog(`[PRESET] Preset "${presetKey}" not found`, '#ff6b6b', '[❌]');
            return;
        }
        
        switchState.currentPreset = presetKey;
        switchState.layer = 1;
        switchState.gameIndex = 0;
        switchState.cycleCount = 0;
        switchState.totalBetsInLayer = 0;
        switchState.layerProfit = 0;
        switchState.isInRecovery = false;
        switchState.winStreak = 0;
        switchState.lossStreak = 0;
        switchState.gameStats = {};
        
        const preset = PRESETS[presetKey];
        
        const presetSelect = document.getElementById('dicey-preset-select');
        if (presetSelect) presetSelect.value = presetKey;
        
        const returnCondition = document.getElementById('dicey-return-condition');
        if (returnCondition) returnCondition.value = preset.backToL1.condition || 'streak';
        
        const returnValue = document.getElementById('dicey-return-value');
        if (returnValue) {
            returnValue.value = preset.backToL1.condition === 'streak' ? 
                preset.backToL1.streak : 
                preset.backToL1.profit;
        }
        
        const targetWagered = document.getElementById('dicey-switch-target-wagered');
        if (targetWagered) targetWagered.value = preset.target.wagered;
        
        const targetProfit = document.getElementById('dicey-switch-target-profit');
        if (targetProfit) targetProfit.value = preset.target.profit;
        
        const stopLoss = document.getElementById('dicey-switch-stop-loss');
        if (stopLoss) stopLoss.value = preset.target.stopLoss;
        
        const l2Multiplier = document.getElementById('dicey-switch-l2-multiplier');
        if (l2Multiplier) l2Multiplier.value = preset.layer2.multiplier;
        
        const chanceInc = document.getElementById('dicey-switch-chance-inc');
        if (chanceInc) chanceInc.value = preset.layer2.chanceIncrement;
        
        const maxChance = document.getElementById('dicey-switch-max-chance');
        if (maxChance) maxChance.value = preset.layer2.maxChance;
        
        renderGameSlots();
        updateSwitchUI();
        
        addLog(`[PRESET] Loaded: ${preset.name}`, '#4ade80', '[📋]');
        addLog(`[PRESET] L1: ${preset.layer1.games.map(g => g.game).join(' → ')}`, '#9ec07c', '[📋]');
        addLog(`[PRESET] L2: ${preset.layer2.games.map(g => g.game).join(' → ')}`, '#ff922b', '[📋]');
    }

    function savePreset() {
        const presetName = document.getElementById('dicey-preset-select')?.value || 'CUSTOM';
        
        const l1Games = readGameSlotsFromContainer('dicey-l1-games');
        const l2Games = readGameSlotsFromContainer('dicey-l2-games');
        
        if (l1Games.length === 0 || l2Games.length === 0) {
            addLog('[PRESET] No games configured!', '#ff6b6b', '[❌]');
            return;
        }
        
        const preset = {
            name: `📝 ${presetName}`,
            description: 'Custom configuration',
            layer1: { 
                games: l1Games, 
                switchMode: 'cycle' 
            },
            layer2: { 
                games: l2Games, 
                multiplier: parseFloat(document.getElementById('dicey-switch-l2-multiplier')?.value) || 1.5,
                chanceIncrement: parseFloat(document.getElementById('dicey-switch-chance-inc')?.value) || 1.0,
                maxChance: parseFloat(document.getElementById('dicey-switch-max-chance')?.value) || 99
            },
            backToL1: { 
                condition: document.getElementById('dicey-return-condition')?.value || 'streak',
                streak: parseInt(document.getElementById('dicey-return-value')?.value) || 3,
                profit: parseFloat(document.getElementById('dicey-return-value')?.value) || 0.05
            },
            target: {
                wagered: parseFloat(document.getElementById('dicey-switch-target-wagered')?.value) || 33.33,
                profit: parseFloat(document.getElementById('dicey-switch-target-profit')?.value) || 0.50,
                stopLoss: parseFloat(document.getElementById('dicey-switch-stop-loss')?.value) || 1.00
            }
        };
        
        try {
            localStorage.setItem('dicey_custom_preset', JSON.stringify(preset));
            addLog(`[PRESET] Custom preset "${presetName}" saved!`, '#ffd700', '[💾]');
        } catch(e) {
            addLog(`[PRESET] Save failed: ${e.message}`, '#ff6b6b', '[❌]');
        }
    }

    function readGameSlotsFromContainer(containerId) {
        const container = document.getElementById(containerId);
        if (!container) return [];
        
        const games = [];
        const slots = container.querySelectorAll('.game-slot');
        
        slots.forEach(slot => {
            const gameSelect = slot.querySelector('.game-select');
            const betInput = slot.querySelector('.bet-input');
            const cycleInput = slot.querySelector('.cycle-input');
            
            if (!gameSelect || !betInput || !cycleInput) return;
            
            const gameType = gameSelect.value;
            const game = {
                game: gameType,
                bet: parseFloat(betInput.value) || 0.01,
                cycle: parseInt(cycleInput.value) || 50
            };
            
            if (gameType === 'DICE') {
                const chanceInput = slot.querySelector('.chance-input');
                game.chance = parseFloat(chanceInput?.value) || 98;
            } else if (gameType === 'KENO') {
                const riskSelect = slot.querySelector('.risk-select');
                game.risk = riskSelect?.value || 'Low';
            } else if (gameType === 'PLINKO') {
                const riskSelect = slot.querySelector('.risk-select');
                const rowsInput = slot.querySelector('.rows-input');
                game.risk = riskSelect?.value || 'Low';
                game.rows = parseInt(rowsInput?.value) || 8;
            } else if (gameType === 'LIMBO') {
                const targetInput = slot.querySelector('.target-input');
                game.targetMultiplier = parseFloat(targetInput?.value) || 2;
            }
            
            games.push(game);
        });
        
        return games;
    }

    // ============================================================
    // START SWITCH WAGER
    // ============================================================

    function startSwitchWager() {
        if (!isLicensed) {
            addLog('[!] License required!', '#f87171', '[!]');
            return;
        }
        
        if (wagerState.isRunning && !wagerState.isPaused) {
            addLog('[!] Already running', '#ffd700', '[!]');
            return;
        }
        
        if (wagerState.isPaused) {
            wagerState.isPaused = false;
            wagerState.isRunning = true;
            addLog('[RESUME] Switch wager', '#00e5c0', '[R]');
            updateWagerUI();
            setTimeout(executeSwitchWager, randomDelay(100, 500));
            return;
        }
        
        const preset = getCurrentPreset();
        const firstGame = preset.layer1.games[0];
        
        wagerState.isRunning = true;
        wagerState.isPaused = false;
        wagerState.totalBets = 0;
        wagerState.totalWins = 0;
        wagerState.totalLosses = 0;
        wagerState.wagered = 0;
        wagerState.currentLayer = 1;
        wagerState.currentBet = firstGame.bet;
        wagerState.lossRecovery = 0;
        wagerState.isLooping = false;
        
        switchState.layer = 1;
        switchState.gameIndex = 0;
        switchState.cycleCount = 0;
        switchState.totalBetsInLayer = 0;
        switchState.layerProfit = 0;
        switchState.isInRecovery = false;
        switchState.winStreak = 0;
        switchState.lossStreak = 0;
        switchState.gameStats = {};
        
        const realBalance = getRealBalance();
        if (realBalance !== null && realBalance > 0) {
            wagerState.currentBalance = realBalance;
            wagerState.startBalance = realBalance;
        } else {
            wagerState.currentBalance = 3;
            wagerState.startBalance = 3;
        }
        wagerState.entryBalance = wagerState.currentBalance;
        
        wagerState.startTime = Date.now();
        if (wagerState.timerInterval) clearInterval(wagerState.timerInterval);
        wagerState.timerInterval = setInterval(updateWagerTimer, 1000);
        
        prevWagerRunning = true;
        
        const gameNames = preset.layer1.games.map(g => g.game).join(' → ');
        addLog(`[START] Switch Game: ${gameNames}`, '#4ade80', '[S]');
        addLog(`[TARGET] Wagered: ${preset.target.wagered} ${getCurrency()}`, '#ffd700', '[T]');
        addLog(`[TARGET] Profit: ${preset.target.profit} | Stop Loss: ${preset.target.stopLoss}`, '#ffd700', '[T]');
        updateWagerUI();
        updateSwitchUI();
        
        sendTelegramNotification('WAGER_START', 
            `🎮 Switch Game Strategy\n` +
            `L1: ${preset.layer1.games.map(g => g.game).join(' → ')}\n` +
            `L2: ${preset.layer2.games.map(g => g.game).join(' → ')}\n` +
            `Target: $${preset.target.wagered} wagered`
        );
        
        setTimeout(executeSwitchWager, randomDelay(200, 600));
    }

