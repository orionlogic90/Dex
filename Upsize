                stopBot();
                simpleState.isLooping = false;
                return;
            }
            simpleState.currentBalance = balance;
            
            const mode = WAGER_MODES[simpleState.mode];
            const betAmount = mode.bet;
            const chance = 98;
            
            const result = await placeDiceBet(betAmount, chance);
            
            if (result.success) {
                const data = result.data;
                const profit = parseFloat(data.profit) || 0;
                const isWin = data.isWin;
                
                simpleState.wagered += betAmount;
                simpleState.currentBalance += profit;
                simpleState.profit += profit;
                simpleState.totalBets++;
                
                if (isWin) {
                    simpleState.wins++;
                    simpleState.currentStreak = simpleState.currentStreak > 0 ? simpleState.currentStreak + 1 : 1;
                    addLog('✅ DICE 98% ' + betAmount.toFixed(3) + ' | +' + profit.toFixed(4) + ' | ' + simpleState.wagered.toFixed(2) + '/' + simpleState.target, '#4ade80', '[W]');
                } else {
                    simpleState.losses++;
                    simpleState.currentStreak = simpleState.currentStreak < 0 ? simpleState.currentStreak - 1 : -1;
                    addLog('❌ DICE 98% ' + betAmount.toFixed(3) + ' | ' + profit.toFixed(4) + ' | ' + simpleState.wagered.toFixed(2) + '/' + simpleState.target, '#ff6b6b', '[L]');
                    
                    simpleState.isLooping = false;
                    recoveryState.recovered = false;
                    recoveryState.active = false;
                    await handleRecoveryMode();
                    simpleState.isLooping = true;
                }
                
                updateUI();
            }
            
        } catch (e) {
            addLog('❌ Error: ' + e.message, '#ff6b6b', '[❌]');
        }
        
        simpleState.isLooping = false;
        setTimeout(mainLoop, 100 + Math.random() * 200);
    }

    // ============================================================
    // CONTROLS
    // ============================================================
    function startBot() {
        if (simpleState.running && !simpleState.paused) {
            addLog('⚠️ Already running', '#ff922b', '[⚠️]');
            return;
        }
        
        if (!simpleState.running) {
            const targetInput = document.getElementById('simple-target');
            const modeSelect = document.getElementById('simple-mode');
            
            simpleState.target = parseFloat(targetInput?.value) || 33.33;
            simpleState.mode = modeSelect?.value || 'AMAN';
            simpleState.wagered = 0;
            simpleState.profit = 0;
            simpleState.totalBets = 0;
            simpleState.wins = 0;
            simpleState.losses = 0;
            simpleState.currentStreak = 0;
            simpleState.startBalance = simpleState.currentBalance;
            simpleState.startTime = Date.now();
            recoveryState.recovered = false;
            recoveryState.active = false;
            
            addLog('▶️ START | Target: ' + simpleState.target + ' | Mode: ' + WAGER_MODES[simpleState.mode].name, '#4ade80', '[▶️]');
        }
        
        if (simpleState.paused) {
            simpleState.paused = false;
            addLog('▶️ RESUMED', '#4ade80', '[▶️]');
        }
        
        simpleState.running = true;
        
        if (simpleState.timerInterval) {
            clearInterval(simpleState.timerInterval);
        }
        simpleState.timerInterval = setInterval(updateUI, 1000);
        
        updateUI();
        mainLoop();
    }

    function pauseBot() {
        if (!simpleState.running) {
            addLog('⚠️ Bot not running', '#ff922b', '[⚠️]');
            return;
        }
        simpleState.paused = !simpleState.paused;
        addLog(simpleState.paused ? '⏸️ PAUSED' : '▶️ RESUMED', '#ff922b', simpleState.paused ? '[⏸️]' : '[▶️]');
        updateUI();
    }

    function stopBot() {
        simpleState.running = false;
        simpleState.paused = false;
        simpleState.isLooping = false;
        recoveryState.active = false;
        recoveryState.recovered = false;
        
        if (simpleState.timerInterval) {
            clearInterval(simpleState.timerInterval);
