    // ============================================================
    // RECOVERY HANDLER - D'ALEMBERT (DICE 49.5% → 75%)
    // ============================================================
    async function handleRecoveryMode() {
        const baseBetInput = document.getElementById('recovery-base-bet');
        const unitInput = document.getElementById('recovery-unit');
        
        let baseBet = parseFloat(baseBetInput?.value) || 0.01;
        let unit = parseFloat(unitInput?.value) || 0.01;
        
        const maxBetInput = document.getElementById('recovery-max-bet');
        let maxBet = parseFloat(maxBetInput?.value) || 0.10;
        
        recoveryState.active = true;
        recoveryState.bet = baseBet;
        recoveryState.lossCount = 0;
        recoveryState.consecutiveLoss = 0;
        recoveryState.isSafeMode = false;
        recoveryState.chance = 49.5;
        recoveryState.safeChance = 75;
        recoveryState.recovered = false;
        recoveryState.baseBet = baseBet;
        recoveryState.unit = unit;
        recoveryState.maxBet = maxBet;
        recoveryState.hasPlacedBet = false;
        
        addLog('🔄 Recovery: DICE 49.5% → 75% (2 losses)', '#ff922b', '[🔄]');
        addLog('[REC] Base: ' + baseBet.toFixed(4) + ' | Unit: ' + unit.toFixed(4) + ' | Max: ' + maxBet.toFixed(4), '#60a5fa', '[📊]');
        
        let maxAttempts = 30;
        let attempts = 0;
        let recovered = false;
        
        while (recoveryState.active && attempts < maxAttempts && !recovered) {
            attempts++;
            
            if (recoveryState.hasPlacedBet) {
                if (recoveryState.bet <= recoveryState.baseBet && recoveryState.lossCount <= 0) {
                    recovered = true;
                    addLog('✅ Recovery complete! Back to L1', '#4ade80', '[✅]');
                    recoveryState.active = false;
                    recoveryState.recovered = false;
                    return;
                }
            }
            
            if (!recoveryState.isSafeMode && recoveryState.consecutiveLoss >= 2) {
                recoveryState.isSafeMode = true;
                recoveryState.chance = 75;
                addLog('🔄 2 losses → SWITCH to 75%', '#60a5fa', '[🔄]');
            }
            
            if (recoveryState.bet > recoveryState.maxBet) {
                addLog('🚨 Max bet reached, resetting', '#ff6b6b', '[🚨]');
                recoveryState.active = false;
                recoveryState.recovered = false;
                return;
            }
            
            addLog('[REC] 📤 DICE ' + recoveryState.chance + '% | Bet: ' + recoveryState.bet.toFixed(4), '#60a5fa', '[📤]');
            const result = await placeDiceBet(recoveryState.bet, recoveryState.chance);
            
            recoveryState.hasPlacedBet = true;
            
            if (result.success) {
                const data = result.data;
                const isWin = data.isWin;
                const profit = parseFloat(data.profit) || 0;
                
                simpleState.wagered += recoveryState.bet;
                simpleState.currentBalance += profit;
                simpleState.profit += profit;
                simpleState.totalBets++;
                
                if (isWin) {
                    recoveryState.bet = Math.max(recoveryState.baseBet, recoveryState.bet - recoveryState.unit);
                    recoveryState.lossCount = Math.max(0, recoveryState.lossCount - 1);
                    recoveryState.consecutiveLoss = 0;
                    addLog('[REC] ✅ WIN | Bet: ' + recoveryState.bet.toFixed(4), '#4ade80', '[W]');
                } else {
                    recoveryState.bet = Math.min(recoveryState.maxBet, recoveryState.bet + recoveryState.unit);
                    recoveryState.lossCount++;
                    recoveryState.consecutiveLoss++;
                    addLog('[REC] ❌ LOSS | Bet: ' + recoveryState.bet.toFixed(4), '#ff6b6b', '[L]');
                }
                
                updateUI();
            } else {
                addLog('[REC] ❌ Error: ' + result.error, '#ff6b6b', '[❌]');
                await sleep(500);
                continue;
            }
            
            await sleep(100 + Math.random() * 200);
        }
        
        recoveryState.active = false;
        recoveryState.recovered = false;
    }

    // ============================================================
