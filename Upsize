    function updateSwitchUI() {
        const game = getCurrentGame();
        const layerLabel = switchState.layer === 1 ? 'LAYER 1' : 'LAYER 2';
        const gameDisplay = getGameDisplayName(game);
        const cycleInfo = `${switchState.cycleCount}/${game.cycle}`;
        const streakInfo = `W:${switchState.winStreak} L:${switchState.lossStreak}`;
        const profitInfo = switchState.layerProfit.toFixed(4);
        
        const statusEl = document.getElementById('dicey-switch-status');
        if (statusEl) {
            statusEl.textContent = `${layerLabel} | ${gameDisplay} | ${cycleInfo} | ${streakInfo} | P:${profitInfo}`;
            statusEl.style.color = switchState.isInRecovery ? '#ff922b' : '#4ade80';
        }
        
        const statsEl = document.getElementById('dicey-game-stats');
        if (statsEl) {
            const stats = switchState.gameStats;
            let html = '';
            let totalBets = 0;
            let totalWins = 0;
            
            for (const key in stats) {
                const s = stats[key];
                totalBets += s.bets;
                totalWins += s.wins;
                const wr = s.bets > 0 ? ((s.wins / s.bets) * 100).toFixed(1) : 0;
                html += `<span style="margin-right:8px;font-size:7px;">${s.game}: ${s.bets}b | ${wr}% | ${(s.profit >= 0 ? '+' : '') + s.profit.toFixed(4)}</span>`;
            }
            const totalWr = totalBets > 0 ? ((totalWins / totalBets) * 100).toFixed(1) : 0;
            html = `<span style="color:#666;font-size:7px;">Total: ${totalBets}b | ${totalWr}%</span> | ` + html;
            statsEl.innerHTML = html;
        }
        
        const presetEl = document.getElementById('dicey-preset-name');
        if (presetEl) {
            const preset = getCurrentPreset();
            presetEl.textContent = preset.name;
            presetEl.style.color = '#ffd700';
        }
