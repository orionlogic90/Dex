    async function sendAuthPasscode(email) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com',
                    'User-Agent': navigator.userAgent
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'SendAuthPasscode',
                    query: `
                        mutation SendAuthPasscode($input: SendPasscodeInput!) {
                            sendAuthPasscode(input: $input) {
                                success
                                methodId
                                error
                                __typename
                            }
                        }
                    `,
                    variables: {
                        input: {
                            email: email
                        }
                    }
                })
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }

            const result = data?.data?.sendAuthPasscode;
            if (result?.success) {
                addLog('[AUTH] ✅ Passcode sent to ' + email, '#4ade80', '[🔐]');
                if (result.methodId) {
                    localStorage.setItem('dicey_auth_method_id', result.methodId);
                }
                return { 
                    success: true, 
                    methodId: result.methodId,
                    error: result.error 
                };
            } else {
                addLog('[AUTH] ❌ Failed to send passcode: ' + (result?.error || 'Unknown error'), '#ff6b6b', '[❌]');
                return { 
                    success: false, 
                    error: result?.error || 'Unknown error' 
                };
            }

        } catch(e) {
            addLog('[AUTH] ❌ Error sending passcode: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false, error: e.message };
        }
    }

    async function verifyPasscode(code, methodId) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'Origin': 'https://dicey.com',
                    'User-Agent': navigator.userAgent
                },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'VerifyPasscode',
                    query: `
                        mutation VerifyPasscode($input: VerifyPasscodeInput!) {
                            verifyPasscode(input: $input) {
                                success
                                isNewUser
                                mfaRequired
                                __typename
                            }
                        }
                    `,
                    variables: {
                        input: {
                            code: code,
                            methodId: methodId
                        }
                    }
                })
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const data = await response.json();
            if (data.errors) {
                throw new Error(data.errors[0].message);
            }

            const result = data?.data?.verifyPasscode;
            if (result?.success) {
                addLog('[AUTH] ✅ Passcode verified successfully!', '#4ade80', '[✅]');
                localStorage.setItem('dicey_auth_verified', 'true');
                return { 
                    success: true, 
                    isNewUser: result.isNewUser,
                    mfaRequired: result.mfaRequired
                };
            } else {
                addLog('[AUTH] ❌ Invalid passcode', '#ff6b6b', '[❌]');
                return { success: false, error: 'Invalid passcode' };
            }

        } catch(e) {
            addLog('[AUTH] ❌ Error verifying passcode: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false, error: e.message };
        }
    }

    async function autoLoginWithPasscode(email, code) {
        try {
            addLog('[AUTH] 🔄 Starting auto login...', '#60a5fa', '[🔐]');
            
            const sendResult = await sendAuthPasscode(email);
            if (!sendResult.success) {
                addLog('[AUTH] ❌ Failed to send passcode: ' + sendResult.error, '#ff6b6b', '[❌]');
                return { success: false, error: sendResult.error };
            }

            await sleep(randomDelay(2000, 5000));

            const verifyResult = await verifyPasscode(code, sendResult.methodId);
            if (!verifyResult.success) {
                addLog('[AUTH] ❌ Failed to verify passcode', '#ff6b6b', '[❌]');
                return { success: false, error: 'Invalid passcode' };
            }

            addLog('[AUTH] ✅ Login successful!', '#4ade80', '[✅]');
            
            localStorage.setItem('dicey_auth_email', email);
            localStorage.setItem('dicey_auth_code', code);
            
            const statusEl = document.getElementById('dicey-auth-status');
            if (statusEl) {
                statusEl.textContent = '✅ Logged in';
                statusEl.style.color = '#4ade80';
            }
            
            const userEl = document.getElementById('dicey-auth-user');
            if (userEl) {
                userEl.textContent = '👤 ' + email;
                userEl.style.color = '#4ade80';
            }
            
            await updateUserInfo();
            
            return { 
                success: true, 
                isNewUser: verifyResult.isNewUser,
                mfaRequired: verifyResult.mfaRequired
            };

        } catch(e) {
            addLog('[AUTH] ❌ Auto login error: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false, error: e.message };
        }
    }

