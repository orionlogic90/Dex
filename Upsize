    function renderGameSlots() {
        const preset = getCurrentPreset();
        renderGameSlotsWithData('dicey-l1-games', preset.layer1.games, 'L1');
        renderGameSlotsWithData('dicey-l2-games', preset.layer2.games, 'L2');
