    // ============================================================
    // UPDATE ENTRIES UI
    // ============================================================
    function updateEntriesUI() {
        const currentWager = wagerState.wagered || 0;
        const entries = Math.floor(currentWager / 33.33);
        const maxEntries = Math.min(3, entries);
        const progress = Math.min((currentWager / 33.33) * 100, 100);
        
        // Update entries display in rain timer
        const entriesEl = document.getElementById('dicey-rain-entries');
        if (entriesEl) {
            entriesEl.textContent = 'Entries: ' + maxEntries + '/3 (Wager: $' + currentWager.toFixed(2) + ')';
            if (maxEntries >= 3) {
                entriesEl.style.color = '#4ade80';
            } else if (maxEntries >= 1) {
                entriesEl.style.color = '#ffd700';
            } else {
                entriesEl.style.color = '#ff6b6b';
            }
        }
        
        // Update entries progress bar
        const entriesBar = document.getElementById('dicey-entries-bar');
        if (entriesBar) {
            entriesBar.style.width = Math.min(progress, 100) + '%';
            if (progress >= 100) {
                entriesBar.style.background = 'linear-gradient(90deg, #4ade80, #00e5c0)';
            } else if (progress >= 33.33) {
                entriesBar.style.background = 'linear-gradient(90deg, #ffd700, #ff922b)';
            } else {
                entriesBar.style.background = '#ff6b6b';
            }
        }
    }

    // ============================================================
    // REWARDS MODULE
    // ============================================================
    async function fetchRakebackStatus() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'GetUserRakeback',
                    query: `
                        query GetUserRakeback {
                            userRakeback {
                                balances {
                                    currency
                                    balance {
                                        currencyCode
                                        smallestUnits
                                    }
                                }
                                totalValueUsd
                            }
                        }
                    `
                })
            });
            const data = await response.json();
            return data?.data?.userRakeback || null;
        } catch(e) {
            return null;
        }
    }

    async function fetchFreeSpins() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'MyFreespins',
                    query: `
                        query MyFreespins($filter: MyFreespinsFilter) {
                            myFreespins(filter: $filter) {
                                issueId
                                freespinsQuantity
                                status
                            }
                        }
                    `,
                    variables: { filter: { statuses: ["Issued"] } }
                })
            });
            const data = await response.json();
            return data?.data?.myFreespins || [];
        } catch(e) {
            return [];
        }
    }

    async function fetchTotalRewards() {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'GetTotalRewards',
                    query: `
                        query GetTotalRewards {
                            totalRewards {
                                totalRakebackClaimedUsd
                                totalAllRewardsUsd
                            }
                        }
                    `
                })
            });
            const data = await response.json();
            return data?.data?.totalRewards || null;
        } catch(e) {
            return null;
        }
    }

    async function claimRakeback(currency) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'ClaimRakeback',
                    query: `
                        mutation ClaimRakeback($currency: PlatformCurrency!) {
                            claimRakeback(currency: $currency) {
                                amount {
                                    currencyCode
                                    smallestUnits
                                }
                            }
                        }
                    `,
                    variables: { currency: currency }
                })
            });
            const data = await response.json();
            const amount = data?.data?.claimRakeback?.amount;
            if (amount) {
                const value = amount.smallestUnits / 1000000;
                addLog('[CLAIM] Rakeback: ' + value.toFixed(4) + ' ' + amount.currencyCode, '#4ade80', '[💰]');
                return { success: true, amount: value };
            }
            return { success: false };
        } catch(e) {
            addLog('[CLAIM] Rakeback error: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false };
        }
    }

    async function claimFreespins(issueId) {
        try {
            const response = await fetch('https://api.dicey.com/graphql', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'include',
                body: JSON.stringify({
                    operationName: 'ClaimFreespins',
                    query: `
                        mutation ClaimFreespins($issueId: ID!) {
                            claimFreespins(issueId: $issueId) {
                                status
                                freespinsQuantity
                            }
                        }
                    `,
                    variables: { issueId: issueId }
                })
            });
            const data = await response.json();
            const result = data?.data?.claimFreespins;
            if (result && result.status === 'SUCCESS') {
                addLog('[CLAIM] ' + result.freespinsQuantity + ' Free Spins!', '#ffd700', '[🎰]');
                return { success: true, quantity: result.freespinsQuantity };
            }
            return { success: false };
        } catch(e) {
            addLog('[CLAIM] Free spins error: ' + e.message, '#ff6b6b', '[❌]');
            return { success: false };
        }
    }

    // ============================================================
    // REWARDS UI UPDATE
    // ============================================================
    async function updateRewardsUI() {
        try {
            const rakeback = await fetchRakebackStatus();
            const rakebackEl = document.getElementById('dicey-rakeback-display');
            if (rakebackEl && rakeback) {
                const total = rakeback.balances?.reduce(function(sum, b) {
                    return sum + (b.balance.smallestUnits / 1000000);
                }, 0) || 0;
                rakebackEl.textContent = '$' + total.toFixed(4);
                rakebackEl.style.color = total > 0 ? '#4ade80' : '#666';
            }

            const rewards = await fetchTotalRewards();
            const totalEl = document.getElementById('dicey-total-rewards');
            if (totalEl && rewards) {
                totalEl.textContent = '$' + parseFloat(rewards.totalAllRewardsUsd || 0).toFixed(2);
            }

            const freespins = await fetchFreeSpins();
            const freespinsEl = document.getElementById('dicey-freespins-display');
            if (freespinsEl) {
                const count = freespins?.length || 0;
                freespinsEl.textContent = count;
                freespinsEl.style.color = count > 0 ? '#ffd700' : '#666';
            }

            const vip = await fetchVIPStatus();
            const vipProgressEl = document.getElementById('dicey-vip-progress');
            const vipPointsEl = document.getElementById('dicey-vip-points');
            if (vipProgressEl && vip) {
                vipProgressEl.style.width = Math.min(vip.progressPercent || 0, 100) + '%';
            }
            if (vipPointsEl && vip) {
                const points = parseFloat(vip.tierPoints || 0);
                const targets = [10000, 25000, 50000, 75000, 100000, 150000, 250000, 350000, 500000, 750000, 1000000];
                let nextTarget = 10000;
                for (var i = 0; i < targets.length; i++) {
                    if (points < targets[i]) {
                        nextTarget = targets[i];
                        break;
                    }
                }
                vipPointsEl.textContent = points.toFixed(0) + ' pts → ' + nextTarget.toLocaleString();
            }

        } catch(e) {
            console.error('Failed to update rewards UI:', e);
        }
    }

    // ============================================================
    // REWARDS - AUTO CLAIM
    // ============================================================
    let autoClaimEnabled = true;
    let autoClaimInterval = null;

    async function autoClaimAllRewards() {
        if (!isLicensed) {
            addLog('[!] License required for auto claim', '#f87171', '[!]');
            return;
        }

        if (!autoClaimEnabled) return;

        addLog('[CLAIM] Auto claim cycle...', '#60a5fa', '[🔄]');

        try {
            const rakeback = await fetchRakebackStatus();
            if (rakeback?.balances) {
                for (const balance of rakeback.balances) {
                    const amount = balance.balance.smallestUnits / 1000000;
                    if (amount > 0.0001) {
                        await claimRakeback(balance.currency);
                        await sleep(500);
                    }
                }
            }

            const freespins = await fetchFreeSpins();
            if (freespins && freespins.length > 0) {
                for (const spin of freespins) {
                    if (spin.status === 'issued') {
                        await claimFreespins(spin.issueId);
                        await sleep(800);
                    }
                }
            }

            await updateRewardsUI();

        } catch(e) {
            addLog('[CLAIM] Auto claim error: ' + e.message, '#ff6b6b', '[❌]');
        }
    }

    function toggleAutoClaim() {
        autoClaimEnabled = !autoClaimEnabled;
        const btn = document.getElementById('dicey-auto-claim-toggle');
        if (btn) {
            btn.textContent = autoClaimEnabled ? '🔄 AUTO: ON' : '🔄 AUTO: OFF';
            btn.style.background = autoClaimEnabled ? '#4ade80' : '#ff6b6b';
            btn.style.color = autoClaimEnabled ? '#000' : '#fff';
        }

        if (autoClaimEnabled) {
            if (autoClaimInterval) {
                clearInterval(autoClaimInterval);
            }
            autoClaimInterval = setInterval(autoClaimAllRewards, 60 * 60 * 1000);
            addLog('[CLAIM] Auto claim enabled (every 1 hour)', '#4ade80', '[🔄]');
        } else {
            if (autoClaimInterval) {
                clearInterval(autoClaimInterval);
                autoClaimInterval = null;
            }
            addLog('[CLAIM] Auto claim disabled', '#ff6b6b', '[⏹️]');
        }
    }

