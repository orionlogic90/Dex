        if (STATE.isDemo) {
            // Demo: simulasi
            var win = Math.random() * 100 < chance;
            var multiplier = win ? parseFloat((99 / chance).toFixed(4)) : 1;
            var profit = win ? apiAmount * multiplier - apiAmount : -apiAmount;
            STATE.balance += profit;
            if (STATE.balance < 0) STATE.balance = 0;
            return {
                diceRoll: {
                    amount: apiAmount,
                    payout: win ? apiAmount * multiplier : 0,
                    payoutMultiplier: multiplier,
                    win: win,
                    state: { result: Math.random() * 100, target: target, condition: "above" }
                }
            };
