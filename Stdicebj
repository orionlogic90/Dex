    // ==================== 4. BLACKJACK CARD UTILITY ====================
    function getCardValue(card) {
        if (!card || !card.rank) return 0;
        const rank = card.rank;
        if (['K', 'Q', 'J'].includes(rank)) return 10;
        if (rank === 'A') return 11;
        return parseInt(rank) || 0;
    }

    function getHandValue(cards) {
        if (!cards || cards.length === 0) return 0;
        let total = 0;
        let aces = 0;
        for (let c of cards) {
            const v = getCardValue(c);
            if (v === 11) aces++;
            total += v;
        }
        while (total > 21 && aces > 0) {
            total -= 10;
            aces--;
        }
        return total;
    }

    // ==================== 5. BASIC STRATEGY ====================
    function getHardAction(value, dealerValue) {
        if (value >= 17) return 'stand';
        if (value >= 13 && value <= 16) {
            if (dealerValue >= 7) return 'hit';
            return 'stand';
        }
        if (value === 12) {
            if (dealerValue >= 4 && dealerValue <= 6) return 'stand';
            return 'hit';
        }
        if (value === 11) {
            if (dealerValue === 11) return 'hit';
            return 'double';
        }
        if (value === 10) {
            if (dealerValue >= 10) return 'hit';
            return 'double';
        }
        if (value === 9) {
            if (dealerValue >= 3 && dealerValue <= 6) return 'double';
            return 'hit';
        }
        if (value <= 8) return 'hit';
        return 'hit';
    }

    function getSoftAction(value, dealerValue) {
        if (value >= 19) return 'stand';
        if (value === 18) {
            if (dealerValue >= 9) return 'hit';
            return 'stand';
        }
        if (value === 17) {
            if (dealerValue >= 3 && dealerValue <= 6) return 'double';
            return 'hit';
        }
        if (value === 16) {
            if (dealerValue >= 4 && dealerValue <= 6) return 'double';
            return 'hit';
        }
        if (value === 15) {
            if (dealerValue >= 4 && dealerValue <= 6) return 'double';
            return 'hit';
        }
        if (value === 14) {
            if (dealerValue === 5 || dealerValue === 6) return 'double';
            return 'hit';
        }
        if (value === 13) {
            if (dealerValue === 5 || dealerValue === 6) return 'double';
            return 'hit';
        }
        if (value <= 12) {
            if (dealerValue === 5 || dealerValue === 6) return 'double';
            return 'hit';
        }
        return 'hit';
    }

    function getPairAction(rank, dealerValue) {
        if (rank === 'A') return 'split';
        if (rank === 'K' || rank === 'Q' || rank === 'J' || rank === '10') return 'stand';
        if (rank === '9') {
            if (dealerValue === 7 || dealerValue === 10 || dealerValue === 11) return 'stand';
            return 'split';
        }
        if (rank === '8') return 'split';
        if (rank === '7') {
            if (dealerValue >= 8) return 'hit';
            return 'split';
        }
        if (rank === '6') {
            if (dealerValue >= 7) return 'hit';
            return 'split';
        }
        if (rank === '5') return 'double';
        if (rank === '4') {
            if (dealerValue === 5 || dealerValue === 6) return 'split';
            return 'hit';
        }
        if (rank === '3' || rank === '2') {
            if (dealerValue >= 8) return 'hit';
            return 'split';
        }
        return 'hit';
    }

    function getBlackjackAction(state) {
        if (!state || !state.player || !state.dealer) return 'stand';
        
        const player = state.player[0];
        const dealer = state.dealer[0];
        
        if (!player || !dealer || !player.cards || !dealer.cards) return 'stand';
        
        const actions = player.actions || [];
        
        if (!actions.includes('hit') && !actions.includes('double') && !actions.includes('split')) {
            return 'stand';
        }
        
        const playerValue = player.value || getHandValue(player.cards);
        const dealerCard = dealer.cards[0];
        const dealerValue = getCardValue(dealerCard);
        const isPair = player.cards.length === 2 && 
                       player.cards[0].rank === player.cards[1].rank;
        const hasAce = player.cards.some(c => c.rank === 'A');
        const rank = player.cards[0].rank;
        
        // PAIR SPLITTING
        if (isPair && actions.includes('split')) {
            const pairAction = getPairAction(rank, dealerValue);
            if (pairAction === 'split') return 'split';
        }
        
        // DOUBLE
        if (actions.includes('double')) {
            if (playerValue === 11 && dealerValue !== 11) return 'double';
            if (playerValue === 10 && dealerValue < 10) return 'double';
            if (playerValue === 9 && dealerValue >= 3 && dealerValue <= 6) return 'double';
            
            if (hasAce && player.cards.length === 2) {
                const softTotal = playerValue - 10;
                if (softTotal === 7 && dealerValue >= 3 && dealerValue <= 6) return 'double';
                if (softTotal === 6 && dealerValue >= 4 && dealerValue <= 6) return 'double';
                if (softTotal === 5 && dealerValue >= 4 && dealerValue <= 6) return 'double';
                if (softTotal === 4 && (dealerValue === 5 || dealerValue === 6)) return 'double';
                if (softTotal === 3 && (dealerValue === 5 || dealerValue === 6)) return 'double';
                if (softTotal === 2 && (dealerValue === 5 || dealerValue === 6)) return 'double';
            }
        }
        
        // HARD TOTAL
        if (!hasAce) {
            return getHardAction(playerValue, dealerValue);
        }
        
        // SOFT TOTAL
        const softTotal = playerValue - 10;
        return getSoftAction(softTotal, dealerValue);
    }

    // ==================== 6. PARSE BLACKJACK RESULT ====================
    function parseBlackjackResult(state) {
        if (!state || !state.player || !state.dealer) return 'loss';
        
        const player = state.player[0];
        const dealer = state.dealer[0];
        
        if (!player || !dealer) return 'loss';
        
        const playerValue = player.value || getHandValue(player.cards);
        const dealerValue = dealer.value || getHandValue(dealer.cards);
        
        if (playerValue > 21) return 'loss';
        if (dealerValue > 21) return 'win';
        if (playerValue > dealerValue) return 'win';
        if (playerValue < dealerValue) return 'loss';
        return 'push';
    }

