    // ==================== 11. PLACE DICE BET ====================
    async function placeDiceBet(amount, chance, condition) {
        const target = condition === 'above' ? (100 - chance) : chance;
        const apiAmount = STATE.isDemo ? 0 : parseFloat(amount.toFixed(8));
        
        try {
            const payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                target: target,
                condition: condition || "above",
                identifier: generateId()
            };
            
            const res = await fetch(CONFIG.apiUrl + '/casino/dice/roll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            const data = await res.json();
            
            if (data.error || !data.diceRoll) {
                return null;
            }
            
            const d = data.diceRoll;
            let win = false;
            const payoutMultiplier = parseFloat(d.payoutMultiplier) || 0;
            const payout = parseFloat(d.payout) || 0;
            const winAmount = parseFloat(d.amount) || apiAmount;
            
            if (d.win !== undefined) {
                win = d.win;
            } else if (payoutMultiplier > 1) {
                win = true;
            } else {
                const state = d.state;
                if (state && state.result !== undefined && state.target !== undefined) {
                    win = state.condition === "above" ? state.result > state.target : state.result < state.target;
                }
            }
            
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                const pnl = win ? (payout - winAmount) : -winAmount;
                STATE.balance += pnl;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            // Update UI setelah balance berubah
            updateAllUI();
            
            return {
                win: win,
                payout: payout,
                payoutMultiplier: payoutMultiplier,
                amount: winAmount,
                state: d.state,
                result: win ? 'win' : 'loss',
                game: 'dice'
            };
            
        } catch (error) {
            console.error('[DICE] Exception:', error);
            return null;
        }
    }

    // ==================== 12. PLACE BACCARAT BET ====================
    async function placeBaccaratBet(amount) {
        const apiAmount = STATE.isDemo ? 0 : parseFloat(amount.toFixed(8));
        
        try {
            const payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                identifier: generateId()
            };
            
            const res = await fetch(CONFIG.apiUrl + '/casino/baccarat/bet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            const data = await res.json();
            
            if (data.error || !data.baccaratBet) {
                return null;
            }
            
            const b = data.baccaratBet;
            const result = b.state?.result || 'loss';
            const isWin = result === 'banker' || result === 'player';
            const isTie = result === 'tie';
            
            let payoutMultiplier = 0;
            if (result === 'banker') payoutMultiplier = 0.975;
            else if (result === 'player') payoutMultiplier = 1;
            else if (result === 'tie') payoutMultiplier = 0;
            
            const payout = isWin ? apiAmount * payoutMultiplier : 0;
            
            if (b.user?.wallets && b.user.wallets[0]) {
                STATE.balance = parseFloat(b.user.wallets[0].balance);
            } else {
                const pnl = isWin ? (payout - apiAmount) : -apiAmount;
                STATE.balance += pnl;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            // Update UI setelah balance berubah
            updateAllUI();
            
            return {
                win: isWin,
                isTie: isTie,
                result: result,
                amount: apiAmount,
                payout: payout,
                payoutMultiplier: payoutMultiplier,
                game: 'baccarat'
            };
            
        } catch (error) {
            console.error('[BACCARAT] Exception:', error);
            return null;
        }
    }

    // ==================== 13. RECOVERY (LABOUCHERE) ====================
    function getLabouchereBet(line, unit) {
        if (!line || line.length === 0) return unit;
        if (line.length === 1) return line[0] * unit;
        return (line[0] + line[line.length - 1]) * unit;
    }

    function updateLabouchereLine(line, win, bet) {
        const newLine = line.slice();
        if (win) {
            if (newLine.length <= 2) {
                return [];
            }
            newLine.shift();
            newLine.pop();
        } else {
            newLine.push(bet);
        }
        return newLine;
    }

    function startRecovery() {
        const basebet = STATE.balance * (STATE.baseBetPercent / 100);
        const r = STATE.recovery;
        
        r.active = true;
        r.attempt = 0;
        r.maxAttempt = 7;
        r.line = [1, 1, 1, 1];
        r.unit = basebet;
        r.totalLoss = STATE.lossAmount;
        r.targetLoss = r.totalLoss;
        r.currentBet = getLabouchereBet(r.line, r.unit);
        r.currentChance = 50.5;
        r.currentCondition = 'above';
        r.isProcessing = false;
        
        STATE.isRecoveryMode = true;
        STATE.lossAmount = 0;
        
        console.log('[RECOVERY] Started | Target Loss:', r.totalLoss);
        sendTelegramMessage('🔄 RECOVERY STARTED\n' +
            'Target Loss: ' + r.targetLoss.toFixed(4) + '\n' +
            'Unit: ' + r.unit.toFixed(4) + '\n' +
            'Line: [' + r.line.join(', ') + ']');
        updateAllUI();
    }

    function handleRecoveryResult(win, betAmount) {
        const r = STATE.recovery;
        
        if (win) {
            r.totalLoss -= betAmount * 2;
            r.line = updateLabouchereLine(r.line, true, betAmount);
            r.attempt = 0;
            
            console.log('[RECOVERY] WIN | Total Loss:', r.totalLoss, '| Line:', r.line);
            
            if (r.totalLoss <= 0 || r.line.length === 0) {
                r.active = false;
                r.totalLoss = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                STATE.lossAmount = 0;
                console.log('[RECOVERY] SUCCESS!');
                sendTelegramMessage('✅ RECOVERY SUCCESS! Back to Normal');
                resetWagerSesi();
                updateAllUI();
                return;
            }
        } else {
            r.totalLoss += betAmount;
            r.line = updateLabouchereLine(r.line, false, betAmount);
            r.attempt++;
            
            console.log('[RECOVERY] LOSS | Attempt:', r.attempt, '| Total Loss:', r.totalLoss, '| Line:', r.line);
            
            if (r.attempt >= r.maxAttempt) {
                r.line = [1, 1, 1, 1];
                r.attempt = 0;
                console.log('[RECOVERY] RESET (Max Attempt)');
                sendTelegramMessage('🔄 RECOVERY RESET (Max Attempt ' + r.maxAttempt + ')\nRepeating from basebet...');
            }
        }
        
        if (r.line.length === 0) {
            r.active = false;
            STATE.isRecoveryMode = false;
            STATE.lossStreak = 0;
            STATE.lossAmount = 0;
            sendTelegramMessage('✅ RECOVERY SUCCESS! Line empty');
            updateAllUI();
            return;
        }
        
        r.currentBet = getLabouchereBet(r.line, r.unit);
        r.currentChance = r.attempt % 2 === 0 ? 50.5 : 49.5;
        r.currentCondition = r.attempt % 2 === 0 ? 'above' : 'below';
        
        if (STATE.maxBetCap > 0) {
            r.currentBet = Math.min(r.currentBet, STATE.maxBetCap);
        }
        r.currentBet = Math.min(r.currentBet, STATE.balance * 0.5);
        r.currentBet = Math.max(r.currentBet, STATE.minBet);
        
        console.log('[RECOVERY] Next Bet:', r.currentBet, 'Chance:', r.currentChance);
        updateAllUI();
    }

    // ==================== 14. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        const isWin = result.win;
        const profit = isWin ? betAmount : -betAmount;
        
        console.log('[PROCESS]', result.game || 'unknown', '|', isWin ? 'WIN' : 'LOSS', '| Fire&Forget:', isFireAndForget);
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
            if (mode === 'normal') {
                STATE.lossAmount = 0;
            }
        } else {
            STATE.losses++;
            STATE.lossStreak++;
            if (mode === 'normal') {
                STATE.lossAmount += betAmount;
            }
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        // Log
        logBet(STATE.bets, betAmount, isWin ? 'win' : 'loss', profit, result.game || '');
        
        if (mode === 'recovery') {
            handleRecoveryResult(isWin, betAmount);
        }
        
        updateAllUI();
    }

    // ==================== 15. FIRE & FORGET HANDLER ====================
    function sendFireAndForgetBet() {
        if (!STATE.isRunning || STATE.isPaused) return;
        if (STATE.isRecoveryMode) return;
        
        // Cek trigger recovery
        const basebet = STATE.balance * (STATE.baseBetPercent / 100);
        if (STATE.lossAmount > basebet && STATE.lossStreak >= 1) {
            console.log('[TRIGGER] Recovery! Loss Amount:', STATE.lossAmount, '> Basebet:', basebet);
            startRecovery();
            return;
        }
        
        // Cek wager target
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        // Hitung bet
        var betAmount = STATE.balance * (STATE.baseBetPercent / 100);
        var finalBet = Math.max(betAmount, STATE.minBet);
        finalBet = Math.min(finalBet, STATE.balance * 0.5);
        if (STATE.maxBetCap > 0) {
            finalBet = Math.min(finalBet, STATE.maxBetCap);
        }
        
        // Giliran: dice / baccarat
        STATE.normalBetCounter++;
        const isBaccarat = STATE.normalBetCounter % 2 === 0;
        
        // FIRE & FORGET - kirim tanpa await
        if (isBaccarat) {
            console.log('[F&F] Baccarat bet:', finalBet);
            placeBaccaratBet(finalBet).then(function(result) {
                if (result) processBetResult(result, finalBet, 'normal', true);
            }).catch(function(e) { console.error('[F&F] Baccarat error:', e); });
        } else {
            console.log('[F&F] Dice bet:', finalBet);
            placeDiceBet(finalBet, STATE.normalChance, 'above').then(function(result) {
                if (result) processBetResult(result, finalBet, 'normal', true);
            }).catch(function(e) { console.error('[F&F] Dice error:', e); });
        }
        
        // Kirim bet berikutnya dengan delay
        setTimeout(sendFireAndForgetBet, STATE.delayNormal);
    }

    // ==================== 16. RECOVERY SEQUENTIAL LOOP ====================
    async function runRecoverySequential() {
        if (!STATE.isRunning || STATE.isPaused) return;
        if (!STATE.isRecoveryMode || !STATE.recovery.active) {
            STATE.isRecoveryMode = false;
            sendFireAndForgetBet();
            return;
        }
        
        const r = STATE.recovery;
        if (r.isProcessing) {
            setTimeout(runRecoverySequential, 100);
            return;
        }
        
        // Cek wager target
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!');
            return;
        }
        
        r.isProcessing = true;
        
        const betAmount = r.currentBet;
        const chance = r.currentChance;
        const condition = r.currentCondition;
        
        console.log('[RECOVERY] Sequential bet:', betAmount, 'chance:', chance);
        
        try {
            const result = await placeDiceBet(betAmount, chance, condition);
            if (result) {
                processBetResult(result, betAmount, 'recovery', false);
            }
        } catch(e) {
            console.error('[RECOVERY] Error:', e);
        }
        
        r.isProcessing = false;
        
        if (STATE.isRecoveryMode && STATE.recovery.active) {
            setTimeout(runRecoverySequential, STATE.delayRecovery);
        } else {
            STATE.isRecoveryMode = false;
            setTimeout(sendFireAndForgetBet, 100);
        }
    }

