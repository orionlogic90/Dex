    // ==================== 22. PROCESS BLACKJACK RESULT ====================
    function processBlackjackResult(result, betAmount, mode) {
        if (!result) return;
        
        const isWin = result.isWin;
        const isPush = result.isPush;
        const isLoss = result.isLoss;
        const resultType = isWin ? 'win' : (isPush ? 'push' : 'loss');
        const forcedStand = result.forcedStand || false;
        
        console.log('[PROCESS] Result:', resultType, 'Mode:', mode, 'Forced:', forcedStand);
        
        STATE.bets++;
        STATE.wagered += betAmount;
        
        let profit = 0;
        if (isWin) {
            profit = betAmount;
            STATE.wins++;
        } else if (isPush) {
            profit = 0;
            STATE.pushes++;
        } else {
            profit = -betAmount;
            STATE.losses++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        updateStreak(resultType);
        console.log('[PROCESS] Loss streak:', STATE.lossStreak);
        
        var label = forcedStand ? '🚫 FORCED' : '';
        logBet(STATE.bets, betAmount, resultType, profit, label);
        
        switch(mode) {
            case 'harvest':
            case 'start_harvest':
                handleHarvestResult(resultType, betAmount);
                break;
            case 'recovery':
            case 'start_recovery':
                handleRecoveryResult(resultType, betAmount);
                break;
            case 'normal':
            default:
                if (STATE.lossStreak >= STATE.harvestTrigger && !STATE.isHarvesting) {
                    console.log('[PROCESS] Trigger harvest!');
                    startHarvest();
                }
                break;
        }
        
        updateAllUI();
        
        if (forcedStand) {
            console.log('[PROCESS] Forced stand completed, ready for next bet');
        }
    }

