    // ==================== 8. PLACE DICE BET - ORIGINAL ====================
    async function placeDiceBet(amount, chance, condition) {
        var target = condition === 'above' ? (100 - chance) : chance;
        var apiAmount = STATE.isDemo ? 0 : parseFloat(amount.toFixed(8));
        
        try {
            var payload = {
                amount: apiAmount,
                currency: STATE.selectedCurrency,
                target: target,
                condition: condition || "above",
                identifier: generateId()
            };
            
            var res = await fetch(CONFIG.apiUrl + '/casino/dice/roll', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(payload)
            });
            
            var data = await res.json();
            
            if (data.error || !data.diceRoll) {
                return null;
            }
            
            var d = data.diceRoll;
            var win = false;
            var payoutMultiplier = parseFloat(d.payoutMultiplier) || 0;
            var payout = parseFloat(d.payout) || 0;
            var winAmount = parseFloat(d.amount) || apiAmount;
            
            if (d.win !== undefined) {
                win = d.win;
            } else if (payoutMultiplier > 1) {
                win = true;
            } else {
                var state = d.state;
                if (state && state.result !== undefined && state.target !== undefined) {
                    win = state.condition === "above" ? state.result > state.target : state.result < state.target;
                }
            }
            
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                var pnl = win ? (payout - winAmount) : -winAmount;
                STATE.balance += pnl;
                if (STATE.balance < 0) STATE.balance = 0;
            }
            
            updateAllUI();
            
            return {
                win: win,
                payout: payout,
                payoutMultiplier: payoutMultiplier,
                amount: winAmount,
                state: d.state,
                result: win ? 'win' : 'loss',
                game: 'dice',
                chance: chance
            };
            
        } catch (error) {
            console.error('[DICE] Exception:', error);
            return null;
        }
    }

    // ==================== 9. ML RECOVERY SYSTEM ====================
    class MLRecoverySystem {
        constructor() {
            this.isActive = false;
            this.totalLoss = 0;
            this.targetRecovery = 0;
            this.recoveredAmount = 0;
            this.currentBetMultiplier = 1.0;
            this.currentChanceOffset = 0;
            this.history = [];
            this.maxHistory = 100;
            this.learningRate = 0.1;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.optimalChance = 80;
            this.optimalBetMultiplier = 1.0;
            this.lastAction = null;
            this.actionHistory = [];
            this.performanceScore = 0;
            this.recoverySessionActive = false;
            this.sessionStartLoss = 0;
            this.bestChance = 80;
            this.bestBetMultiplier = 1.0;
            this.bestPerformance = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.baseBet = 0;
            this.maxBet = 0;
            this.minBet = 0;
            this.initialBalance = 0;
            this.currentBalance = 0;
            this.noProgressCounter = 0;
            this.maxNoProgress = 10;
            this.lastRecoveredAmount = 0;
            this.timeoutId = null;
            this.recoveryAttempts = 0;
        }

        startRecovery(totalLoss, initialBalance, minBet, maxBet) {
            this.isActive = true;
            this.totalLoss = totalLoss;
            this.targetRecovery = totalLoss * 0.5;
            this.recoveredAmount = 0;
            this.recoverySessionActive = true;
            this.sessionStartLoss = totalLoss;
            this.currentBetMultiplier = 1.0;
            this.currentChanceOffset = 0;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.history = [];
            this.actionHistory = [];
            this.performanceScore = 0;
            this.optimalChance = 80;
            this.optimalBetMultiplier = 1.0;
            this.bestChance = 80;
            this.bestBetMultiplier = 1.0;
            this.bestPerformance = 0;
            this.noProgressCounter = 0;
            this.lastRecoveredAmount = 0;
            this.recoveryAttempts++;
            
            this.baseBet = Math.max(initialBalance * 0.01, minBet);
            this.maxBet = maxBet || initialBalance * 0.2;
            this.minBet = minBet;
            this.initialBalance = initialBalance;
            this.currentBalance = initialBalance;
            
            this.loadLearningData();
            
            console.log('[ML] Recovery session started');
            console.log('[ML] Total Loss:', totalLoss);
            console.log('[ML] Target Recovery (50%):', this.targetRecovery);
            console.log('[ML] Base Bet:', this.baseBet);
            
            return this.calculateOptimalAction();
        }

        loadLearningData() {
            try {
                const saved = localStorage.getItem('ml_recovery_data');
                if (saved) {
                    const data = JSON.parse(saved);
                    if (data.bestPerformance > 0) {
                        this.optimalChance = data.optimalChance || 80;
                        this.optimalBetMultiplier = data.optimalBetMultiplier || 1.0;
                        this.bestChance = data.bestChance || 80;
                        this.bestBetMultiplier = data.bestBetMultiplier || 1.0;
                        this.bestPerformance = data.bestPerformance || 0;
                        console.log('[ML] Loaded learning data:', data);
                    } else {
                        console.log('[ML] Best performance <= 0, using fresh data');
                        localStorage.removeItem('ml_recovery_data');
                    }
                }
            } catch(e) {
                console.log('[ML] No saved learning data');
            }
        }

        saveLearningData() {
            try {
                if (this.bestPerformance > 0) {
                    const data = {
                        optimalChance: this.optimalChance,
                        optimalBetMultiplier: this.optimalBetMultiplier,
                        bestChance: this.bestChance,
                        bestBetMultiplier: this.bestBetMultiplier,
                        bestPerformance: this.bestPerformance,
                        timestamp: Date.now()
                    };
                    localStorage.setItem('ml_recovery_data', JSON.stringify(data));
                }
            } catch(e) {}
        }

        calculateOptimalAction() {
            if (!this.isActive || !this.recoverySessionActive) {
                return null;
            }

            if (this.recoveredAmount === this.lastRecoveredAmount && this.history.length > 0) {
                this.noProgressCounter++;
                if (this.noProgressCounter > this.maxNoProgress) {
                    console.log('[ML] No progress detected, forcing strategy change');
                    this.currentChanceOffset += (Math.random() > 0.5 ? 1 : -1) * 5;
                    this.optimalBetMultiplier *= 1.2;
                    this.noProgressCounter = 0;
                }
            } else {
                this.noProgressCounter = 0;
                this.lastRecoveredAmount = this.recoveredAmount;
            }

            const recoveryProgress = this.targetRecovery > 0 ? this.recoveredAmount / this.targetRecovery : 0;
            const remainingToRecover = this.targetRecovery - this.recoveredAmount;
            
            let riskLevel = 1.0;
            if (recoveryProgress < 0.3) {
                riskLevel = 1.5;
            } else if (recoveryProgress > 0.7) {
                riskLevel = 0.7;
            }

            if (this.consecutiveWins >= 3) {
                riskLevel = Math.min(riskLevel * 1.2, 2.0);
            }
            if (this.consecutiveLosses >= 2) {
                riskLevel = Math.max(riskLevel * 0.8, 0.5);
            }

            let betMultiplier = this.optimalBetMultiplier * riskLevel;
            
            const recoveryRatio = remainingToRecover / (this.targetRecovery || 1);
            if (recoveryRatio > 0.5) {
                betMultiplier *= 1.2;
            } else if (recoveryRatio < 0.2 && recoveryRatio > 0) {
                betMultiplier *= 0.8;
            }

            let chance = this.optimalChance + this.currentChanceOffset;
            
            if (this.consecutiveWins >= 2) {
                chance = Math.min(chance + 2, 95);
            }
            if (this.consecutiveLosses >= 2) {
                chance = Math.max(chance - 3, 60);
            }

            chance = Math.max(60, Math.min(99.98, chance));
            betMultiplier = Math.max(0.5, Math.min(2.5, betMultiplier));

            const finalBet = Math.min(this.baseBet * betMultiplier, this.maxBet);
            const finalChance = chance;

            this.lastAction = {
                betAmount: finalBet,
                chance: finalChance,
                betMultiplier: betMultiplier,
                chanceOffset: this.currentChanceOffset,
                timestamp: Date.now()
            };

            console.log(`[ML] Action calculated: Bet: ${finalBet.toFixed(8)} (x${betMultiplier.toFixed(2)}) Chance: ${finalChance.toFixed(1)}%`);

            return {
                betAmount: Math.max(finalBet, this.minBet),
                chance: finalChance,
                condition: 'above'
            };
        }

        updateWithResult(win, profit, betAmount, chance) {
            if (!this.isActive || !this.recoverySessionActive) return;

            this.history.push({ win, profit, betAmount, chance, timestamp: Date.now() });
            if (this.history.length > this.maxHistory) this.history.shift();

            if (win) {
                this.consecutiveWins++;
                this.consecutiveLosses = 0;
                this.winStreak++;
                this.recoveredAmount += profit;
                
                if (this.lastAction) {
                    const performance = profit / (betAmount || 1);
                    this.performanceScore += performance * this.learningRate;
                    
                    if (performance > 0) {
                        this.optimalChance = this.optimalChance * (1 - this.learningRate * 0.1) + 
                                           this.lastAction.chance * this.learningRate * 0.1;
                        this.optimalBetMultiplier = this.optimalBetMultiplier * (1 - this.learningRate * 0.1) + 
                                                  this.lastAction.betMultiplier * this.learningRate * 0.1;
                    }
                }
            } else {
                this.consecutiveLosses++;
                this.consecutiveWins = 0;
                this.lossStreak++;
                
                if (this.lastAction) {
                    this.currentChanceOffset -= (this.lastAction.chanceOffset > 0 ? 1 : -1) * this.learningRate * 2;
                    this.optimalBetMultiplier *= (1 - this.learningRate * 0.2);
                }
            }

            this.optimalChance = Math.max(60, Math.min(99.98, this.optimalChance));
            this.optimalBetMultiplier = Math.max(0.5, Math.min(2.5, this.optimalBetMultiplier));

            if (this.recoveredAmount >= this.targetRecovery) {
                this.isActive = false;
                this.recoverySessionActive = false;
                this.saveLearningData();
                console.log('[ML] ✅ Recovery target achieved!');
                return;
            }

            if (this.recoveredAmount < -this.totalLoss * 0.5) {
                this.isActive = false;
                this.recoverySessionActive = false;
                console.log('[ML] ❌ Recovery failed - too much loss');
                return;
            }

            if (this.lastAction) {
                this.actionHistory.push({
                    action: { ...this.lastAction },
                    result: win ? 'win' : 'loss',
                    profit: profit,
                    recoveredAmount: this.recoveredAmount
                });
            }

            if (this.recoveredAmount > 0 && this.recoveredAmount > this.bestPerformance) {
                this.bestPerformance = this.recoveredAmount;
                this.bestChance = this.optimalChance;
                this.bestBetMultiplier = this.optimalBetMultiplier;
                this.saveLearningData();
            }

            console.log(`[ML] Progress: ${(this.recoveredAmount/this.targetRecovery*100).toFixed(1)}%`);
        }

        getStatus() {
            return {
                isActive: this.isActive,
                totalLoss: this.totalLoss,
                targetRecovery: this.targetRecovery,
                recoveredAmount: this.recoveredAmount,
                progress: this.targetRecovery > 0 ? this.recoveredAmount / this.targetRecovery : 0,
                remaining: this.targetRecovery - this.recoveredAmount,
                currentChance: Math.min(this.optimalChance + this.currentChanceOffset, 99.98),
                currentMultiplier: this.optimalBetMultiplier,
                winStreak: this.winStreak,
                lossStreak: this.lossStreak,
                bestChance: this.bestChance,
                bestMultiplier: this.bestBetMultiplier,
                bestPerformance: this.bestPerformance
            };
        }

        reset() {
            this.isActive = false;
            this.recoverySessionActive = false;
            this.totalLoss = 0;
            this.targetRecovery = 0;
            this.recoveredAmount = 0;
            this.consecutiveWins = 0;
            this.consecutiveLosses = 0;
            this.winStreak = 0;
            this.lossStreak = 0;
            this.currentChanceOffset = 0;
            this.actionHistory = [];
            this.history = [];
            this.performanceScore = 0;
            this.noProgressCounter = 0;
            if (this.timeoutId) {
                clearTimeout(this.timeoutId);
                this.timeoutId = null;
            }
        }
    }

