    // ==================== 19. UI UPDATES ====================
    function updateMLDisplay() {
        if (!STATE.mlSystem) {
            var statusEl = document.getElementById('ml-status');
            if (statusEl) statusEl.textContent = '⚪ Inactive';
            return;
        }
        
        const status = STATE.mlSystem.getStatus();
        
        var statusEl = document.getElementById('ml-status');
        if (statusEl) {
            if (STATE.mlSystem.isActive && STATE.mlSystem.recoverySessionActive) {
                statusEl.textContent = '🟢 Active - Recovering...';
                statusEl.style.color = '#00e5c0';
            } else {
                statusEl.textContent = '⚪ Inactive';
                statusEl.style.color = '';
            }
        }
        
        var el = document.getElementById('ml-total-loss');
        if (el) el.textContent = status.totalLoss.toFixed(8);
        el = document.getElementById('ml-target');
        if (el) el.textContent = status.targetRecovery.toFixed(8);
        el = document.getElementById('ml-recovered');
        if (el) el.textContent = status.recoveredAmount.toFixed(8);
        el = document.getElementById('ml-progress');
        if (el) el.textContent = (status.progress * 100).toFixed(1) + '%';
        el = document.getElementById('ml-current-chance');
        if (el) el.textContent = status.currentChance.toFixed(1) + '%';
        el = document.getElementById('ml-current-multiplier');
        if (el) el.textContent = 'x' + status.currentMultiplier.toFixed(2);
        el = document.getElementById('ml-win-streak');
        if (el) el.textContent = status.winStreak;
        el = document.getElementById('ml-loss-streak');
        if (el) el.textContent = status.lossStreak;
        el = document.getElementById('ml-best-chance');
        if (el) el.textContent = status.bestChance.toFixed(1) + '%';
        el = document.getElementById('ml-best-multiplier');
        if (el) el.textContent = 'x' + status.bestMultiplier.toFixed(2);
        el = document.getElementById('ml-best-recovery');
        if (el) el.textContent = status.bestPerformance.toFixed(8);
    }

    function updateStatsDisplay() {
        var currentBalance = STATE.balance || 0;
        var profitPct = STATE.startBalance > 0 ? (STATE.profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var betSpeed = getBetSpeed();
        var drawdown = STATE.startBalance - currentBalance;
        var drawdownPct = STATE.startBalance > 0 ? (drawdown / STATE.startBalance * 100) : 0;
        
        var status;
        if (STATE.isRecoveryMode) {
            status = '🔄 ML RECOVERY L' + STATE.paroli.level;
        } else {
            status = '⚡ NORMAL 🎲';
        }
        
        var map = {
            "st-user": STATE.stakeUser,
            "st-running-time": runTime,
            "st-balance": currentBalance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase(),
            "st-profit": (STATE.profit >= 0 ? '+' : '') + STATE.profit.toFixed(8) + ' (' + (profitPct >= 0 ? '+' : '') + profitPct.toFixed(2) + '%)',
            "st-wagered": STATE.wagered.toFixed(8) + ' (Total: ' + STATE.wagerTotalAccumulated.toFixed(8) + ')',
            "st-bets": STATE.bets + ' | WR ' + winRate.toFixed(0) + '%',
            "st-speed": betSpeed.toFixed(1) + 'b/s',
            "st-chance": status + ' | DD: ' + drawdownPct.toFixed(2) + '%',
            "st-gaphits": drawdown.toFixed(8),
            "st-timer": STATE.isResetting ? '⏰ ' + STATE.resetCountdownRemaining + 's' : '--',
            "st-minbet": STATE.minBet.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + ' (2 IDR)',
            "st-maxdd": STATE.maxDrawdown.toFixed(8),
            "st-maxbet": STATE.maxBet.toFixed(8),
            "st-ddnow": drawdown.toFixed(8)
        };
        for (var id in map) {
            var el = document.getElementById(id);
            if (el) el.textContent = map[id];
        }
        
        var profitEl = document.getElementById("st-profit");
        if (profitEl) profitEl.style.color = STATE.profit >= 0 ? '#00A86B' : '#FF4757';
    }

    function updateExitStrategyDisplay() {
        var el = document.getElementById('st-exit-strategy');
        if (el) {
            var text = STATE.paroli.exitStrategy === 'safe' ? '🛡️ Safe' : '⚡ Aggressive';
            el.textContent = text;
            el.style.color = STATE.paroli.exitStrategy === 'safe' ? '#00e5c0' : '#ff922b';
        }
    }

    function updateAllUI() {
        updateStatsDisplay();
        updateRaffleDisplay();
        updateExitStrategyDisplay();
        updateMLDisplay();
        
        var now = Date.now();
        if (now - STATE.lastTGReport >= CONFIG.tgReportInterval && STATE.bets > 0) {
            STATE.lastTGReport = now;
            sendSessionReport();
        }
    }

    // ==================== 20. SESSION REPORT ====================
    async function sendSessionReport() {
        var profitPct = STATE.startBalance > 0 ? (STATE.profit / STATE.startBalance * 100) : 0;
        var winRate = STATE.bets > 0 ? (STATE.wins / STATE.bets * 100) : 0;
        var runTime = getDuration();
        var status = STATE.isRecoveryMode ? '🔄 ML RECOVERY' : '⚡ NORMAL';
        var drawdownPct = STATE.startBalance > 0 ? ((STATE.startBalance - STATE.balance) / STATE.startBalance * 100) : 0;
        var raffleProgress = (STATE.raffle.progress * 100).toFixed(1);
        var raffleTickets = STATE.raffle.userTickets;
        var wageredUSD = STATE.raffle.wageredFromBot;
        var exitStrategy = STATE.paroli.exitStrategy === 'safe' ? '🛡️ Safe' : '⚡ Aggressive';
        
        let mlInfo = '';
        if (STATE.mlSystem && STATE.mlSystem.isActive) {
            const mlStatus = STATE.mlSystem.getStatus();
            mlInfo = '\n🤖 ML RECOVERY\n' +
                     '  Target: ' + mlStatus.targetRecovery.toFixed(8) + '\n' +
                     '  Recovered: ' + mlStatus.recoveredAmount.toFixed(8) + '\n' +
                     '  Progress: ' + (mlStatus.progress * 100).toFixed(1) + '%\n' +
                     '  Current Chance: ' + mlStatus.currentChance.toFixed(1) + '%';
        }
        
        var message = '💰 CHEAPCHEATX v2.0 (ML Enhanced)\n' +
                      'User: ' + STATE.stakeUser + '\n' +
                      'Time: ' + runTime + '\n' +
                      'Balance: ' + STATE.balance.toFixed(8) + ' ' + STATE.selectedCurrency.toUpperCase() + '\n' +
                      'Profit: ' + (STATE.profit >= 0 ? '+' : '') + STATE.profit.toFixed(8) + ' (' + profitPct.toFixed(2) + '%)\n' +
                      'Wagered: ' + STATE.wagered.toFixed(8) + '\n' +
                      'Bets: ' + STATE.bets + ' | WR: ' + winRate.toFixed(0) + '%\n' +
                      'Drawdown: ' + drawdownPct.toFixed(2) + '%\n' +
                      'Paroli Level: ' + STATE.paroli.level + '\n' +
                      'Exit Strategy: ' + exitStrategy + '\n' +
                      '🎟️ Raffle: ' + raffleProgress + '% | ' + raffleTickets + ' tickets | Bot: $' + wageredUSD.toFixed(2) + '\n' +
                      'Status: ' + status +
                      mlInfo +
                      '\n📊 Profit reset on normal mode return';
        await sendTelegramMessage(message);
    }

    // ==================== 21. RUN LOOP ====================
    function runLoop() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        if (STATE.isRecoveryMode) {
            runRecoverySequentialWithML();
        } else {
            sendFireAndForgetBet();
        }
    }

    // ==================== 22. UI CONTROLS ====================
    function toggleStartStop(starting) {
        var startBtn = document.getElementById("p-start");
        var stopBtn = document.getElementById("p-stop");
        var pauseBtn = document.getElementById("p-pause");
        var statusEl = document.getElementById("botStatus");
        var dotEl = document.getElementById("statusDot");
        if (starting) {
            if (startBtn) startBtn.disabled = true;
            if (stopBtn) stopBtn.disabled = false;
            if (pauseBtn) pauseBtn.disabled = false;
            if (statusEl) statusEl.textContent = "RUN";
            if (dotEl) dotEl.style.background = "#00A86B";
        } else {
            if (startBtn) startBtn.disabled = false;
            if (stopBtn) stopBtn.disabled = true;
            if (pauseBtn) pauseBtn.disabled = true;
            if (statusEl) statusEl.textContent = "STOP";
            if (dotEl) dotEl.style.background = "#FF4757";
        }
    }

