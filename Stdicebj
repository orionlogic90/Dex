    async function handleBonusCodeFromChannel(code, rawMessage, postData) {
        if (STATE.bonusCodeClaimed.includes(code)) {
            console.log('[BONUS] Already claimed:', code);
            return;
        }
        
        if (!accessToken) {
            await sendTelegramMessage(`⚠️ Bonus code detected from channel!\nCode: \`${code}\`\n❌ But not logged in to claim.`);
            return;
        }
        
        if (!STATE.bonusAutoClaim) {
            await sendTelegramMessage(`📢 Bonus code detected from channel!\nCode: \`${code}\`\n⏳ Auto claim is disabled.`);
            return;
        }
        
        try {
            const info = await checkBonusCodeInfo(code, 'drop');
            if (!info || info.status === 'bonusCodeInactive') {
                await sendTelegramMessage(`📢 Bonus code from channel: \`${code}\`\n❌ Status: ${info?.status || 'Inactive'}`);
                return;
            }
            
            if (info.status === 'alreadyUsed' || info.status === 'alreadyClaimed') {
                STATE.bonusCodeClaimed.push(code);
                await sendTelegramMessage(`📢 Bonus code from channel: \`${code}\`\n⏳ Already used/claimed.`);
                return;
            }
            
            const claimResult = await claimBonusCode(code, 'drop', STATE.bonusClaimCurrency);
            
            if (claimResult?.success) {
                STATE.bonusCodeClaimed.push(code);
                const msg = `🎉 BONUS CODE CLAIMED FROM CHANNEL!\n` +
                            `Code: \`${code}\`\n` +
                            `Value: ${claimResult.value || '?'} ${claimResult.currency || STATE.bonusClaimCurrency.toUpperCase()}\n` +
                            `Multiplier: ${claimResult.multiplier || '1x'}\n` +
                            `Claimed: ${new Date(claimResult.claimedAt).toLocaleString()}`;
                await sendTelegramMessage(msg);
                await syncUserInfo();
                await fetchVaultBalance();
                await checkAllRaffles();
                updateAllUI();
            } else {
                const errorMsg = claimResult?.error || 'Unknown error';
                await sendTelegramMessage(`❌ Failed to claim bonus from channel\nCode: \`${code}\`\nCurrency: ${STATE.bonusClaimCurrency.toUpperCase()}\nError: ${errorMsg}`);
            }
        } catch(e) {
            console.error('[BONUS] Handle channel error:', e);
            await sendTelegramMessage(`❌ Error processing bonus from channel: ${e.message}`);
        }
    }

