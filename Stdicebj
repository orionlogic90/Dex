    async function claimBonusCode(code, couponType, currency) {
        if (!accessToken || !code) return null;
        try {
            const claimCurrency = currency || STATE.bonusClaimCurrency || 'usdt';
            
            const mutation = `mutation ClaimBonusCode($code: String!, $couponType: CouponType!, $currency: CurrencyEnum!) {
                claimBonusCode(code: $code, couponType: $couponType, currency: $currency) {
                    id
