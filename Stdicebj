    // ==================== 24. RUN LOOP ====================
    async function runLoop() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        console.log('[RUN] Loop start | Balance:', STATE.balance, 'LossStreak:', STATE.lossStreak);
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!\nTotal: ' + STATE.wagerTotalAccumulated.toFixed(2));
            return;
        }
        
        var mode = checkMode();
        console.log('[RUN] Mode:', mode);
        var currentBalance = STATE.balance;
        var betAmount;
        
        switch(mode) {
            case 'start_harvest':
            case 'harvest':
                if (!STATE.isHarvesting) startHarvest();
                betAmount = STATE.harvestBet || calculateHarvestBet(currentBalance);
                break;
                
            case 'start_recovery':
            case 'recovery':
                if (!STATE.isRecoveryMode) startRecovery();
                betAmount = STATE.harvestBet || calculateRecoveryBet(currentBalance);
                break;
                
            case 'normal':
            default:
                betAmount = calculateNormalBet(currentBalance);
                break;
        }
        
        console.log('[RUN] Bet amount:', betAmount);
        
        const result = await placeBlackjackBet(betAmount);
        
        if (result) {
            console.log('[RUN] Result:', result.result, 'Forced Stand:', result.forcedStand || false);
            processBlackjackResult(result, betAmount, mode);
        } else {
            console.log('[RUN] Bet failed or invalid, placing new bet immediately...');
            STATE.bjActiveGame = false;
            STATE.bjActiveGameId = null;
            STATE.bjActiveState = null;
        }
        
        let delay;
        if (mode === 'recovery' || mode === 'start_recovery') {
            delay = STATE.delayRecovery;
        } else if (mode === 'harvest' || mode === 'start_harvest') {
            delay = STATE.delayHarvest;
        } else {
            delay = STATE.delayNormal;
        }
        
        console.log('[RUN] Next loop in', delay, 'ms');
        setTimeout(runLoop, delay);
    }

