    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        var isWin = result.win;
        var profit = isWin ? betAmount : -betAmount;
        var chance = result.chance || STATE.normalChance;
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.drawdown = STATE.startBalance - STATE.balance;
        
        if (STATE.drawdown > STATE.maxDrawdown) {
            STATE.maxDrawdown = STATE.drawdown;
        }
        
        if (betAmount > STATE.maxBet) {
            STATE.maxBet = betAmount;
        }
        
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        var wageredUSD = betAmount * STATE.fiatRates.usd;
        STATE.raffle.wageredFromBot += wageredUSD;
        var wageredFromStake = STATE.raffle.progress * STATE.raffle.ticketValue;
        var totalWagered = wageredFromStake + STATE.raffle.wageredFromBot;
        STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue - (totalWagered % STATE.raffle.ticketValue);
        if (STATE.raffle.nextTicketRemaining <= 0) {
            STATE.raffle.nextTicketRemaining = STATE.raffle.ticketValue;
        }
        
        logBet(STATE.bets, betAmount, chance, profit);
        
        if (mode === 'recovery') {
            handleRecoveryResult(isWin, betAmount);
        } else {
            var drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.triggerDrawdownPct && !STATE.isRecoveryMode) {
                console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
                startRecoveryWithML();
                return;
            }
            
            if (STATE.wagerSesiCounter >= STATE.wagerSesiTarget) {
                resetWagerSesi();
            }
        }
        
        updateAllUI();
    }

    // ==================== 16. HANDLE RECOVERY RESULT - ORIGINAL ====================
    function handleRecoveryResult(win, betAmount) {
        var p = STATE.paroli;
        
        if (win) {
            p.lossStreak = 0;
            p.level++;
            p.totalLoss += betAmount;
            p.currentChance = Math.min(p.currentChance + p.incrementPerWin, p.maxChance);
            
            if (p.exitStrategy === 'safe' && STATE.balance >= STATE.startBalance) {
                p.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                p.isProcessing = false;
                var profit = STATE.balance - STATE.startBalance;
                p.totalLoss = 0;
                p.currentChance = p.baseChance;
                p.mlActive = false;
                
                resetProfitOnNormalReturn();
                sendTelegramMessage('🛡️ SAFE EXIT!\nProfit: ' + profit.toFixed(8) + '\nBack to Normal');
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
            
            if (p.level > p.maxLevel) {
                p.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                p.isProcessing = false;
                var profit = STATE.balance - STATE.startBalance;
                p.totalLoss = 0;
                p.currentChance = p.baseChance;
                p.mlActive = false;
                
                resetProfitOnNormalReturn();
                sendTelegramMessage('✅ PAROLI RECOVERY SUCCESS!\nProfit: ' + profit.toFixed(8) + '\nBack to Normal');
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
            
            p.currentBet = p.unit * Math.pow(2, p.level - 1);
            if (p.currentBet < STATE.minBet) p.currentBet = STATE.minBet;
            p.currentCondition = p.level % 2 === 0 ? 'below' : 'above';
            
        } else {
            p.lossStreak++;
            p.totalLoss -= betAmount;
            p.level = 1;
            p.currentBet = p.unit;
            if (p.currentBet < STATE.minBet) p.currentBet = STATE.minBet;
            p.currentChance = p.baseChance;
            p.currentCondition = 'above';
            
            if (p.lossStreak >= p.maxLossStreak) {
                p.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                p.isProcessing = false;
                p.currentChance = p.baseChance;
                var loss = p.totalLoss;
                p.totalLoss = 0;
                p.mlActive = false;
                
                resetProfitOnNormalReturn();
                sendTelegramMessage('✂️ PAROLI CUTLOSS!\nLoss: ' + loss.toFixed(8) + '\nBack to Normal');
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
            
            var drawdownPct = ((STATE.startBalance - STATE.balance) / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.maxDrawdownPct) {
                p.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                p.isProcessing = false;
                p.currentChance = p.baseChance;
                var loss = p.totalLoss;
                p.totalLoss = 0;
                p.mlActive = false;
                
                resetProfitOnNormalReturn();
                sendTelegramMessage('✂️ PAROLI CUTLOSS!\nDrawdown: ' + drawdownPct.toFixed(2) + '%\nBack to Normal');
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
        }
        
        if (STATE.maxBetCap > 0) {
            p.currentBet = Math.min(p.currentBet, STATE.maxBetCap);
        }
        p.currentBet = Math.min(p.currentBet, STATE.balance * 0.5);
        p.currentBet = Math.max(p.currentBet, STATE.minBet);
        
        updateAllUI();
        
        p.isProcessing = false;
        if (STATE.isRecoveryMode && p.level > 0) {
            setTimeout(runRecoverySequentialWithML, STATE.delayRecovery);
        }
    }

