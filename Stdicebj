    // ==================== 15. PLACE BLACKJACK BET ====================
    async function placeBlackjackBet(amount) {
        const apiAmount = STATE.isDemo ? 0 : parseFloat(amount.toFixed(8));
        
        try {
            if (STATE.bjActiveGame && STATE.bjActiveGameId) {
                console.log('[BJ] Active game detected! Forcing STAND...');
                const standPayload = {
                    action: 'stand',
                    identifier: STATE.bjActiveGameId
                };
                const standRes = await fetch(CONFIG.apiUrl + '/casino/blackjack/next', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-access-token': accessToken,
                        'x-lockdown-token': CONFIG.lockdownToken
                    },
                    body: JSON.stringify(standPayload)
                });
                const standData = await standRes.json();
                if (standData.error) {
                    STATE.bjActiveGame = false;
                    STATE.bjActiveGameId = null;
                    STATE.bjActiveState = null;
                } else {
                    const result = parseBlackjackResult(standData.state);
                    STATE.bjActiveGame = false;
                    STATE.bjActiveGameId = null;
                    STATE.bjActiveState = null;
                    if (standData.state?.user?.wallets?.[0]) {
                        STATE.balance = parseFloat(standData.state.user.wallets[0].balance);
                    }
                    return {
                        result: result,
                        state: standData.state,
                        gameId: standData.id,
                        amount: apiAmount,
                        isWin: result === 'win',
                        isPush: result === 'push',
                        isLoss: result === 'loss',
                        forcedStand: true
                    };
                }
            }
            
            console.log('[BJ] Placing new bet:', apiAmount);
            const betPayload = {
                identifier: generateId(),
                amount: apiAmount,
                currency: STATE.selectedCurrency
            };
            const betRes = await fetch(CONFIG.apiUrl + '/casino/blackjack/bet', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken,
                    'x-lockdown-token': CONFIG.lockdownToken
                },
                body: JSON.stringify(betPayload)
            });
            const betData = await betRes.json();
            
            if (betData.error) {
                STATE.bjActiveGame = false;
                STATE.bjActiveGameId = null;
                STATE.bjActiveState = null;
                return null;
            }
            
            const gameId = betData.id;
            if (!gameId) {
                STATE.bjActiveGame = false;
                return null;
            }
            
            let state = betData.state;
            if (!state || !state.player) {
                STATE.bjActiveGame = false;
                return null;
            }
            
            STATE.bjActiveGame = true;
            STATE.bjActiveGameId = gameId;
            STATE.bjActiveState = state;
            STATE.bjActionCount = 0;
            STATE.bjForceStandAttempted = false;
            
            let actionCount = 0;
            const maxActions = STATE.bjMaxActions;
            
            while (actionCount < maxActions && STATE.bjActiveGame) {
                const player = state.player?.[0];
                if (!player) break;
                const actions = player.actions || [];
                const canAct = actions.includes('hit') || actions.includes('double') || actions.includes('split');
                if (!canAct) break;
                
                const action = getBlackjackAction(state);
                if (action === 'stand') break;
                
                const nextPayload = { action: action, identifier: gameId };
                const nextRes = await fetch(CONFIG.apiUrl + '/casino/blackjack/next', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'x-access-token': accessToken,
                        'x-lockdown-token': CONFIG.lockdownToken
                    },
                    body: JSON.stringify(nextPayload)
                });
                const nextData = await nextRes.json();
                
                if (nextData.error) {
                    if (!STATE.bjForceStandAttempted) {
                        STATE.bjForceStandAttempted = true;
                        const forceStandPayload = { action: 'stand', identifier: gameId };
                        const forceStandRes = await fetch(CONFIG.apiUrl + '/casino/blackjack/next', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'x-access-token': accessToken,
                                'x-lockdown-token': CONFIG.lockdownToken
                            },
                            body: JSON.stringify(forceStandPayload)
                        });
                        const forceStandData = await forceStandRes.json();
                        if (!forceStandData.error && forceStandData.state) {
                            state = forceStandData.state;
                            break;
                        }
                    }
                    STATE.bjActiveGame = false;
                    STATE.bjActiveGameId = null;
                    STATE.bjActiveState = null;
                    return null;
                }
                state = nextData.state;
                STATE.bjActiveState = state;
                actionCount++;
                STATE.bjActionCount = actionCount;
            }
            
            const result = parseBlackjackResult(state);
            if (state?.user?.wallets?.[0]) {
                STATE.balance = parseFloat(state.user.wallets[0].balance);
            }
            
            STATE.bjActiveGame = false;
            STATE.bjActiveGameId = null;
            STATE.bjActiveState = null;
            
            return {
                result: result,
                state: state,
                gameId: gameId,
                amount: apiAmount,
                isWin: result === 'win',
                isPush: result === 'push',
                isLoss: result === 'loss',
                forcedStand: false
            };
            
        } catch (error) {
            console.error('[BJ] Exception:', error);
            STATE.bjActiveGame = false;
            STATE.bjActiveGameId = null;
            STATE.bjActiveState = null;
            return null;
        }
    }

    // ==================== 16. STREAK TRACKING ====================
    function updateStreak(result) {
        const isWin = (result === 'win');
        const isPush = (result === 'push');
        
        if (isWin) {
            STATE.lossStreak = 0;
            STATE.winStreak++;
            STATE.wins++;
        } else {
            STATE.lossStreak++;
            STATE.winStreak = 0;
            if (isPush) {
                STATE.pushes++;
            } else {
                STATE.losses++;
            }
        }
        
        STATE.bjLastResult = result;
        console.log('[STREAK] Loss:', STATE.lossStreak, 'Win:', STATE.winStreak);
    }

    function checkMode() {
        const streak = STATE.lossStreak;
        
        if (STATE.isRecoveryMode) return 'recovery';
        if (STATE.isHarvesting) return 'harvest';
        
        if (streak >= STATE.recoveryTrigger) {
            return 'start_recovery';
        }
        if (streak >= STATE.harvestTrigger) {
            return 'start_harvest';
        }
        
        return 'normal';
    }

    // ==================== 17. BET CALCULATION ====================
    function calculateNormalBet(balance) {
        let bet = balance * (STATE.baseBetPercent / 100);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

    function calculateHarvestBet(balance) {
        let bet = balance * (STATE.harvestBetPercent / 100);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        bet = Math.min(bet, balance * 0.005);
        return bet;
    }

    function calculateRecoveryBet(balance) {
        if (!STATE.recovery) return 0;
        
        const totalLoss = STATE.recoveryTotalLoss;
        const remainingSplits = Math.max(1, STATE.recoveryMaxSplits - STATE.recoveryCurrentSplit);
        const lossPerSplit = totalLoss / remainingSplits;
        
        let bet = lossPerSplit / 2;
        bet = Math.max(bet, STATE.minBet);
        bet = Math.min(bet, balance * 0.0025);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

    // ==================== 18. HARVEST & RECOVERY ====================
    function startHarvest() {
        STATE.isHarvesting = true;
        STATE.harvestCount++;
        STATE.harvestStartBalance = STATE.balance;
        STATE.harvestPeakBalance = STATE.balance;
        STATE.harvestBet = calculateHarvestBet(STATE.balance);
        STATE.harvestBaseBet = STATE.harvestBet;
        STATE.harvestWorstStreak = 0;
        STATE.harvestCurrentStreak = 0;
        STATE.harvestWorstDrawdown = 0;
        
        console.log('[HARVEST] Started #' + STATE.harvestCount + ' Bet:', STATE.harvestBet);
        sendTelegramMessage('🌾 HARVEST #' + STATE.harvestCount + '\nLoss Streak: ' + STATE.lossStreak + '\nBet: ' + STATE.harvestBet.toFixed(4));
        updateAllUI();
    }

    function startRecovery() {
        STATE.isRecoveryMode = true;
        STATE.recoveryCurrentSplit = 0;
        STATE.recoveryStartBalance = STATE.balance;
        
        const lossFromStart = STATE.startBalance - STATE.balance;
        STATE.recoveryTotalLoss = Math.max(0, lossFromStart);
        STATE.recoveryLossPerSplit = STATE.recoveryTotalLoss / STATE.recoveryMaxSplits;
        
        STATE.recovery = {
            active: true,
            currentSplit: 0,
            totalSplits: STATE.recoveryMaxSplits,
            totalLoss: STATE.recoveryTotalLoss,
            lossPerSplit: STATE.recoveryLossPerSplit,
            startBalance: STATE.balance,
            betLossInSplit: 0,
            lossStreak: 0,
            completed: false
        };
        
        STATE.harvestBet = calculateRecoveryBet(STATE.balance);
        STATE.harvestStartBalance = STATE.balance;
        
        console.log('[RECOVERY] Started Total Loss:', STATE.recoveryTotalLoss);
        sendTelegramMessage('🔄 RECOVERY START\nLoss Streak: ' + STATE.lossStreak + '\nTotal Loss: ' + STATE.recoveryTotalLoss.toFixed(4) + '\nSplit: 1/' + STATE.recoveryMaxSplits);
        updateAllUI();
    }

    function handleHarvestResult(result, betAmount) {
        const isWin = (result === 'win');
        
        if (isWin) {
            const profit = STATE.balance - STATE.harvestStartBalance;
            addHarvestEntry('WIN', profit);
            STATE.isHarvesting = false;
            STATE.isAfterRecovery = true;
            STATE.lossStreak = 0;
            
            console.log('[HARVEST] WIN! Profit:', profit);
            sendTelegramMessage('✅ HARVEST WIN #' + STATE.harvestCount + '\nProfit: ' + profit.toFixed(4));
            updateAllUI();
            return;
        }
        
        STATE.harvestBet = STATE.harvestBet * STATE.harvestMultiplier;
        STATE.harvestBet = Math.min(STATE.harvestBet, STATE.balance * 0.005);
        if (STATE.maxBetCap > 0) STATE.harvestBet = Math.min(STATE.harvestBet, STATE.maxBetCap);
        
        console.log('[HARVEST] LOSS, new bet:', STATE.harvestBet);
        
        if (STATE.lossStreak >= STATE.recoveryTrigger) {
            const loss = STATE.balance - STATE.harvestStartBalance;
            addHarvestEntry('CUT LOSS', loss);
            STATE.isHarvesting = false;
            startRecovery();
            return;
        }
        
        const cutLimit = STATE.recoveryCutlossMultiplier * 2;
        if (STATE.lossStreak >= cutLimit) {
            const loss = STATE.balance - STATE.harvestStartBalance;
            addHarvestEntry('CUT LOSS', loss);
            STATE.isHarvesting = false;
            STATE.isRecoveryMode = false;
            resetToBreakeven();
            sendTelegramMessage('✂️ HARVEST CUTLOSS\nLoss: ' + loss.toFixed(4));
            updateAllUI();
        }
    }

    function handleRecoveryResult(result, betAmount) {
        const isWin = (result === 'win');
        
        if (!STATE.recovery) return;
        
        if (isWin) {
            STATE.recoveryCurrentSplit++;
            STATE.recoveryTotalLoss -= betAmount * 2;
            
            if (STATE.recoveryTotalLoss <= 0 || STATE.balance >= STATE.startBalance) {
                const profit = STATE.balance - STATE.recoveryStartBalance;
                addHarvestEntry('RECOVERY WIN', profit);
                STATE.isRecoveryMode = false;
                STATE.isHarvesting = false;
                STATE.recovery = null;
                STATE.lossStreak = 0;
                STATE.isAfterRecovery = true;
                resetWagerSesi();
                
                console.log('[RECOVERY] SUCCESS! Profit:', profit);
                sendTelegramMessage('✅ RECOVERY SUCCESS!\nProfit: ' + profit.toFixed(4));
                updateAllUI();
                return;
            }
            
            STATE.recoveryLossPerSplit = STATE.recoveryTotalLoss / 
                Math.max(1, STATE.recoveryMaxSplits - STATE.recoveryCurrentSplit);
            STATE.harvestBet = calculateRecoveryBet(STATE.balance);
            
            console.log('[RECOVERY] Split ' + (STATE.recoveryCurrentSplit + 1) + '/' + STATE.recoveryMaxSplits);
            sendTelegramMessage('🔄 RECOVERY SPLIT ' + (STATE.recoveryCurrentSplit + 1) + '/' + STATE.recoveryMaxSplits);
            updateAllUI();
            return;
        }
        
        STATE.recoveryTotalLoss += betAmount;
        STATE.recovery.betLossInSplit += betAmount;
        STATE.recovery.lossStreak++;
        
        console.log('[RECOVERY] LOSS, total loss:', STATE.recoveryTotalLoss);
        
        const cutLimit = STATE.recoveryCutlossMultiplier;
        if (STATE.recovery.lossStreak >= cutLimit) {
            const loss = STATE.balance - STATE.recoveryStartBalance;
            addHarvestEntry('RECOVERY CUTLOSS', loss);
            STATE.isRecoveryMode = false;
            STATE.isHarvesting = false;
            STATE.recovery = null;
            resetToBreakeven();
            
            console.log('[RECOVERY] CUTLOSS! Loss:', loss);
            sendTelegramMessage('🛑 RECOVERY CUTLOSS!\nLoss Streak: ' + STATE.recovery.lossStreak + '\nLoss: ' + loss.toFixed(4));
            updateAllUI();
            return;
        }
        
        STATE.harvestBet = calculateRecoveryBet(STATE.balance);
        updateAllUI();
    }

    function addHarvestEntry(result, profit) {
        STATE.harvestingEntries.unshift({
            result: result,
            profit: profit,
            lossStreak: STATE.lossStreak,
            timestamp: new Date(),
            mode: STATE.isRecoveryMode ? 'RECOVERY' : 'HARVEST'
        });
        if (STATE.harvestingEntries.length > CONFIG.maxHistory) STATE.harvestingEntries.pop();
        renderHarvestingEntries();
    }

