        d.currentCondition = 'above';
        d.isProcessing = false;
        d.recoveryCount++;
        d.totalLoss = 0;
        
        STATE.isRecoveryMode = true;
        STATE.lossStreak = 0;
        
        console.log('[RECOVERY] Started Level 1');
        sendTelegramMessage('🔄 D\'ALEMBERT RECOVERY #' + d.recoveryCount + '\n' +
            'Level: 1\n' +
            'Bet: ' + d.currentBet.toFixed(8) + '\n' +
            'Chance: 50.5%');
        updateAllUI();
        
        // LANGSUNG JALANKAN RECOVERY
        setTimeout(runRecoverySequential, 100);
    }

    function handleRecoveryResult(win, betAmount) {
        const d = STATE.dalembert;
        
        if (win) {
            d.level--;
            d.totalLoss -= betAmount * 2;
            console.log('[RECOVERY] WIN | Level:', d.level, '| Total Loss:', d.totalLoss);
            
            if (d.level <= 0) {
                d.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                d.totalLoss = 0;
                d.isProcessing = false;
                console.log('[RECOVERY] SUCCESS!');
                sendTelegramMessage('✅ D\'ALEMBERT RECOVERY SUCCESS!\nBack to Normal');
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
        } else {
            d.level++;
            d.totalLoss += betAmount;
            console.log('[RECOVERY] LOSS | Level:', d.level, '| Total Loss:', d.totalLoss);
            
            if (d.level > d.maxLevel) {
                d.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                d.isProcessing = false;
                console.log('[RECOVERY] CUTLOSS! Level exceeded max');
                sendTelegramMessage('✂️ D\'ALEMBERT CUTLOSS!\nMax Level ' + d.maxLevel + ' reached\n' +
                    'Total Loss: ' + d.totalLoss.toFixed(8));
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
            
            const drawdownPct = ((STATE.startBalance - STATE.balance) / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.maxDrawdownPct) {
                d.level = 0;
                STATE.isRecoveryMode = false;
                STATE.lossStreak = 0;
                d.isProcessing = false;
                console.log('[RECOVERY] CUTLOSS! Drawdown:', drawdownPct + '%');
                sendTelegramMessage('✂️ D\'ALEMBERT CUTLOSS!\nDrawdown: ' + drawdownPct.toFixed(2) + '%\n' +
                    'Total Loss: ' + d.totalLoss.toFixed(8));
                updateAllUI();
                setTimeout(sendFireAndForgetBet, 100);
                return;
            }
        }
        
        // UPDATE BET
        d.currentBet = d.unit * d.level;
        d.currentChance = d.level % 2 === 0 ? 49.5 : 50.5;
        d.currentCondition = d.level % 2 === 0 ? 'below' : 'above';
        
        if (STATE.maxBetCap > 0) {
            d.currentBet = Math.min(d.currentBet, STATE.maxBetCap);
        }
        d.currentBet = Math.min(d.currentBet, STATE.balance * 0.5);
        d.currentBet = Math.max(d.currentBet, STATE.minBet);
        
        console.log('[RECOVERY] Next Level:', d.level, '| Bet:', d.currentBet, '| Chance:', d.currentChance);
        updateAllUI();
        
        // RESET isProcessing dan lanjutkan recovery
        d.isProcessing = false;
        if (STATE.isRecoveryMode && d.level > 0) {
            setTimeout(runRecoverySequential, STATE.delayRecovery);
        }
    }

    // ==================== 12. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, mode, isFireAndForget) {
        if (!result) return;
        
        const isWin = result.win;
        const profit = isWin ? betAmount : -betAmount;
        const chance = result.chance || STATE.normalChance;
        
        var gameLabel = mode === 'recovery' ? 'dice[R]' : 'dice';
        
        STATE.bets++;
        STATE.wagered += betAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        
        if (isWin) {
            STATE.wins++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.drawdown = STATE.startBalance - STATE.balance;
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        logBet(STATE.bets, betAmount, chance, isWin ? 'win' : 'loss', profit, gameLabel);
        
        if (mode === 'recovery') {
            handleRecoveryResult(isWin, betAmount);
        } else {
            const drawdownPct = (STATE.drawdown / STATE.startBalance) * 100;
            if (drawdownPct >= STATE.triggerDrawdownPct && !STATE.isRecoveryMode) {
                console.log('[TRIGGER] Recovery! Drawdown:', drawdownPct + '%');
                startRecovery();
                return;
            }
            
            if (STATE.wagerSesiCounter >= STATE.wagerSesiTarget) {
                resetWagerSesi();
            }
        }
        
        updateAllUI();
    }

