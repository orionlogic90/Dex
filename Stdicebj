    // ==================== 15. PROCESS DICE RESULT ====================
    function processDiceResult(result, betAmount, mode) {
        if (!result || !result.diceRoll) return;
        
        const d = result.diceRoll;
        var win = false;
        var payoutMultiplier = parseFloat(d.payoutMultiplier) || 0;
        var payout = parseFloat(d.payout) || 0;
        
        if (d.win !== undefined) win = d.win;
        else if (payoutMultiplier > 1) win = true;
        else if (d.state) {
            win = d.state.condition === "above" ? d.state.result > d.state.target : d.state.result < d.state.target;
        }
        
        var profit = win ? (payout - betAmount) : -betAmount;
        
        if (d.user && d.user.wallets && d.user.wallets[0]) {
            STATE.balance = parseFloat(d.user.wallets[0].balance);
        } else {
            STATE.balance += profit;
            if (STATE.balance < 0) STATE.balance = 0;
        }
        
        STATE.bets++;
        STATE.wagered += betAmount;
        if (win) {
            STATE.wins++;
            STATE.winStreak++;
            STATE.lossStreak = 0;
        } else {
            STATE.losses++;
            STATE.lossStreak++;
            STATE.winStreak = 0;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        STATE.wagerSesiCounter += betAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        
        var rollDisplay = d.state?.result ? d.state.result.toFixed(2) : "?";
        var profitDisplay = profit >= 0 ? "+" + profit.toFixed(8) : profit.toFixed(8);
        logBet(STATE.bets, betAmount.toFixed(4), getCurrentChance().toFixed(1), rollDisplay, profitDisplay);
        
        // Handle mode
        if (mode === 'dalembert' || mode === 'start_dalembert') {
            handleDalembertResult(win);
        } else if (mode === 'recovery') {
            handleRecoveryResult(win, betAmount);
        } else {
            // Normal mode
            if (STATE.lossStreak >= STATE.dalembertTrigger) {
                startDalembert();
            }
        }
        
        updateAllUI();
    }

    // ==================== 16. RECOVERY SYSTEM ====================
    function startRecovery() {
        STATE.isRecoveryMode = true;
        STATE.recoveryCurrentSplit = 0;
        STATE.recoveryStartBalance = STATE.balance;
        
        const lossFromStart = STATE.startBalance - STATE.balance;
        STATE.recoveryTotalLoss = Math.max(0, lossFromStart);
        STATE.recoveryLossPerSplit = STATE.recoveryTotalLoss / STATE.recoveryMaxSplits;
        
        STATE.recovery = {
            active: true,
            currentSplit: 0,
            totalSplits: STATE.recoveryMaxSplits,
            totalLoss: STATE.recoveryTotalLoss,
            lossPerSplit: STATE.recoveryLossPerSplit,
            startBalance: STATE.balance,
            betLossInSplit: 0,
            lossStreak: 0,
            completed: false
        };
        
        console.log('[RECOVERY] Started');
        sendTelegramMessage('🔄 RECOVERY START\nTotal Loss: ' + STATE.recoveryTotalLoss.toFixed(4) + '\nSplit: 1/' + STATE.recoveryMaxSplits);
        updateAllUI();
    }

    function handleRecoveryResult(win, betAmount) {
        if (!STATE.recovery) return;
        
        if (win) {
            STATE.recoveryCurrentSplit++;
            STATE.recoveryTotalLoss -= betAmount * 2;
            
            if (STATE.recoveryTotalLoss <= 0 || STATE.balance >= STATE.startBalance) {
                const profit = STATE.balance - STATE.recoveryStartBalance;
                STATE.isRecoveryMode = false;
                STATE.recovery = null;
                STATE.lossStreak = 0;
                STATE.dalembertLevel = 0;
                
                console.log('[RECOVERY] SUCCESS!');
                sendTelegramMessage('✅ RECOVERY SUCCESS!\nProfit: ' + profit.toFixed(4));
                resetWagerSesi();
                updateAllUI();
                return;
            }
            
            STATE.recoveryLossPerSplit = STATE.recoveryTotalLoss / 
                Math.max(1, STATE.recoveryMaxSplits - STATE.recoveryCurrentSplit);
            
            console.log('[RECOVERY] Split ' + (STATE.recoveryCurrentSplit + 1) + '/' + STATE.recoveryMaxSplits);
            sendTelegramMessage('🔄 RECOVERY SPLIT ' + (STATE.recoveryCurrentSplit + 1) + '/' + STATE.recoveryMaxSplits);
            updateAllUI();
            return;
        }
        
        STATE.recoveryTotalLoss += betAmount;
        STATE.recovery.betLossInSplit += betAmount;
        STATE.recovery.lossStreak++;
        
        const cutLimit = STATE.recoveryCutlossMultiplier;
        if (STATE.recovery.lossStreak >= cutLimit) {
            STATE.isRecoveryMode = false;
            STATE.recovery = null;
            resetToBreakeven();
            
            console.log('[RECOVERY] CUTLOSS!');
            sendTelegramMessage('🛑 RECOVERY CUTLOSS!\nLoss Streak: ' + STATE.recovery.lossStreak);
            updateAllUI();
            return;
        }
        
        updateAllUI();
    }

    function getRecoveryBet(balance) {
        if (!STATE.recovery) return 0;
        const totalLoss = STATE.recoveryTotalLoss;
        const remainingSplits = Math.max(1, STATE.recoveryMaxSplits - STATE.recoveryCurrentSplit);
        const lossPerSplit = totalLoss / remainingSplits;
        let bet = lossPerSplit / 2;
        bet = Math.max(bet, STATE.minBet);
        bet = Math.min(bet, balance * 0.0025);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

