    async function claimBonusCode(code, couponType, currency) {
        if (!accessToken || !code) return null;
        try {
            const claimCurrency = currency || STATE.bonusClaimCurrency || 'usdt';
            
            const mutation = `mutation ClaimBonusCode($code: String!, $couponType: CouponType!, $currency: CurrencyEnum!) {
                claimBonusCode(code: $code, couponType: $couponType, currency: $currency) {
                    id
                    bonusValue
                    currency
                    cryptoMultiplier
                    claimedAt
                }
            }`;
            
            const variables = {
                code: code.trim(),
                couponType: couponType || "drop",
                currency: claimCurrency.toLowerCase()
            };
            
            const res = await fetch(CONFIG.apiUrl + '/graphql', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'x-access-token': accessToken
                },
                body: JSON.stringify({ query: mutation, variables })
            });
            
            const data = await res.json();
            if (data?.data?.claimBonusCode) {
                const result = data.data.claimBonusCode;
                return {
                    success: true,
                    id: result.id,
                    value: result.bonusValue,
                    currency: result.currency,
                    multiplier: result.cryptoMultiplier,
                    claimedAt: result.claimedAt
                };
            }
            if (data?.errors) {
                return { success: false, error: data.errors[0]?.message || 'Unknown error' };
            }
            return { success: false, error: 'No response' };
        } catch(e) {
            console.error('[CLAIM] Error:', e);
            return { success: false, error: e.message };
        }
    }

    function extractBonusCode(text) {
        if (!text) return null;
        const patterns = [
            /code[:\s]+([a-zA-Z0-9_\-]{8,20})/i,
            /bonus[:\s]+([a-zA-Z0-9_\-]{8,20})/i,
            /claim[:\s]+([a-zA-Z0-9_\-]{8,20})/i,
            /([a-zA-Z0-9_\-]{10,20})/
        ];
        for (let pattern of patterns) {
            const match = text.match(pattern);
            if (match && match[1]) {
                const code = match[1].trim();
                const commonWords = ['drop', 'bonus', 'code', 'claim', 'https', 'http', 'telegram'];
                if (!commonWords.includes(code.toLowerCase())) {
                    return code;
                }
            }
        }
        return null;
    }

