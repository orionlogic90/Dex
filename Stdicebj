        setInterval(updateAllUI, 1000);
        setInterval(function() {
            if (accessToken) {
                fetchUserTier(STATE.stakeUser);
                fetchVipProgress();
                fetchRakebackInfo();
                fetchVaultBalance();
                checkAllRaffles();
                monitorUnclaimedBonuses();
            }
        }, 120000);
    }

    // ==================== 24. START ====================
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', createUI);
    } else {
        createUI();
    }
})();
