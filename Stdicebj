                if (STATE.isDemo) {
                    var tokenEl2 = document.getElementById("p-token");
                    if (!tokenEl2 || tokenEl2.value.trim().length < 30) {
                        sendTelegramMessage('⚠️ DEMO MODE: Token diperlukan untuk API call!');
                        alert('⚠️ DEMO MODE: Masukkan API Token terlebih dahulu!');
                        return;
                    }
                    accessToken = tokenEl2.value.trim();
                    localStorage.setItem('apitoken', accessToken);
