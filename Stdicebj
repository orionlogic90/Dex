    // ==================== 21. RUN LOOP ====================
    async function runLoop() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        console.log('[RUN] Loop | Balance:', STATE.balance, 'LossStreak:', STATE.lossStreak, 'DALevel:', STATE.dalembertLevel);
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage('✅ TOTAL WAGER TARGET REACHED!\nTotal: ' + STATE.wagerTotalAccumulated.toFixed(2));
            return;
        }
        
        var mode = checkMode();
        console.log('[RUN] Mode:', mode);
        var currentBalance = STATE.balance;
        var betAmount, chance;
        
        switch(mode) {
            case 'start_dalembert':
                startDalembert();
                // Fall through
            case 'dalembert':
                betAmount = getCurrentBet();
                chance = getCurrentChance();
                break;
            case 'normal':
            default:
                betAmount = getCurrentBet();
                chance = getCurrentChance();
                break;
        }
        
        // Cek recovery
        if (STATE.isRecoveryMode) {
            betAmount = getRecoveryBet(currentBalance);
            chance = STATE.normalChance;
            mode = 'recovery';
        }
        
        betAmount = Math.max(betAmount, STATE.minBet);
        betAmount = Math.min(betAmount, currentBalance * 0.5);
        if (STATE.maxBetCap > 0) betAmount = Math.min(betAmount, STATE.maxBetCap);
        
        console.log('[RUN] Bet:', betAmount, 'Chance:', chance);
        
        const result = await placeDiceBet(betAmount, chance);
        
        if (result) {
            processDiceResult(result, betAmount, mode);
        } else {
            console.log('[RUN] Bet failed, retrying...');
        }
        
        let delay = STATE.delayNormal;
        if (mode === 'recovery') delay = STATE.delayRecovery;
        
        setTimeout(runLoop, delay);
    }

