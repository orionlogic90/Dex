                STATE.level1Peak = STATE.balancePeak;
            }
            drawGapVisual();
        }
        var profitPct = (STATE.profit / STATE.startBalance) * 100;
        if (profitPct < 1.0) {
            STATE.isTrailingActive = false;
            STATE.trailingLevel = 0;
            STATE.balancePeak = 0;
            STATE.level1Peak = 0;
            STATE.level2Peak = 0;
            drawGapVisual();
        }
    }
    
