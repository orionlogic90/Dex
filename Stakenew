    // ==================== 14. FIRE-AND-FORGET ====================
    function sendDiceBetFireAndForget(amount, chance, betMode) {
        var target = 100 - chance;
        var meta = {
            amount: parseFloat(amount.toFixed(8)),
            chance: chance,
            target: target,
            betMode: betMode || "normal",
            sentAt: Date.now(),
            betIndex: STATE.pendingDiceMeta.length
        };
        STATE.pendingDiceMeta.push(meta);
        STATE.diceInFlight++;
        
        var apiAmount = STATE.isDemo ? 0 : parseFloat(amount.toFixed(8));
        var payload = { 
            amount: apiAmount, 
            currency: STATE.selectedCurrency, 
            target: target, 
            condition: "above", 
            identifier: Math.random().toString(36).slice(2) 
        };
        
        fetch(CONFIG.apiUrl + '/casino/dice/roll', {
            method: 'POST',
            headers: { 
                'Content-Type': 'application/json', 
                'x-access-token': accessToken, 
                'x-lockdown-token': CONFIG.lockdownToken 
            },
            body: JSON.stringify(payload)
        }).then(function(response) { 
            return response.json(); 
        }).then(function(result) {
            if (result && result.error) {
                processDiceResult(null, meta);
            } else {
                processDiceResult(result, meta);
            }
        }).catch(function(error) {
            processDiceResult(null, meta);
        });
        return meta;
    }

    // ==================== 15. PROCESS DICE RESULT ====================
    function processDiceResult(result, meta) {
        STATE.diceInFlight = Math.max(0, STATE.diceInFlight - 1);
        
        if (!result || !result.diceRoll) {
            return;
        }
        
        var d = result.diceRoll;
        var win = false;
        var winAmount = meta.amount;
        var payoutMultiplier = parseFloat(d.payoutMultiplier) || 0;
        var payout = parseFloat(d.payout) || 0;
        
        if (STATE.isDemo && (payout === 0 || payoutMultiplier <= 1)) {
            payoutMultiplier = parseFloat((99.0 / meta.chance).toFixed(4));
            payout = parseFloat((winAmount * payoutMultiplier).toFixed(8));
        }
        
        if (d.win !== undefined) win = d.win;
        else if (payoutMultiplier > 1) win = true;
        else if (payoutMultiplier === 0 && payout === 0) win = false;
        else if (d.state) { 
            win = d.state.condition === "above" ? d.state.result > d.state.target : d.state.result < d.state.target; 
        }
        
        var oldBalance = STATE.balance;
        var pnlCalc = win ? (payout - winAmount) : -winAmount;
        
        if (STATE.isDemo) {
            STATE.balance = oldBalance + pnlCalc;
            if (STATE.balance < 0) STATE.balance = 0;
        } else {
            if (d.user && d.user.wallets && d.user.wallets[0]) {
                STATE.balance = parseFloat(d.user.wallets[0].balance);
            } else {
                STATE.balance = oldBalance + pnlCalc;
                if (STATE.balance < 0) STATE.balance = 0;
            }
        }
        
        if (STATE.balance > STATE.peakBalanceEver) STATE.peakBalanceEver = STATE.balance;
        STATE.profit = STATE.balance - STATE.startBalance;
        if (STATE.profit > STATE.highestProfit) STATE.highestProfit = STATE.profit;
        if (winAmount > STATE.stats.maxBet) STATE.stats.maxBet = winAmount;
        STATE.bets++;
        STATE.wagered += winAmount;
        STATE.lastWinStatus = win;
        STATE.lastBetAmount = winAmount;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        if (win) STATE.wins++; else STATE.losses++;
        STATE.totalWager += winAmount;
        STATE.sessionProfit = STATE.profit;
        if (STATE.sessionProfit > STATE.highestProfit) STATE.highestProfit = STATE.sessionProfit;
        
        STATE.wagerSesiCounter += winAmount;
        STATE.wagerSesiProfit = STATE.balance - STATE.wagerSesiStartBal;
        
        var rollResult = (d.state && d.state.result !== undefined) ? d.state.result : null;
        if (rollResult !== null) updateVirtualStreaks(rollResult);
        if (STATE.isHarvesting) updateHarvestTracking();
        
        var rollDisplay = rollResult !== null ? rollResult.toFixed(2) : "?";
        var profitDisplay = win ? "+" + (payout - winAmount).toFixed(8) : "-" + winAmount.toFixed(8);
        logBet(STATE.bets, winAmount.toFixed(4), meta.chance.toFixed(1), rollDisplay, profitDisplay);
        
        var betMode = meta.betMode || "normal";
        
        if (betMode === "booster") {
            return;
        }
        
        if (betMode === "normal" || betMode === "jit") {
            updateWagerDisplay();
            updateStatsDisplay();
            
            if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
                STATE.isRunning = false;
                STATE.wagerStop = true;
                toggleStartStop(false);
                sendTelegramMessage("✅ TOTAL WAGER TARGET REACHED!\nTotal Wager: " + STATE.wagerTotalAccumulated.toFixed(2) + "\nTarget: " + STATE.wagerTotalTarget);
                return;
            }
            
            if (checkBoosterCondition() && !STATE.isBoosterMode && !STATE.isHarvesting && !STATE.isRecoveryMode) {
                startBoosterMode();
                return;
            }
        }
        
        if (betMode === "harvest" && STATE.isHarvesting && !STATE.isRecoveryMode) {
            if (win) {
                var totalProfit2 = STATE.balance - STATE.harvestStartBalance;
                endHarvestAndAddToHistory('WIN', totalProfit2, true, false);
                STATE.isHarvesting = false;
                STATE.isAfterRecovery = true;
                resetVirtualStreaks();
                if (STATE.isTrailingActive) resetTrailingAfterWin();
                sendTelegramMessage(`✅ HARVEST WIN #${STATE.harvestCount}\nProfit: ${totalProfit2.toFixed(8)}\nBalance: ${STATE.balance.toFixed(8)}`);
                updateWagerDisplay();
            } else {
                STATE.harvestBet = STATE.harvestBet * STATE.harvestMultiplier;
                if (STATE.maxBetCap > 0 && STATE.harvestBet > STATE.maxBetCap) STATE.harvestBet = STATE.maxBetCap;
                STATE.harvestBet = Math.min(STATE.harvestBet, STATE.balance * 0.005);
                
                var batasMultiplier3 = STATE.maxCutLossMultiplier || 5;
                var cutLimit3 = getCutLossLimit(STATE.harvestChance, batasMultiplier3);
                var currentLS = STATE.virtualStreak[STATE.harvestChance];
                
                if (currentLS >= cutLimit3) {
                    var totalLoss3 = STATE.balance - STATE.harvestStartBalance;
                    endHarvestAndAddToHistory('CUT LOSS', totalLoss3, false, true);
                    STATE.isHarvesting = false;
                    STATE.isRecoveryMode = false;
                    STATE.recoveryStep = 0;
                    STATE.recovery = null;
                    STATE.isAfterRecovery = false;
                    resetToBreakeven();
                    updateWagerDisplay();
                }
            }
        }
        
        updateStatsDisplay();
        updateBurstDisplay();
        updateWagerDisplay();
    }

