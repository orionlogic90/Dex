    function calculateDynamicRisk() {
        var base = STATE.riskFactor;
        if (STATE.riskFluctuation > 0) {
            var minF = 1 - STATE.riskFluctuation;
            var maxF = 1 + STATE.riskFluctuation;
            base = base * (minF + (Math.random() * (maxF - minF)));
        }
        return clamp(base, STATE.minRiskLimit, STATE.maxRiskLimit);
    }

    // ==================== 4. VIRTUAL HUNTING ====================
    function initVirtualChances() {
        var minC = safeFloat("p-virt-min", 15);
        var maxC = safeFloat("p-virt-max", 25);
        if (minC >= maxC) minC = maxC - 1;
        
        STATE.virtualChances = [];
        for (var c = minC; c <= maxC; c += 0.5) {
            STATE.virtualChances.push(parseFloat(c.toFixed(2)));
        }
        
        var baseChance = STATE.normalChance;
        if (!STATE.virtualChances.some(function(v) { return Math.abs(v - baseChance) < 0.01; }) &&
            baseChance <= maxC + 0.1 && baseChance >= minC - 0.1) {
            STATE.virtualChances.push(baseChance);
        }
        STATE.virtualChances.sort(function(a, b) { return a - b; });
        
        STATE.virtualStreak = {};
        STATE.virtualThreshold = {};
        STATE.readyChances = [];
        STATE.memory = {};
        
        for (var i = 0; i < STATE.virtualChances.length; i++) {
            var c = STATE.virtualChances[i];
            var threshold = Math.ceil((99.0 / c) * STATE.harvestTrigger);
            STATE.virtualStreak[c] = 0;
            STATE.virtualThreshold[c] = threshold;
            STATE.memory[c] = { wins: 0, loss: 0, max_ls: 0, ls_now: 0, target: threshold };
        }
        
        var infoEl = document.getElementById("virt-range-info");
        if (infoEl) infoEl.innerHTML = `Virtual chances: ${minC}% - ${maxC}% (${STATE.virtualChances.length} chances)`;
    }

    function updateVirtualStreaks(roll) {
        var changed = false;
        for (var i = 0; i < STATE.virtualChances.length; i++) {
            var c = STATE.virtualChances[i];
            var isWin = roll > (100 - c);
            var mem = STATE.memory[c];
            
            if (isWin) {
                STATE.virtualStreak[c] = 0;
                mem.wins++;
                mem.max_ls = Math.max(mem.max_ls, mem.ls_now);
                mem.ls_now = 0;
                var idx = STATE.readyChances.indexOf(c);
                if (idx > -1) STATE.readyChances.splice(idx, 1);
            } else {
                STATE.virtualStreak[c]++;
                mem.loss++;
                mem.ls_now++;
                mem.max_ls = Math.max(mem.max_ls, mem.ls_now);
                if (STATE.virtualStreak[c] >= STATE.virtualThreshold[c] && 
                    STATE.readyChances.indexOf(c) === -1) {
                    STATE.readyChances.push(c);
                    changed = true;
                }
            }
        }
        if (changed) STATE.readyChances.sort(function(a, b) { return b - a; });
    }

