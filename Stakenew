    // ==================== 19. RUN LOOP ====================
    async function runLoop() {
        if (!STATE.isRunning || STATE.isPaused) return;
        
        if (shouldStartRest() && !STATE.isRecoveryMode && !STATE.isHarvesting) {
            startRestPhase();
            setTimeout(runLoop, 200);
            return;
        }
        if (STATE.isResting) {
            if (shouldEndRest()) endRestPhase();
            setTimeout(runLoop, 200);
            return;
        }
        
        var triggerChance = getBestTriggerChance();
        if (triggerChance !== null && !STATE.isHarvesting && !STATE.isRecoveryMode && !STATE.isBoosterMode) {
            startHarvest(triggerChance);
        }
        
        if (checkBoosterCondition() && !STATE.isBoosterMode && !STATE.isHarvesting && !STATE.isRecoveryMode) {
            startBoosterMode();
        }
        
        if (STATE.wagerTotalAccumulated >= STATE.wagerTotalTarget) {
            STATE.isRunning = false;
            STATE.wagerStop = true;
            toggleStartStop(false);
            sendTelegramMessage("✅ TOTAL WAGER TARGET REACHED!\nTotal: " + STATE.wagerTotalAccumulated.toFixed(2));
            return;
        }
        
        var currentBalance = STATE.balance;
        var nextBet, chanceToUse, betMode = "normal";
        
        if (STATE.isHarvesting) {
            chanceToUse = STATE.harvestChance;
            nextBet = STATE.harvestBet;
            betMode = STATE.isRecoveryMode ? "recovery" : "harvest";
        } else if (STATE.isBoosterMode) {
            chanceToUse = STATE.boosterChance || STATE.normalChance;
            nextBet = STATE.boosterBetAmount;
            betMode = "booster";
        } else {
            var isBurst = false;
            if (STATE.wagerJitEnabled && STATE.burstEveryN > 0) {
                STATE.burstCounter++;
                if (STATE.burstCounter >= STATE.burstEveryN) {
                    isBurst = true;
                    STATE.burstCounter = 0;
                }
            }
            if (isBurst) {
                chanceToUse = getBurstChance();
                nextBet = getBurstBet(currentBalance);
                betMode = "jit";
            } else {
                chanceToUse = STATE.normalChance;
                nextBet = computeNormalBet(currentBalance);
                betMode = "normal";
            }
            updateBurstDisplay();
        }
        
        nextBet = Math.max(nextBet, STATE.minBet);
        if (STATE.maxBetCap > 0) nextBet = Math.min(nextBet, STATE.maxBetCap);
        nextBet = Math.min(nextBet, currentBalance * 0.5);
        if (nextBet < 0.00000001) nextBet = 0.00000001;
        
        if (betMode === "normal" || betMode === "jit") {
            if (STATE.diceInFlight < CONFIG.wagerParallelCap) {
                sendDiceBetFireAndForget(nextBet, chanceToUse, betMode);
            }
            if (STATE.normalCycleStartTime === 0) STATE.normalCycleStartTime = Date.now();
            setTimeout(runLoop, STATE.delayNormal);
            return;
        }
        
        if (betMode === "booster") {
            var boosterResult = await placeBet(nextBet, chanceToUse);
            if (boosterResult) processBetResult(boosterResult, nextBet, chanceToUse, betMode);
            setTimeout(runLoop, STATE.delayHarvest);
            return;
        }
        
        if (betMode === "recovery" || betMode === "harvest") {
            var placeResult = await placeBet(nextBet, chanceToUse);
            if (placeResult) processBetResult(placeResult, nextBet, chanceToUse, betMode);
            var delay = STATE.isRecoveryMode ? STATE.delayRecovery : STATE.delayHarvest;
            setTimeout(runLoop, delay);
            return;
        }
        
        setTimeout(runLoop, 10);
    }

    // ==================== 20. PROCESS BET RESULT ====================
    function processBetResult(result, betAmount, chance, betMode) {
        if (!result || !result.diceRoll) return;
        
        var d = result.diceRoll;
        var win = d.win || (d.payoutMultiplier > 1) || false;
        var payout = parseFloat(d.payout) || 0;
        var winAmount = parseFloat(d.amount) || betAmount;
        
        var oldBalance = STATE.balance;
        var pnl = win ? (payout - winAmount) : -winAmount;
        
        if (d.user && d.user.wallets && d.user.wallets[0]) {
            STATE.balance = parseFloat(d.user.wallets[0].balance);
        } else {
            STATE.balance = oldBalance + pnl;
            if (STATE.balance < 0) STATE.balance = 0;
        }
        
        STATE.profit = STATE.balance - STATE.startBalance;
        STATE.wagered += winAmount;
        STATE.bets++;
        if (win) STATE.wins++;
        else STATE.losses++;
        STATE.betTimestamps.push(Date.now());
        if (STATE.betTimestamps.length > 100) STATE.betTimestamps.shift();
        STATE.wagerSesiCounter += winAmount;
