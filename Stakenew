        STATE.isBoosterMode = true;
        STATE.boosterStartProfit = STATE.profit;
        var boosterChance = STATE.boosterChances[STATE.boosterChanceIndex % STATE.boosterChances.length];
        STATE.boosterChanceIndex++;
        var bet = STATE.profit + STATE.wagerLossTolerance;
        bet = Math.min(bet, STATE.balance);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        STATE.boosterBetAmount = bet;
        STATE.boosterChance = boosterChance;
        resetVirtualStreaks();
        sendTelegramMessage(`🚀 BOOSTER\nBet: ${bet.toFixed(4)}\nChance: ${boosterChance}%`);
        updateAllUI();
    }

