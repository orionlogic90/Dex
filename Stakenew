    function startHarvest(triggerChance) {
        STATE.isHarvesting = true;
        STATE.harvestChance = triggerChance;
        STATE.harvestCount++;
        
        var payoutMult = getPayoutMultiplier(triggerChance);
        STATE.harvestMultiplier = payoutMult / (payoutMult - 1);
        
        var targetBalance = STATE.wagerSesiStartBal - STATE.wagerLossTolerance;
        var currentLoss = STATE.wagerSesiStartBal - STATE.balance;
        var excessLoss = Math.max(0, currentLoss - STATE.wagerLossTolerance);
        
        if (excessLoss <= 0) {
            STATE.isRecoveryMode = false;
            STATE.harvestBet = computeHarvestBet(STATE.balance);
            STATE.recovery = null;
        } else {
            STATE.isRecoveryMode = true;
            STATE.recoverySplitCounter = 0;
            
            STATE.recovery = {
                active: true,
                currentSplit: 0,
                totalSplits: 3,
                originalSplits: 3,
                lossPerSplit: excessLoss / 3,
                lossStreak: 0,
                startBalance: STATE.balance,
                targetBalance: targetBalance,
                totalLoss: excessLoss,
                accumulatedLoss: 0,
                totalLossAccumulated: 0,
                betLossInSplit: 0,
                completed: false,
                splitHistory: [],
                cutLossCount: 0
            };
            
            var recoveryBet = computeRecoveryBet(STATE.balance, triggerChance, STATE.recovery);
            if (recoveryBet > 0) {
                STATE.harvestBet = recoveryBet;
            } else {
                STATE.isRecoveryMode = false;
                STATE.harvestBet = computeHarvestBet(STATE.balance);
                STATE.recovery = null;
            }
        }
        
        STATE.harvestStartBalance = STATE.balance;
        STATE.harvestPeakBalance = STATE.balance;
        STATE.harvestWorstStreak = 0;
        STATE.harvestCurrentStreak = 0;
        STATE.harvestWorstDrawdown = 0;
        STATE.harvestBaseBet = STATE.harvestBet;
        
        var modeText = STATE.isRecoveryMode ? "RECOVERY" : "HARVEST";
        sendTelegramMessage(`🌾 ${modeText} #${STATE.harvestCount}\nChance: ${triggerChance}%\nBet: ${STATE.harvestBet.toFixed(4)}\nExcess Loss: ${excessLoss.toFixed(4)}`);
        updateAllUI();
    }

    function handleHarvestResult(win) {
        if (win) {
            var profit = STATE.balance - STATE.harvestStartBalance;
            addHarvestEntry(STATE.harvestChance, STATE.harvestBaseBet, 'WIN', profit,
                STATE.harvestWorstStreak, STATE.harvestWorstDrawdown, STATE.isRecoveryMode);
            STATE.isHarvesting = false;
            STATE.isRecoveryMode = false;
            STATE.recovery = null;
            STATE.isAfterRecovery = true;
            resetVirtualStreaks();
            sendTelegramMessage(`✅ HARVEST WIN #${STATE.harvestCount}\nProfit: ${profit.toFixed(4)}`);
        } else {
            STATE.harvestBet = STATE.harvestBet * STATE.harvestMultiplier;
            if (STATE.maxBetCap > 0) STATE.harvestBet = Math.min(STATE.harvestBet, STATE.maxBetCap);
            STATE.harvestBet = Math.min(STATE.harvestBet, STATE.balance * 0.005);
            
            var cutLimit = getCutLossLimit(STATE.harvestChance, STATE.maxCutLossMultiplier);
            var currentLS = STATE.virtualStreak[STATE.harvestChance] || 0;
            
            if (currentLS >= cutLimit) {
                var loss = STATE.balance - STATE.harvestStartBalance;
                addHarvestEntry(STATE.harvestChance, STATE.harvestBaseBet, 'CUT LOSS', loss,
                    STATE.harvestWorstStreak, STATE.harvestWorstDrawdown, STATE.isRecoveryMode);
                STATE.isHarvesting = false;
                STATE.isRecoveryMode = false;
                STATE.recovery = null;
                STATE.isAfterRecovery = false;
                resetToBreakeven();
                sendTelegramMessage(`✂️ HARVEST CUTLOSS #${STATE.harvestCount}\nLoss: ${loss.toFixed(4)}`);
            }
        }
    }

    function handleRecoveryResult(win, betAmount) {
        var recovery = STATE.recovery;
        if (!recovery || !recovery.active) return;
        
        var targetBalance = STATE.wagerSesiStartBal - STATE.wagerLossTolerance;
        
        if (win && STATE.balance >= targetBalance) {
            var profit = STATE.balance - STATE.harvestStartBalance;
            addHarvestEntry(STATE.harvestChance, STATE.harvestBaseBet, 'WIN', profit,
                STATE.harvestWorstStreak, STATE.harvestWorstDrawdown, true);
            STATE.isHarvesting = false;
            STATE.isRecoveryMode = false;
            STATE.recovery = null;
            STATE.isAfterRecovery = true;
            resetVirtualStreaks();
            resetWagerSesi();
            sendTelegramMessage(`✅ RECOVERY SUCCESS #${STATE.harvestCount}`);
            updateAllUI();
            return;
        }
        
        if (win) {
            recovery.betLossInSplit = 0;
            recovery.accumulatedLoss = 0;
            recovery.currentSplit++;
            recovery.lossStreak = 0;
            if (recovery.currentSplit >= STATE.recoveryMaxSplits) {
                recovery.currentSplit = 0;
            }
            
            var currentLoss = STATE.wagerSesiStartBal - STATE.balance;
            var excessLoss = Math.max(0, currentLoss - STATE.wagerLossTolerance);
            var remainingSplits = Math.max(1, STATE.recoveryMaxSplits - recovery.currentSplit);
            
            recovery.totalLoss = excessLoss;
            recovery.totalSplits = remainingSplits;
            recovery.targetBalance = targetBalance;
            recovery.startBalance = STATE.balance;
            
            var nextBet = computeRecoveryBet(STATE.balance, STATE.harvestChance, recovery);
            if (nextBet > 0) {
                STATE.harvestBet = nextBet;
            } else {
                resetToBreakeven();
                return;
            }
            sendTelegramMessage(`🔄 RECOVERY SPLIT ${recovery.currentSplit + 1}/${STATE.recoveryMaxSplits}`);
            
        } else {
            recovery.lossStreak++;
            recovery.betLossInSplit += betAmount;
            recovery.accumulatedLoss += betAmount;
            recovery.totalLossAccumulated += betAmount;
            
            var cutLimit = getCutLossLimit(STATE.harvestChance, STATE.recoveryCutlossMultiplier);
            
            if (recovery.lossStreak >= cutLimit) {
                var loss = STATE.balance - STATE.harvestStartBalance;
                addHarvestEntry(STATE.harvestChance, STATE.harvestBaseBet, 'CUT LOSS', loss,
                    STATE.harvestWorstStreak, STATE.harvestWorstDrawdown, true);
                
                sendTelegramMessage(`🛑 RECOVERY CUTLOSS!\nLoss Streak: ${recovery.lossStreak}\nLoss: ${loss.toFixed(4)}`);
                
                STATE.isHarvesting = false;
                STATE.isRecoveryMode = false;
                STATE.recovery = null;
                resetToBreakeven();
                updateAllUI();
                return;
            }
            
            var currentLoss2 = STATE.wagerSesiStartBal - STATE.balance;
            var excessLoss2 = Math.max(0, currentLoss2 - STATE.wagerLossTolerance);
            var remainingSplits2 = Math.max(1, STATE.recoveryMaxSplits - recovery.currentSplit);
            
            var nextBet2 = computeRecoveryBet(STATE.balance, STATE.harvestChance, {
                totalLoss: excessLoss2,
                totalSplits: remainingSplits2,
                currentSplit: 0,
                startBalance: STATE.balance,
                targetStartBalance: targetBalance,
                betLossInSplit: recovery.betLossInSplit
            });
            if (nextBet2 > 0) STATE.harvestBet = nextBet2;
        }
        updateAllUI();
    }

