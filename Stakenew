        STATE.isBoosterMode = false;
        STATE.boosterStartProfit = 0;
        STATE.boosterBetAmount = 0;
        STATE.boosterChance = STATE.normalChance;
        resetVirtualStreaks();
        resetWagerSesi();
        updateAllUI();
    }

