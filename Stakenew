    function updateTrailing() {
        if (!STATE.isTrailingActive) return;
        var currentBalance = STATE.balance;
        var escalated = false;
        if (currentBalance > STATE.balancePeak) STATE.balancePeak = currentBalance;
        if (STATE.trailingLevel === 1 && currentBalance > STATE.level1Peak) STATE.level1Peak = currentBalance;
        if (STATE.trailingLevel === 2 && currentBalance > STATE.level2Peak) STATE.level2Peak = currentBalance;
        if (STATE.trailingLevel === 1 && STATE.balancePeak > STATE.level1Peak * 1.01) {
            STATE.trailingLevel = 2;
            STATE.gapPct = STATE.gapLevel2;
            STATE.level2Peak = STATE.balancePeak;
            escalated = true;
        } else if (STATE.trailingLevel === 2 && STATE.balancePeak > STATE.level2Peak * 1.005) {
            STATE.trailingLevel = 3;
            STATE.gapPct = STATE.gapLevel3plus;
            escalated = true;
        }
        if (escalated) drawGapVisual();
        var gapThreshold = STATE.balancePeak * (1 - (STATE.gapPct / 100.0));
        if (currentBalance <= gapThreshold && !STATE.gapHitProcessed) {
            STATE.gapHits++;
            STATE.gapHitProcessed = true;
            if (STATE.trailingLevel === 1) {
                if (STATE.gap1Action === "continue") {
                    STATE.isTrailingActive = false;
                    STATE.trailingLevel = 0;
                    STATE.gapPct = STATE.gapLevel1;
                    STATE.balancePeak = STATE.balance;
