    function computeNormalBet(balance) {
        var bet = balance * (STATE.baseBetPercent / 100);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

    function computeHarvestBet(balance) {
        var riskMult = calculateDynamicRisk() / 0.15;
        var bet = balance * (STATE.harvestBetPercent / 100) * riskMult;
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        // ⭐ MAX HARVEST BET = 0.5% DARI BALANCE (1/4 dari v1 yang 2%)
        bet = Math.min(bet, balance * 0.005);
        return bet;
    }

    function computeRecoveryBet(currentBalance, harvestChance, recoveryData) {
        var totalLoss = recoveryData.totalLoss;
        var totalSplits = recoveryData.totalSplits;
        var currentSplit = recoveryData.currentSplit;
        var targetStartBalance = recoveryData.targetStartBalance;
        var betLossInSplit = recoveryData.betLossInSplit || 0;
        
        var totalLossWithBetLoss = totalLoss + betLossInSplit;
        var remainingSplits = Math.max(1, totalSplits - currentSplit);
        var lossPerSplit = totalLossWithBetLoss / remainingSplits;
        
        var targetBalance = currentBalance + lossPerSplit;
        if (targetBalance > targetStartBalance) targetBalance = targetStartBalance;
        
        var lossAmount = targetBalance - currentBalance;
        if (lossAmount <= 0) return 0;
        
        var profitMult = getProfitMultiplier(harvestChance);
        if (profitMult <= 0) return 0;
        
        var bet = lossAmount / profitMult;
        // ⭐ MAX RECOVERY BET = 0.25% DARI BALANCE (1/4 dari v1 yang 1%)
        var maxBet = currentBalance * 0.0025;
        bet = Math.min(bet, maxBet);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

    function getBurstChance() {
        return Math.round((Math.random() * (STATE.burstMaxChance - STATE.burstMinChance) + STATE.burstMinChance) * 10) / 10;
    }

    function getBurstBet(currentBalance) {
        var totalLoss = Math.max(0, STATE.startBalance - currentBalance);
        var profitMult = getProfitMultiplier(getBurstChance());
        var bet;
        if (profitMult > 0 && totalLoss > 0) {
            bet = (totalLoss / profitMult) * STATE.burstMultiplier;
        } else {
            bet = currentBalance * 0.0025;
        }
        bet = Math.min(bet, currentBalance * 0.025);
        bet = Math.max(bet, STATE.minBet);
        if (STATE.maxBetCap > 0) bet = Math.min(bet, STATE.maxBetCap);
        return bet;
    }

